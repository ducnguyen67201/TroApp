# Local PostgreSQL from compose.yaml. Use a different URL for hosted databases.
DATABASE_URL=postgresql://tro:local_demo_only@127.0.0.1:54329/tro
# Optional application mode: dev, stage, or prod. Debug logs appear only in dev.
APP_ENV=dev
# Backend-only Google OAuth settings. Replace through Doppler or local .env values.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/v1/auth/google/callback
