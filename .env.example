# Local PostgreSQL from compose.yaml. Use a different URL for hosted databases.
DATABASE_URL=postgresql://tro:local_demo_only@127.0.0.1:54329/tro
# Optional application mode: dev, stage, or prod. Debug logs appear only in dev.
APP_ENV=dev
# Generate a local secret with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Public URL of this API. Use HTTPS outside local development.
AUTH_BASE_URL=http://127.0.0.1:3000
# Backend-only OAuth web client credentials. Redirect URI:
# http://127.0.0.1:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Add a server-side key to enable signed-in model requests. Never put it in Electron.
# OPENAI_API_KEY=
