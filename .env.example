# Public desktop build settings only. Backend configuration and secrets come from Doppler.
MAIN_VITE_API_BASE_URL=http://127.0.0.1:3000
MAIN_VITE_APP_ENV=dev
# Optional public HTTPS release directory. Leave unset to disable app updates.
# MAIN_VITE_UPDATE_FEED_URL=https://downloads.example.com/tro/stable/
# Optional public PostHog project token and ingestion region; supply both or neither.
# Never use a personal API key here. Sharing defaults on; users can turn it off in Settings.
# MAIN_VITE_POSTHOG_PROJECT_TOKEN=phc_yourProjectToken
# MAIN_VITE_POSTHOG_HOST=https://us.i.posthog.com
