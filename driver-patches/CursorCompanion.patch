+/// These host controls mutate only the companion's fenced lifecycle or HUD.
+/// Drawing and ordinary executor work retain the serialized action lane. The
+/// normal dispatcher still validates arguments, authorization and ownership.
+pub(crate) fn is_companion_control(request: &Request) -> bool {
+    if request.method != "tools/call" {
+        return false;
+    }
+    let Ok(call) = request.tool_call() else {
+        return false;
+    };
+    match call.name.as_str() {
+        "get_cursor_companion_capabilities"
+        | "begin_cursor_guidance_task"
+        | "end_cursor_guidance_task"
+        | "set_cursor_companion_mode"
+        | "cancel_cursor_sequence"
+        | "get_cursor_companion_state"
+        | "read_companion_hud_message" => true,
+        "send_companion_hud_command" => matches!(
+            call.args.get("kind").and_then(Value::as_str),
+            Some("renew_lease" | "update_appearance" | "clear_message")
+        ),
+        _ => false,
+    }
+}
