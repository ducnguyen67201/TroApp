+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct RefreshedCursorGuidanceCapture {
+    pub matched: bool,
+    pub capture_id: Option<String>,
+    pub reason: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub diagnostics: Option<CaptureComparison>,
+}
+impl ToolOutput for RefreshedCursorGuidanceCapture {
+    fn validate(&self) -> Result<(), String> {
+        let valid = if self.matched {
+            self.reason == "target_unchanged"
+                && self.capture_id.as_ref().is_some_and(|id| !id.is_empty())
+        } else {
+            self.capture_id.is_none()
+                && matches!(
+                    self.reason.as_str(),
+                    "target_changed" | "geometry_changed" | "capture_unavailable"
+                )
+        };
+        let diagnostics_valid = self.diagnostics.as_ref().is_none_or(|report| {
+            report.matched == self.matched
+                && report.capture_width_px > 0
+                && report.capture_height_px > 0
+                && report.regions.len() <= 8
+                && report.regions.iter().all(|region| {
+                    region.step_index < 8
+                        && matches!(
+                            region.step_kind.as_str(),
+                            "circle" | "click" | "arrow" | "move" | "drag" | "selection"
+                        )
+                        && region.changed_pixels <= region.compared_pixels
+                        && region.changed_fraction.is_finite()
+                        && (0.0..=1.0).contains(&region.changed_fraction)
+                })
+        });
+        if valid && diagnostics_valid {
+            Ok(())
+        } else {
+            Err("Invalid guidance capture comparison result.".into())
+        }
+    }
+}
