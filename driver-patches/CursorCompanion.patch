+/// Wait for CALayer installation of the message before beginning a pointer cue.
+/// This bounds a stalled compositor and does not claim physical scan-out timing.
+pub async fn present_companion_message(
+    session: &str,
+    group: &str,
+    locale: cua_driver_contract::CompanionHudLocale,
+    message: cua_driver_contract::CompanionTeachingMessage,
+) -> Result<cua_driver_contract::CompanionRenderToken, &'static str> {
+    use super::companion_hud::{RenderFailure, RenderOutcome};
+    let frame = super::companion_hud::state()
+        .lock()
+        .unwrap()
+        .present_message(session, group, locale, message)?;
+    send_command_default(OverlayCommand::WakeCompanionHud);
+    let result =
+        tokio::time::timeout_at(tokio::time::Instant::from_std(frame.deadline), frame.wait()).await;
+    let outcome = match result {
+        Ok(outcome) => outcome,
+        Err(_) => {
+            super::companion_hud::state()
+                .lock()
+                .unwrap()
+                .fail_token(&frame.token, RenderFailure::DeadlineExceeded);
+            frame.outcome()
+        }
+    };
+    match outcome {
+        RenderOutcome::Presented => Ok(frame.token),
+        RenderOutcome::Superseded => Err("message_superseded"),
+        RenderOutcome::Cancelled(_) => Err("message_cancelled"),
+        RenderOutcome::Failed(RenderFailure::ImageConversion) => Err("image_conversion_failed"),
+        RenderOutcome::Failed(RenderFailure::FrameInstallation) => Err("frame_installation_failed"),
+        RenderOutcome::Failed(RenderFailure::DeadlineExceeded) | RenderOutcome::Pending => {
+            send_command_default(OverlayCommand::WakeCompanionHud);
+            Err("render_timeout")
+        }
+    }
