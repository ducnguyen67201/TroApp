+};
+
+pub const COMPANION_BLUE: [u8; 4] = [77, 163, 255, 255];
+// Keep the silhouette compact at about 9 × 10 logical display points.
+// Apply the same factor to its outline, halo and click pulse without moving the tip.
+const COMPANION_SIZE_SCALE: f32 = 0.3125;
+const GLOW_RADIUS: f32 = 58.0;
+
+pub fn paint_companion_pointer(
+    image: &mut Pixmap,
+    tip: (f32, f32),
+    backing_scale: f32,
+    alpha: f32,
+    pressed: bool,
+    click_progress: Option<f64>,
+) {
+    let scale = backing_scale.max(1.0) * COMPANION_SIZE_SCALE;
+    let alpha = alpha.clamp(0.0, 1.0);
+    let transform = Transform::from_scale(scale, scale).post_translate(tip.0, tip.1);
+    let center = Point::from_xy(11.0, 14.0);
+    let [red, green, blue, _] = COMPANION_BLUE;
+    let color = |opacity: f32| Color::from_rgba8(red, green, blue, (opacity * alpha) as u8);
+    if let (Some(glow), Some(circle)) = (
+        RadialGradient::new(
+            center,
+            center,
+            GLOW_RADIUS,
+            vec![
+                GradientStop::new(0.0, color(120.0)),
+                GradientStop::new(0.35, color(96.0)),
+                GradientStop::new(0.7, color(24.0)),
+                GradientStop::new(1.0, color(0.0)),
+            ],
+            SpreadMode::Pad,
+            Transform::identity(),
+        ),
+        PathBuilder::from_circle(center.x, center.y, GLOW_RADIUS),
+    ) {
+        image.fill_path(
+            &circle,
+            &Paint {
+                shader: glow,
+                anti_alias: true,
+                ..Default::default()
+            },
+            FillRule::Winding,
+            transform,
+            None,
+        );
+    }
+
+    if let Some(progress) = click_progress {
+        let progress = progress.clamp(0.0, 1.0) as f32;
+        if let Some(ring) = PathBuilder::from_circle(0.0, 0.0, 10.0 + progress * 24.0) {
+            let mut paint = Paint::default();
+            paint.set_color(color(220.0 * (1.0 - progress)));
+            paint.anti_alias = true;
+            image.stroke_path(
+                &ring,
+                &paint,
+                &Stroke {
+                    width: 2.0,
+                    ..Default::default()
+                },
+                transform,
+                None,
+            );
+        }
+    }
+
+    // Rounded corners keep the source silhouette soft at the smaller display size. Its
+    // fixed orientation helps distinguish the teacher from the OS pointer.
+    let mut builder = PathBuilder::new();
+    builder.move_to(0.0, 2.0);
+    builder.quad_to(-0.8, -0.8, 2.0, 0.5);
+    builder.line_to(26.0, 14.0);
+    builder.quad_to(29.0, 16.0, 26.0, 17.5);
+    builder.line_to(16.0, 21.0);
+    builder.line_to(11.0, 30.0);
+    builder.quad_to(9.0, 33.0, 7.8, 29.5);
+    builder.close();
+    if let Some(pointer) = builder.finish() {
+        let press_scale = if pressed { 0.94 } else { 1.0 };
+        let transform = Transform::from_scale(scale * press_scale, scale * press_scale)
+            .post_translate(tip.0, tip.1);
+        let mut fill = Paint::default();
+        fill.set_color_rgba8(255, 255, 255, (255.0 * alpha) as u8);
+        fill.anti_alias = true;
+        image.fill_path(&pointer, &fill, FillRule::Winding, transform, None);
+        let mut outline = Paint::default();
+        outline.set_color(color(255.0));
+        outline.anti_alias = true;
+        image.stroke_path(
+            &pointer,
+            &outline,
+            &Stroke {
+                width: 2.0,
+                ..Default::default()
+            },
+            transform,
+            None,
+        );
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn companion_pointer_has_white_body_blue_glow_and_retina_scaling() {
+        for scale in [1.0, 2.0] {
+            let mut image = Pixmap::new((160.0 * scale) as u32, (160.0 * scale) as u32).unwrap();
+            paint_companion_pointer(
+                &mut image,
+                (70.0 * scale, 65.0 * scale),
+                scale,
+                1.0,
+                false,
+                None,
+            );
+            let body = image
+                .pixel((73.0 * scale) as u32, (70.0 * scale) as u32)
+                .unwrap();
+            assert!(body.red() > 245 && body.green() > 245 && body.blue() > 245);
+            let glow = image
+                .pixel((64.0 * scale) as u32, (70.0 * scale) as u32)
+                .unwrap();
+            assert!(glow.blue() > glow.green() && glow.green() > glow.red());
+            assert!(glow.alpha() > 0 && glow.alpha() < 128);
+            assert_eq!(image.pixel(0, 0).unwrap().alpha(), 0);
+        }
+    }
+
+    #[test]
+    fn companion_pointer_respects_visibility_alpha() {
+        let mut image = Pixmap::new(160, 160).unwrap();
+        paint_companion_pointer(&mut image, (70.0, 65.0), 1.0, 0.0, true, Some(0.5));
+        assert!(image.data().iter().all(|byte| *byte == 0));
+    }
+}
diff --git a/libs/cua-driver/rust/crates/cursor-overlay/src/companion_hud.rs b/libs/cua-driver/rust/crates/cursor-overlay/src/companion_hud.rs
new file mode 100644
index 0000000..48be03c
--- /dev/null
+++ b/libs/cua-driver/rust/crates/cursor-overlay/src/companion_hud.rs
@@ -0,0 +1,423 @@
+//! Compact host HUD in logical points. Never posts input or performs submission.
+use cua_driver_contract::{CompanionHudLocale as Locale, CompanionHudPhase as Phase};
+use fontdue::layout::{CoordinateSystem, Layout, LayoutSettings, TextStyle};
+use std::sync::OnceLock;
+use tiny_skia::{Color, FillRule, Paint, PathBuilder, Pixmap, PixmapPaint, Stroke, Transform};
+
+pub const HUD_WIDTH: f32 = 88.0;
+pub const HUD_HEIGHT: f32 = 22.0;
+#[derive(Default)]
+pub struct CompanionHudPainter {
+    pub phase: Phase,
+    pub locale: Locale,
+    pub level: f32,
+    previous: Phase,
+    transition: f32,
+    alpha: f32,
+    smoothed_level: f32,
+    time: f32,
+    above: bool,
+}
+impl CompanionHudPainter {
+    pub fn update(&mut self, phase: Phase, locale: Locale, level: f32) {
+        if phase != self.phase {
+            self.previous = self.phase;
+            self.phase = phase;
+            self.transition = 0.0;
+        }
+        self.locale = locale;
+        self.level = if phase == Phase::Listening {
+            level.clamp(0.0, 1.0)
+        } else {
+            0.0
+        };
+    }
+    pub fn is_visible(&self) -> bool {
+        self.phase != Phase::Idle || self.alpha > 0.002
+    }
+    pub fn tick(&mut self, dt: f32, reduced_motion: bool) {
+        self.time += dt;
+        let duration = if reduced_motion { 0.04 } else { 0.18 };
+        self.transition = (self.transition + dt / duration).min(1.0);
+        let target = if self.phase == Phase::Idle { 0.0 } else { 1.0 };
+        self.alpha += (target - self.alpha).clamp(-dt / duration, dt / duration);
+        let smoothing = if self.level > self.smoothed_level {
+            0.055
+        } else {
+            0.18
+        };
+        self.smoothed_level += (self.level - self.smoothed_level) * (1.0 - (-dt / smoothing).exp());
+    }
+    pub fn paint(
+        &mut self,
+        image: &mut Pixmap,
+        cursor: (f32, f32),
+        scale: f32,
+        reduced_motion: bool,
+    ) {
+        if self.alpha <= 0.002 {
+            return;
+        }
+        let width = if self.locale == Locale::Vietnamese {
+            98.0
+        } else {
+            HUD_WIDTH
+        };
+        let x = (cursor.0 + 4.0 - width / 2.0)
+            .clamp(8.0, (image.width() as f32 / scale - width - 8.0).max(8.0));
+        let bottom = image.height() as f32 / scale;
+        if self.above {
+            if cursor.1 + 16.0 + HUD_HEIGHT < bottom - 16.0 {
+                self.above = false;
+            }
+        } else if cursor.1 + 16.0 + HUD_HEIGHT > bottom - 8.0 {
+            self.above = true;
+        }
+        let y = if self.above {
+            cursor.1 - HUD_HEIGHT - 6.0
+        } else {
+            cursor.1 + 16.0
+        };
+        let y = y.clamp(8.0, (bottom - HUD_HEIGHT - 8.0).max(8.0));
+        let mut path = PathBuilder::new();
+        let r = HUD_HEIGHT / 2.0;
+        path.move_to(x + r, y);
+        path.line_to(x + width - r, y);
+        path.cubic_to(
+            x + width + r * 0.1,
+            y,
+            x + width + r * 0.1,
+            y + HUD_HEIGHT,
+            x + width - r,
+            y + HUD_HEIGHT,
+        );
+        path.line_to(x + r, y + HUD_HEIGHT);
+        path.cubic_to(x - r * 0.1, y + HUD_HEIGHT, x - r * 0.1, y, x + r, y);
+        path.close();
+        let Some(path) = path.finish() else {
+            return;
+        };
+        let transform = Transform::from_scale(scale, scale);
+        image.fill_path(
+            &path,
+            &paint([8, 13, 19], self.alpha * 0.95),
+            FillRule::Winding,
+            transform,
+            None,
+        );
+        image.stroke_path(
+            &path,
+            &paint([120, 188, 243], self.alpha * 0.7),
+            &Stroke {
+                width: 0.8,
+                ..Default::default()
+            },
+            transform,
+            None,
+        );
+        // Crossfade at the same anchor; fast lifecycle updates never delay work.
+        if self.phase != Phase::Idle && self.transition < 1.0 && self.previous != Phase::Idle {
+            self.paint_content(
+                image,
+                self.previous,
+                x,
+                y,
+                width,
+                scale,
+                self.alpha * (1.0 - self.transition),
+                reduced_motion,
+            );
+        }
+        if self.phase != Phase::Idle {
+            self.paint_content(
+                image,
+                self.phase,
+                x,
+                y,
+                width,
+                scale,
+                self.alpha * self.transition,
+                reduced_motion,
+            );
+        } else {
+            self.paint_content(
+                image,
+                self.previous,
+                x,
+                y,
+                width,
+                scale,
+                self.alpha,
+                reduced_motion,
+            );
+        }
+    }
+    fn paint_content(
+        &self,
+        image: &mut Pixmap,
+        phase: Phase,
+        x: f32,
+        y: f32,
+        width: f32,
+        scale: f32,
+        alpha: f32,
+        reduced: bool,
+    ) {
+        let transform = Transform::from_scale(scale, scale);
+        let blue = paint([138, 200, 250], alpha);
+        let icon_x = x + 7.0;
+        let mid = y + 11.0;
+        if phase == Phase::Thinking || phase == Phase::Transcribing || phase == Phase::Preparing {
+            for index in 0..3 {
+                let opacity = if reduced {
+                    1.0
+                } else {
+                    0.45 + 0.55 * ((self.time * 4.5 - index as f32 * 0.8).sin() + 1.0) / 2.0
+                };
+                if let Some(rect) =
+                    tiny_skia::Rect::from_xywh(icon_x + index as f32 * 3.0, mid - 1.0, 2.0, 2.0)
+                {
+                    image.fill_rect(
+                        rect,
+                        &paint([138, 200, 250], alpha * opacity),
+                        transform,
+                        None,
+                    );
+                }
+            }
+        } else {
+            let mut icon = PathBuilder::new();
+            if phase == Phase::Done {
+                icon.move_to(icon_x, mid);
+                icon.line_to(icon_x + 3.0, mid + 3.0);
+                icon.line_to(icon_x + 8.0, mid - 4.0);
+            } else {
+                icon.move_to(icon_x + 2.0, mid - 4.0);
+                icon.cubic_to(
+                    icon_x + 2.0,
+                    mid - 7.0,
+                    icon_x + 6.0,
+                    mid - 7.0,
+                    icon_x + 6.0,
+                    mid - 4.0,
+                );
+                icon.line_to(icon_x + 6.0, mid);
+                icon.cubic_to(
+                    icon_x + 6.0,
+                    mid + 3.0,
+                    icon_x + 2.0,
+                    mid + 3.0,
+                    icon_x + 2.0,
+                    mid,
+                );
+                icon.close();
+                icon.move_to(icon_x, mid);
+                icon.cubic_to(
+                    icon_x,
+                    mid + 6.0,
+                    icon_x + 8.0,
+                    mid + 6.0,
+                    icon_x + 8.0,
+                    mid,
+                );
+                icon.move_to(icon_x + 4.0, mid + 4.0);
+                icon.line_to(icon_x + 4.0, mid + 7.0);
+            }
+            if let Some(path) = icon.finish() {
+                image.stroke_path(
+                    &path,
+                    &blue,
+                    &Stroke {
+                        width: 1.0,
+                        ..Default::default()
+                    },
+                    transform,
+                    None,
+                );
+            }
+        }
+        if phase == Phase::Listening {
+            for index in 0..14 {
+                let weight = if reduced {
+                    1.0
+                } else {
+                    0.35 + 0.65 * ((self.time * 7.0 + index as f32 * 0.82).sin() + 1.0) / 2.0
+                };
+                let h = 2.0 + self.smoothed_level * 8.0 * weight;
+                if let Some(rect) =
+                    tiny_skia::Rect::from_xywh(x + 25.0 + index as f32 * 3.0, mid - h / 2.0, 1.8, h)
+                {
+                    image.fill_rect(rect, &blue, transform, None);
+                }
+            }
+        } else {
+            paint_text(
+                image,
+                label(phase, self.locale),
+                (x + 20.0, y),
+                width - 24.0,
+                scale,
+                alpha,
+            );
+        }
+    }
+}
+fn paint(rgb: [u8; 3], alpha: f32) -> Paint<'static> {
+    let mut p = Paint::default();
+    p.set_color(Color::from_rgba8(
+        rgb[0],
+        rgb[1],
+        rgb[2],
+        (255.0 * alpha.clamp(0.0, 1.0)) as u8,
+    ));
+    p
+}
+fn label(phase: Phase, locale: Locale) -> &'static str {
+    if locale == Locale::Vietnamese {
+        return match phase {
+            Phase::Idle => "",
+            Phase::Preparing => "Chuẩn bị…",
+            Phase::Listening => "Đang nghe",
+            Phase::Transcribing => "Chuyển lời…",
+            Phase::Sending => "Đang gửi…",
+            Phase::Thinking => "Suy nghĩ…",
+            Phase::Showing => "Hướng dẫn…",
+            Phase::Working => "Đang làm…",
+            Phase::Done => "Xong",
+            Phase::Canceled => "Đã hủy",
+            Phase::Error => "Có lỗi",
+            Phase::DailyLimit => "Hết lượt hôm nay",
+            Phase::NeedsInput => "Cần chỉ dẫn",
+        };
+    }
+    match phase {
+        Phase::Idle => "",
+        Phase::Preparing => "Preparing…",
+        Phase::Listening => "Listening",
+        Phase::Transcribing => "Transcribing…",
+        Phase::Sending => "Sending…",
+        Phase::Thinking => "Thinking…",
+        Phase::Showing => "Showing…",
+        Phase::Working => "Working…",
+        Phase::Done => "Done",
+        Phase::Canceled => "Canceled",
+        Phase::Error => "Try again",
+        Phase::DailyLimit => "Daily limit",
+        Phase::NeedsInput => "Needs input",
+    }
+}
+fn paint_text(
+    image: &mut Pixmap,
+    text: &str,
+    origin: (f32, f32),
+    width: f32,
+    scale: f32,
+    alpha: f32,
+) {
+    static FONT: OnceLock<Option<fontdue::Font>> = OnceLock::new();
+    let Some(font) = FONT.get_or_init(|| {
+        fontdue::Font::from_bytes(
+            include_bytes!("../assets/Inter.ttf") as &[u8],
+            fontdue::FontSettings::default(),
+        )
+        .ok()
+    }) else {
+        return;
+    };
+    let mut layout = Layout::new(CoordinateSystem::PositiveYDown);
+    layout.reset(&LayoutSettings::default());
+    layout.append(&[font], &TextStyle::new(text, 9.5 * scale, 0));
+    let text_width = layout
+        .glyphs()
+        .iter()
+        .map(|glyph| glyph.x + glyph.width as f32)
+        .fold(0.0, f32::max);
+    let factor = (width * scale / text_width.max(1.0)).min(1.0);
+    if factor < 1.0 {
+        layout.reset(&LayoutSettings::default());
+        layout.append(&[font], &TextStyle::new(text, 9.5 * scale * factor, 0));
+    }
+    let text_width = layout
+        .glyphs()
+        .iter()
+        .map(|glyph| glyph.x + glyph.width as f32)
+        .fold(0.0, f32::max);
+    let min_y = layout
+        .glyphs()
+        .iter()
+        .map(|g| g.y)
+        .fold(f32::INFINITY, f32::min);
+    let max_y = layout
+        .glyphs()
+        .iter()
+        .map(|g| g.y + g.height as f32)
+        .fold(0.0, f32::max);
+    for glyph in layout.glyphs() {
+        let (metrics, bitmap) = font.rasterize_config(glyph.key);
+        let Some(mut pm) = Pixmap::new(metrics.width as u32, metrics.height as u32) else {
+            continue;
+        };
+        for (pixel, coverage) in pm.data_mut().chunks_exact_mut(4).zip(bitmap) {
+            let a = coverage as f32 * alpha;
+            pixel.copy_from_slice(&[
+                (138.0 / 255.0 * a) as u8,
+                (200.0 / 255.0 * a) as u8,
+                (250.0 / 255.0 * a) as u8,
+                a as u8,
+            ]);
+        }
+        image.draw_pixmap(
+            (origin.0 * scale + (width * scale - text_width) / 2.0 + glyph.x).round() as i32,
+            (origin.1 * scale + (HUD_HEIGHT * scale - (max_y - min_y)) / 2.0 - min_y + glyph.y)
+                .round() as i32,
+            pm.as_ref(),
+            &PixmapPaint::default(),
+            Transform::identity(),
+            None,
+        );
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn companion_hud_renders_clamped_retina_and_fades() {
+        for scale in [1.0, 2.0] {
+            let mut pm = Pixmap::new((200.0 * scale) as u32, (100.0 * scale) as u32).unwrap();
+            let mut painter = CompanionHudPainter::default();
+            painter.update(Phase::Thinking, Locale::English, 0.0);
+            painter.tick(0.2, false);
+            painter.paint(&mut pm, (195.0, 95.0), scale, false);
+            assert!(painter.above);
+            assert!(pm.data().chunks_exact(4).any(|pixel| pixel[3] > 0));
+            painter.update(Phase::Idle, Locale::English, 0.0);
+            painter.tick(0.3, false);
+            assert!(!painter.is_visible());
+        }
+    }
+    #[test]
+    fn companion_hud_silence_stays_flat_and_levels_decay() {
+        let mut painter = CompanionHudPainter::default();
+        painter.update(Phase::Listening, Locale::English, 0.0);
+        painter.tick(0.2, false);
+        assert_eq!(painter.smoothed_level, 0.0);
+        painter.update(Phase::Listening, Locale::English, 1.0);
+        painter.tick(0.1, false);
+        assert!(painter.smoothed_level > 0.5);
+        painter.update(Phase::Transcribing, Locale::English, 0.0);
+        painter.tick(0.3, false);
+        assert!(painter.smoothed_level < 0.2);
+    }
+}
+
+/// Retain the same companion at handoff while no bound Tro cursor is visible.
+pub fn paint_fallback_pointer(image: &mut Pixmap, cursor: (f32, f32), scale: f32) {
+    crate::companion_appearance::paint_companion_pointer(
+        image,
+        (cursor.0 * scale, cursor.1 * scale),
+        scale,
+        1.0,
+        false,
+        None,
+    );
+}
diff --git a/libs/cua-driver/rust/crates/cursor-overlay/src/guidance.rs b/libs/cua-driver/rust/crates/cursor-overlay/src/guidance.rs
new file mode 100644
index 0000000..1442925
--- /dev/null
+++ b/libs/cua-driver/rust/crates/cursor-overlay/src/guidance.rs
@@ -0,0 +1,253 @@
+//! Bounded, pure guidance planning and compositor evidence. Never posts input.
+use crate::companion::{plan_mark, plan_path};
+use cua_driver_contract::CompanionStep;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+pub const MAX_FRAME_GAP: Duration = Duration::from_millis(150);
+pub const FADE_MS: u64 = 350;
+pub const RETURN_MS: u64 = 700;
+
+#[derive(Debug, Default)]
+pub struct FrameFence {
+    pub generation: u64,
+    pub rendered_revision: u64,
+}
+
+/// One indivisible pointer/cue scene. The platform stamps only after installing
+/// the CGImage in CALayer on the main queue. Cancel invalidates queued images.
+#[derive(Debug, Clone)]
+pub struct GuidanceFrame {
+    pub generation: u64,
+    pub revision: u64,
+    pub fence: Arc<Mutex<FrameFence>>,
+    pub receipt: Arc<Mutex<Option<Instant>>>,
+    pub pointer: (f64, f64),
+    pub cue: Vec<(f64, f64)>,
+    pub cue_alpha: f32,
+    pub teaching: bool,
+    pub visible: bool,
+    pub pressed: bool,
+}
+impl GuidanceFrame {
+    pub fn is_current(&self) -> bool {
+        self.fence.lock().unwrap().generation == self.generation
+    }
+}
+
+pub struct GuidanceStep {
+    pub path: Vec<(f64, f64)>,
+    pub mark: Vec<(f64, f64)>,
+    pub approach_ms: u64,
+    pub trace_ms: u64,
+    pub hold_ms: u64,
+    pub pressed: bool,
+}
+pub struct GuidancePlan {
+    pub steps: Vec<GuidanceStep>,
+    pub duration_ms: u64,
+}
+
+pub fn approach_duration(from: (f64, f64), to: (f64, f64)) -> u64 {
+    let distance = (to.0 - from.0).hypot(to.1 - from.1);
+    if distance < 0.01 {
+        0
+    } else {
+        ((distance / 900.0 * 1000.0) as u64).clamp(250, 1200)
+    }
+}
+
+pub fn compile_guidance(
+    steps: &[CompanionStep],
+    start: (f64, f64),
+    width: f64,
+    height: f64,
+) -> Result<GuidancePlan, &'static str> {
+    let mut previous = start;
+    let mut duration_ms = RETURN_MS;
+    let mut compiled = Vec::with_capacity(steps.len());
+    for step in steps {
+        let path = plan_path(step, width, height);
+        let mark = match step {
+            // A click preview is a small halo; the real pointer never clicks.
+            CompanionStep::Click { at, .. } => (0..=32)
+                .map(|index| {
+                    let angle = index as f64 / 32.0 * std::f64::consts::TAU;
+                    (
+                        at.x * width + 12.0 * angle.cos(),
+                        at.y * height + 12.0 * angle.sin(),
+                    )
+                })
+                .collect(),
+            _ => plan_mark(step, &path),
+        };
+        if path.iter().chain(&mark).any(|&(x, y)| {
+            !x.is_finite() || !y.is_finite() || x < 0.0 || y < 0.0 || x >= width || y >= height
+        }) {
+            return Err("invalid_request");
+        }
+        let first = *path.first().ok_or("invalid_request")?;
+        let last = *path.last().ok_or("invalid_request")?;
+        let approach_ms = approach_duration(previous, first);
+        let trace_ms = u64::from(step.duration_ms());
+        let hold_ms = u64::from(step.hold_ms());
+        duration_ms += approach_ms + trace_ms + hold_ms + FADE_MS;
+        compiled.push(GuidanceStep {
+            path,
+            mark,
+            approach_ms,
+            trace_ms,
+            hold_ms,
+            pressed: matches!(step, CompanionStep::Drag { .. }),
+        });
+        previous = last;
+    }
+    if compiled.is_empty() || compiled.len() > 8 || duration_ms > 15000 {
+        return Err("invalid_request");
+    }
+    Ok(GuidancePlan {
+        steps: compiled,
+        duration_ms,
+    })
+}
+
+/// Arc-length sampling keeps rectangles and unequal segments at uniform speed.
+pub fn reveal_path(path: &[(f64, f64)], progress: f64) -> Vec<(f64, f64)> {
+    if path.is_empty() {
+        return vec![];
+    }
+    if progress >= 1.0 {
+        return path.to_vec();
+    }
+    let lengths: Vec<f64> = path
+        .windows(2)
+        .map(|pair| (pair[1].0 - pair[0].0).hypot(pair[1].1 - pair[0].1))
+        .collect();
+    let mut remaining = progress.clamp(0.0, 1.0) * lengths.iter().sum::<f64>();
+    let mut revealed = vec![path[0]];
+    for (pair, distance) in path.windows(2).zip(lengths) {
+        if remaining >= distance {
+            revealed.push(pair[1]);
+            remaining -= distance;
+        } else {
+            let amount = if distance > 0.0 {
+                remaining / distance
+            } else {
+                0.0
+            };
+            revealed.push((
+                pair[0].0 + (pair[1].0 - pair[0].0) * amount,
+                pair[0].1 + (pair[1].1 - pair[0].1) * amount,
+            ));
+            break;
+        }
+    }
+    revealed
+}
+pub fn point_on_path(path: &[(f64, f64)], progress: f64) -> (f64, f64) {
+    reveal_path(path, progress)
+        .last()
+        .copied()
+        .unwrap_or((0.0, 0.0))
+}
+
+/// Per-step evidence remains independent of terminal clear/return receipts.
+#[derive(Default)]
+pub struct StepEvidence {
+    intermediate: bool,
+    complete: Option<Instant>,
+    last: Option<Instant>,
+}
+impl StepEvidence {
+    pub fn record_trace(
+        &mut self,
+        progress: f64,
+        rendered_at: Instant,
+    ) -> Result<(), &'static str> {
+        if self.last.is_some_and(|last| {
+            rendered_at < last || rendered_at.saturating_duration_since(last) > MAX_FRAME_GAP
+        }) {
+            return Err("render_timeout");
+        }
+        self.last = Some(rendered_at);
+        self.intermediate |= progress > 0.0 && progress < 1.0;
+        if progress >= 1.0 {
+            self.complete = Some(rendered_at);
+        }
+        Ok(())
+    }
+    pub fn finish_hold(
+        &self,
+        rendered_at: Instant,
+        hold_ms: u64,
+        reduced_motion: bool,
+    ) -> Result<(), &'static str> {
+        match self.complete {
+            Some(complete)
+                if (self.intermediate || reduced_motion)
+                    && rendered_at.saturating_duration_since(complete)
+                        >= Duration::from_millis(hold_ms) =>
+            {
+                Ok(())
+            }
+            _ => Err("render_timeout"),
+        }
+    }
+    pub fn hold_started(&self) -> Option<Instant> {
+        self.complete
+    }
+}
