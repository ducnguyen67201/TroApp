+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct CueComparison {
+    pub region_index: usize,
+    pub region_kind: String,
+    pub bounds_px: [u32; 4],
+    pub compared_pixels: u64,
+    pub changed_pixels: u64,
+    pub changed_fraction: f64,
+    pub max_channel_delta: u8,
+    pub first_changed_pixel: Option<[u32; 2]>,
+}
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct CaptureComparison {
+    pub matched: bool,
+    pub capture_width_px: u32,
+    pub capture_height_px: u32,
+    pub regions: Vec<CueComparison>,
+}
+impl CaptureComparison {
+    fn validate(&self) -> bool {
+        self.capture_width_px > 0
+            && self.capture_height_px > 0
+            && self.regions.len() <= 5
+            && self.regions.iter().enumerate().all(|(index, region)| {
+                region.region_index == index
+                    && matches!(region.region_kind.as_str(), "target" | "stroke")
+                    && region.changed_pixels <= region.compared_pixels
+                    && region.changed_fraction.is_finite()
+                    && (0.0..=1.0).contains(&region.changed_fraction)
+            })
+    }
+}
+/// Monotonic local-stage timings. No per-frame event stream or content payload.
+#[derive(Debug, Clone, Default, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct TeachingGuidanceTimings {
+    pub compile_ms: u64,
+    pub refresh_ms: u64,
+    pub comparison_ms: u64,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub first_frame_ms: Option<u64>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub presentation_ms: Option<u64>,
+}
+impl TeachingGuidanceTimings {
+    fn validate(&self) -> bool {
+        [self.compile_ms, self.refresh_ms, self.comparison_ms]
+            .iter()
+            .all(|&value| value <= 120000)
+            && self.first_frame_ms.is_none_or(|value| value <= 120000)
+            && self.presentation_ms.is_none_or(|value| value <= 120000)
+    }
+}
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(untagged)]
+pub enum TeachingGuidanceOutput {
+    Presented {
+        status: String,
+        following: bool,
+        active: bool,
+        receipt: CursorGuidanceReceipt,
+        coordinate_trace: Option<GuidanceCoordinateTrace>,
+        comparison_diagnostics: Option<CaptureComparison>,
+        timings_ms: TeachingGuidanceTimings,
+    },
+    Refused {
+        status: String,
+        code: String,
+        reason: String,
+        comparison_diagnostics: Option<CaptureComparison>,
+        timings_ms: TeachingGuidanceTimings,
+    },
+}
+impl ToolOutput for TeachingGuidanceOutput {
+    fn validate(&self) -> Result<(), String> {
+        let valid = match self {
+            Self::Presented {
+                status,
+                active,
+                receipt,
+                coordinate_trace,
+                comparison_diagnostics,
+                timings_ms,
+                ..
+            } => {
+                let strokes = &receipt.strokes_presented;
+                status == "presented"
+                    && !active
+                    && receipt.presentation_version == 3
+                    && timings_ms.validate()
+                    && comparison_diagnostics
+                        .as_ref()
+                        .is_none_or(CaptureComparison::validate)
+                    && receipt.message_presented == Some(true)
+                    && receipt
+                        .presentation_id
+                        .as_ref()
+                        .is_some_and(|id| id.len() == 36)
+                    && receipt.lesson_id.is_some()
+                    && receipt.step_id.is_some()
+                    && receipt.interrupted.is_some()
+                    && strokes.len() <= SCRIBBLE_MAX_STROKES
+                    && strokes.iter().enumerate().all(|(index, stroke)| {
+                        stroke.stroke_index < SCRIBBLE_MAX_STROKES
+                            && !strokes[..index]
+                                .iter()
+                                .any(|prior| prior.stroke_index == stroke.stroke_index)
+                            && stroke.trace_progress.is_finite()
+                            && (0.0..=1.0).contains(&stroke.trace_progress)
+                            && stroke.trace_progress > 0.0
+                            && (receipt.interrupted == Some(true)
+                                || (stroke.trace_progress == 1.0
+                                    && stroke.hold_ms_observed >= SCRIBBLE_MIN_HOLD_MS))
+                    })
+                    && if receipt.text_only == Some(true) {
+                        strokes.is_empty()
+                            && receipt.drawing_presented == Some(false)
+                            && receipt.interrupted == Some(false)
+                    } else {
+                        receipt.text_only == Some(false)
+                            && receipt.drawing_presented == Some(true)
+                            && !strokes.is_empty()
+                            && coordinate_trace.as_ref().is_some_and(|trace| {
+                                trace.planned_strokes.len() <= SCRIBBLE_MAX_STROKES
+                                    && trace.painted_strokes.len() <= SCRIBBLE_MAX_STROKES
+                                    && (receipt.interrupted == Some(true)
+                                        || trace.planned_strokes.len() == strokes.len())
+                                    && strokes.iter().all(|stroke| {
+                                        stroke.stroke_index < trace.planned_strokes.len()
+                                    })
+                            })
+                    }
+            }
+            Self::Refused {
+                status,
+                code,
+                reason,
+                comparison_diagnostics,
+                timings_ms,
+            } => {
+                status == "refused"
+                    && code == "fresh_observation_required"
+                    && timings_ms.validate()
+                    && matches!(
+                        reason.as_str(),
+                        "target_changed" | "geometry_changed" | "capture_unavailable"
+                    )
+                    && comparison_diagnostics
+                        .as_ref()
+                        .is_none_or(CaptureComparison::validate)
+            }
+        };
+        if valid {
+            Ok(())
+        } else {
+            Err("Invalid version 3 teaching presentation evidence.".into())
+        }
+    }
+}
+#[cfg(test)]
