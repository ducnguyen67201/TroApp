+//! One bounded passive teaching message. Timing is independent of HUD meter frames.
+use cua_driver_contract::{CompanionTeachingMessage, TeachingMessageKind};
+use fontdue::{
+    layout::{CoordinateSystem, Layout, LayoutSettings, TextStyle},
+    Font,
+};
+use std::sync::OnceLock;
+use tiny_skia::{FillRule, PathBuilder, Pixmap, PixmapPaint, Transform};
+
+#[derive(Default)]
+pub struct MessagePainter {
+    pub message: Option<CompanionTeachingMessage>,
+    elapsed: f32,
+    speaking: Option<(u64, std::time::Instant)>,
+    identity: Option<(String, String, u64, u64)>,
+}
+fn font() -> Option<&'static Font> {
+    static FONT: OnceLock<Option<Font>> = OnceLock::new();
+    FONT.get_or_init(|| {
+        Font::from_bytes(
+            include_bytes!("../assets/Inter.ttf") as &[u8],
+            fontdue::FontSettings::default(),
+        )
+        .ok()
+    })
+    .as_ref()
+}
+impl MessagePainter {
+    pub fn update(&mut self, message: Option<CompanionTeachingMessage>) {
+        use std::hash::{Hash, Hasher};
+        let identity = message.as_ref().map(|m| {
+            let mut hash = std::collections::hash_map::DefaultHasher::new();
+            m.text.hash(&mut hash);
+            (
+                m.lesson_id.clone(),
+                m.step_id.clone(),
+                m.sequence,
+                hash.finish(),
+            )
+        });
+        if self.identity == identity {
+            return;
+        }
+        if let (Some(current), Some(next)) = (&self.identity, &identity) {
+            if current.0 == next.0 && next.2 < current.2 {
+                return;
+            }
+        }
+        self.identity = identity;
+        if let (Some(current), Some(next)) = (&self.message, &message) {
+            if current.lesson_id == next.lesson_id && next.sequence < current.sequence {
+                return;
+            }
+        }
+        self.message = message;
+        self.elapsed = 0.0;
+    }
+    pub fn set_speaking(&mut self, sequence: Option<u64>) {
+        if self.speaking.map(|(sequence, _)| sequence) == sequence {
+            return;
+        }
+        self.speaking = sequence.map(|sequence| (sequence, std::time::Instant::now()));
+    }
+
+    pub fn tick(&mut self, dt: f32, reduced: bool) {
+        self.elapsed += dt;
+        if self.speaking.is_some_and(|(sequence, started)| {
+            self.message
+                .as_ref()
+                .is_some_and(|message| message.sequence == sequence)
+                && started.elapsed().as_secs() < 60
+        }) {
+            self.elapsed = self.elapsed.min(self.reveal_duration(reduced) + 1.0);
+        }
+        if self
+            .message
+            .as_ref()
+            .is_some_and(|m| m.kind == TeachingMessageKind::Completion)
+            && self.elapsed >= self.reveal_duration(reduced) + 2.0 + if reduced { 0.0 } else { 2.8 }
+        {
+            self.message = None;
+        }
+    }
+    fn reveal_duration(&self, reduced: bool) -> f32 {
+        if reduced {
+            return 0.0;
+        }
+        self.message.as_ref().map_or(0.0, |m| {
+            m.text.split_whitespace().count().saturating_sub(1) as f32 * 0.09
+        })
+    }
+    fn alpha(&self, reduced: bool) -> f32 {
+        if !self
+            .message
+            .as_ref()
+            .is_some_and(|m| m.kind == TeachingMessageKind::Completion)
+        {
+            return 1.0;
+        }
+        let after_hold = self.elapsed - self.reveal_duration(reduced) - 2.0;
+        if after_hold <= 0.0 {
+            1.0
+        } else if reduced {
+            0.0
+        } else {
+            1.0 - (after_hold / 2.8).clamp(0.0, 1.0)
+        }
+    }
+    fn lines(&self, width: f32) -> Vec<String> {
+        let Some(message) = &self.message else {
+            return vec![];
+        };
+        let Some(font) = font() else {
+            return vec![];
+        };
+        let mut lines = vec![];
+        let mut line = String::new();
+        for word in message.text.split_whitespace() {
+            let candidate = if line.is_empty() {
+                word.to_string()
+            } else {
+                format!("{line} {word}")
+            };
+            let length: f32 = candidate
+                .chars()
+                .map(|ch| font.metrics(ch, 11.5).advance_width)
+                .sum();
+            if length > width - 20.0 && !line.is_empty() {
+                lines.push(line);
+                line = word.into();
+            } else {
+                line = candidate;
+            }
+        }
+        if !line.is_empty() {
+            lines.push(line);
+        }
+        lines
+    }
+    pub fn height(&self, width: f32) -> f32 {
+        if self.message.is_none() {
+            0.0
+        } else {
+            self.lines(width).len() as f32 * 17.0 + 16.0
+        }
+    }
+    pub fn paint(
+        &self,
+        image: &mut Pixmap,
+        origin: (f32, f32),
+        width: f32,
+        scale: f32,
+        reduced: bool,
+    ) {
+        let Some(message) = &self.message else {
+            return;
+        };
+        let Some(font) = font() else {
+            return;
+        };
+        let alpha = self.alpha(reduced);
+        let (x, y) = origin;
+        let height = self.height(width);
+        let r = 9.0;
+        let mut path = PathBuilder::new();
+        path.move_to(x + r, y);
+        path.line_to(x + width - r, y);
+        path.quad_to(x + width, y, x + width, y + r);
+        path.line_to(x + width, y + height - r);
+        path.quad_to(x + width, y + height, x + width - r, y + height);
+        path.line_to(x + r, y + height);
+        path.quad_to(x, y + height, x, y + height - r);
+        path.line_to(x, y + r);
+        path.quad_to(x, y, x + r, y);
+        path.close();
+        if let Some(path) = path.finish() {
+            image.fill_path(
+                &path,
+                &super::companion_hud::paint([12, 20, 29], alpha * 0.95),
+                FillRule::Winding,
+                Transform::from_scale(scale, scale),
+                None,
+            );
+            image.stroke_path(
+                &path,
+                &super::companion_hud::paint([120, 188, 243], alpha * 0.25),
+                &tiny_skia::Stroke {
+                    width: 1.0,
+                    ..Default::default()
+                },
+                Transform::from_scale(scale, scale),
+                None,
+            );
+        }
+        let count = if reduced {
+            usize::MAX
+        } else {
+            1 + (self.elapsed / 0.09) as usize
+        };
+        let mut remaining = count.min(message.text.split_whitespace().count());
+        for (index, line) in self.lines(width).iter().enumerate() {
+            let words: Vec<_> = line.split_whitespace().collect();
+            let shown = remaining.min(words.len());
+            remaining = remaining.saturating_sub(shown);
+            let text = words[..shown].join(" ");
+            let mut layout = Layout::new(CoordinateSystem::PositiveYDown);
+            layout.reset(&LayoutSettings::default());
+            layout.append(&[font], &TextStyle::new(&text, 11.5 * scale, 0));
+            for glyph in layout.glyphs() {
+                let (metrics, bitmap) = font.rasterize_config(glyph.key);
+                let Some(mut pixels) = Pixmap::new(metrics.width as u32, metrics.height as u32)
+                else {
+                    continue;
+                };
+                for (pixel, coverage) in pixels.data_mut().chunks_exact_mut(4).zip(bitmap) {
+                    let a = coverage as f32 * alpha;
+                    pixel.copy_from_slice(&[
+                        (229.0 / 255.0 * a) as u8,
+                        (237.0 / 255.0 * a) as u8,
+                        (244.0 / 255.0 * a) as u8,
