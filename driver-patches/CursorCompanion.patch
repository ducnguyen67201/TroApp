+#[link(name = "CoreMedia", kind = "framework")]
+extern "C" {
+    fn CMSampleBufferGetSampleAttachmentsArray(
+        sample: *mut std::ffi::c_void,
+        create_if_necessary: u8,
+    ) -> CFArrayRef;
+}
+#[link(name = "ScreenCaptureKit", kind = "framework")]
+extern "C" {
+    static SCStreamFrameInfoStatus: CFStringRef;
+}
+
+/// Decode Apple's numeric attachment, not a Swift enum object. The pinned
+/// screencapturekit 8.0.1 bridge casts NSNumber directly to SCFrameStatus and
+/// returns None for valid complete frames. Keep this adapter local to Tro;
+/// never accept unknown/absent statuses as a complete screen frame.
+fn read_frame_status_attachment(attachments: CFDictionaryRef) -> Option<SCFrameStatus> {
+    // All values are borrowed from a live sample (or an owned test dictionary).
+    // Validate CF types before retaining a numeric value; no attachment contents
+    // are persisted or logged.
+    unsafe {
+        if attachments.is_null() || CFGetTypeID(attachments.cast()) != CFDictionaryGetTypeID() {
+            return None;
+        }
+        let value = CFDictionaryGetValue(attachments, SCStreamFrameInfoStatus.cast());
+        if value.is_null() || CFGetTypeID(value) != CFNumberGetTypeID() {
+            return None;
+        }
+        let number = CFNumber::wrap_under_get_rule(value.cast());
+        let status = i32::try_from(number.to_i64()?).ok()?;
+        SCFrameStatus::from_raw(status)
+    }
+}
+fn read_screen_frame_status(
+    sample: &screencapturekit::cm::CMSampleBuffer,
+) -> Option<SCFrameStatus> {
+    // CoreMedia owns this immutable array for the retained sample's lifetime.
+    // We request no allocation and consume the borrowed first attachment only.
+    unsafe {
+        let attachments = CMSampleBufferGetSampleAttachmentsArray(sample.as_ptr(), 0);
+        if attachments.is_null() || CFArrayGetCount(attachments) == 0 {
+            return None;
+        }
+        read_frame_status_attachment(CFArrayGetValueAtIndex(attachments, 0).cast())
+    }
+}
