+/// Native input counters describe progression, not successful student actions.
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct CursorGuidanceSnapshot {
+    pub task_epoch: String,
+    pub reason: Option<String>,
+    pub input_revision: u64,
+}
+impl ToolOutput for CursorCompanionOutput {}
+
+pub fn contracts() -> Vec<ToolContract> {
+    vec![
+        contract_output::<PresentTeachingGuidanceInput, TeachingGuidanceOutput>("Host-only paired teaching presentation. Compile bounded normalized scribbles once, refresh and compare the bound primary capture, then install the drawing and HUD under a render fence. Never posts OS input. Version 3 requires an admitted task; at most 3 strokes, 32 points each and 15 seconds.", false),
+        contract_output::<GetCursorCompanionCapabilitiesInput, CursorCompanionCapabilities>("Read supported guidance versions and bounded native capabilities.", true),
+        contract_output::<BeginCursorGuidanceTaskInput, CursorGuidanceTaskOutput>("Host-only admission of a version 3 teaching task. Renewing following never resets a canceled task.", false),
+        contract_output::<EndCursorGuidanceTaskInput, CursorGuidanceTaskOutput>("Host-only release of a guidance task and clear its presentation.", false),
+        contract::<SetCursorCompanionModeInput>("Follow the real pointer with a companion, or hide it. One desktop owner, renewable 60-second lease. macOS primary display only.", false),
+        contract::<CancelCursorSequenceInput>("Cancel the current teaching sequence and clear marks; restore pointer following if enabled.", false),
+        contract::<GetCursorCompanionStateInput>("Read presentation state for the current session. This is not evidence of a desktop action.", true),
+    ]
+}
+fn contract<I: ToolInput>(description: &str, read_only: bool) -> ToolContract {
+    contract_output::<I, CursorCompanionOutput>(description, read_only)
+}
+fn contract_output<I: ToolInput, O: ToolOutput>(
+    description: &str,
+    read_only: bool,
+) -> ToolContract {
+    ToolContract {
+        name: I::TOOL_NAME.into(),
+        description: description.into(),
+        platforms: vec![Platform::Macos],
+        aliases: vec![],
+        capabilities: vec!["agent_cursor.teaching".into()],
+        annotations: ToolAnnotations {
+            read_only,
+            destructive: false,
+            idempotent: !matches!(I::TOOL_NAME, "present_teaching_guidance"),
+            open_world: false,
+        },
+        schema_mode: SchemaMode::CanonicalRuntime,
+        cursor_semantics: None,
+        input_schema: I::input_schema(),
+        success_output_schema: Some(O::output_schema()),
+        error_output_schema: None,
+        output_validator: crate::validate_typed_output::<O>,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn companion_state_accepts_guidance_during_renewal_and_rejects_malformed_metadata() {
+        for tool in [
+            "set_cursor_companion_mode",
+            "get_cursor_companion_state",
+            "cancel_cursor_sequence",
+        ] {
+            let legacy =
+                serde_json::json!({"status": "following", "following": true, "active": false});
+            assert!(crate::validate_success_output(tool, legacy.clone()).is_ok());
+            for reason in [serde_json::Value::Null, serde_json::json!("user_takeover")] {
+                let mut result = legacy.clone();
+                result["guidance"] = serde_json::json!({
+                    "task_epoch": "11111111-1111-4111-8111-111111111111",
+                    "reason": reason,
+                    "input_revision": 4,
+                });
+                assert!(crate::validate_success_output(tool, result.clone()).is_ok());
+                result["guidance"]["input_revision"] = serde_json::json!(-1);
+                assert!(crate::validate_success_output(tool, result).is_err());
+            }
+        }
+    }
+}
