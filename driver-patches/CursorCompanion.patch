+        let parsed: RefreshCursorGuidanceCaptureInput = serde_json::from_value(input).unwrap();
+        assert!(parsed.validate().is_err());
+    }
+    #[test]
+    fn companion_capture_diagnostics_pass_the_native_output_contract() {
+        let mut output = serde_json::json!({
+            "matched": false, "capture_id": null, "reason": "target_changed",
+            "diagnostics": { "matched": false, "capture_width_px": 200, "capture_height_px": 100,
+                "regions": [{ "step_index": 0, "step_kind": "click", "bounds_px": [94,44,107,57],
+                    "compared_pixels": 169, "changed_pixels": 2, "changed_fraction": 2.0 / 169.0,
+                    "max_channel_delta": 20, "first_changed_pixel": [100,50] }] }
+        });
+        assert!(
+            crate::validate_success_output("refresh_cursor_guidance_capture", output.clone())
+                .is_ok()
+        );
+        output["diagnostics"]["regions"][0]["changed_pixels"] = serde_json::json!(999);
+        assert!(crate::validate_success_output("refresh_cursor_guidance_capture", output).is_err());
+    }
+    #[test]
+    fn companion_capture_refresh_checks_public_input_and_output_contracts() {
+        let input = serde_json::json!({"session": null, "capture_id": "capture", "steps": [
+            {"kind":"click", "at":{"x":0.5,"y":0.5},"duration_ms":300}
+        ], "max_image_dimension": null});
+        let parsed: RefreshCursorGuidanceCaptureInput =
+            serde_json::from_value(input.clone()).unwrap();
+        assert!(parsed.validate().is_ok());
+        let mut invalid = input.clone();
+        invalid["steps"][0]["at"]["x"] = serde_json::json!(2.0);
+        assert!(
+            serde_json::from_value::<RefreshCursorGuidanceCaptureInput>(invalid)
+                .unwrap()
+                .validate()
+                .is_err()
+        );
+        let mut invalid = input;
+        invalid["unchecked"] = serde_json::json!(true);
+        assert!(serde_json::from_value::<RefreshCursorGuidanceCaptureInput>(invalid).is_err());
+        let tool = "refresh_cursor_guidance_capture";
+        assert!(crate::validate_success_output(
+            tool,
+            serde_json::json!({
+            "matched": true, "capture_id": "fresh", "reason": "target_unchanged"})
+        )
+        .is_ok());
+        assert!(crate::validate_success_output(
+            tool,
+            serde_json::json!({
+            "matched": false, "capture_id": null, "reason": "target_changed"})
+        )
+        .is_ok());
+        assert!(crate::validate_success_output(
+            tool,
+            serde_json::json!({
+            "matched": true, "capture_id": null, "reason": "target_unchanged"})
+        )
+        .is_err());
+        assert!(crate::validate_success_output(
+            tool,
+            serde_json::json!({
+            "matched": false, "capture_id": "fresh", "reason": "target_changed"})
+        )
