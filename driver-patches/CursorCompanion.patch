+//! One presentation owner. Message admission, completion and CALayer installation share this mutex.
+use cua_driver_contract::{
+    CompanionHudCommand, CompanionHudLocale, CompanionHudPhase, CompanionRenderToken,
+    CompanionTeachingMessage, SendCompanionHudCommandInput, SetCompanionHudInput,
+};
+use cursor_overlay::companion_hud::CompanionHudPainter;
+use std::{
+    collections::VecDeque,
+    sync::{Arc, Mutex, OnceLock},
+    time::{Duration, Instant},
+};
+use tokio::sync::watch;
+
+const LEASE_DURATION: Duration = Duration::from_secs(25);
+const RENDER_DEADLINE: Duration = Duration::from_secs(1);
+const MAX_REVISION: u64 = 9_007_199_254_740_991;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum CancelReason {
+    ExplicitClear,
+    LeaseExpired,
+    OwnerRetired,
+    BindingRetired,
+    CompletionFinished,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum RenderFailure {
+    DeadlineExceeded,
+    ImageConversion,
+    FrameInstallation,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum RenderOutcome {
+    Pending,
+    Presented,
+    Superseded,
+    Cancelled(CancelReason),
+    Failed(RenderFailure),
+}
+
+/// Frame consumers can observe completion, but cannot mutate it.
+#[derive(Clone)]
+pub(super) struct MessageFrame {
+    pub message: Arc<CompanionTeachingMessage>,
+    pub token: CompanionRenderToken,
+    pub deadline: Instant,
+    outcome: watch::Receiver<RenderOutcome>,
+}
+
+impl MessageFrame {
+    pub fn outcome(&self) -> RenderOutcome {
+        *self.outcome.borrow()
+    }
+
+    pub async fn wait(&self) -> RenderOutcome {
+        let mut outcome = self.outcome.clone();
+        loop {
+            let current = *outcome.borrow_and_update();
+            if current != RenderOutcome::Pending {
+                return current;
+            }
+            if outcome.changed().await.is_err() {
+                return RenderOutcome::Cancelled(CancelReason::OwnerRetired);
+            }
+        }
+    }
+}
+
+struct Presentation {
+    frame: MessageFrame,
+    sender: watch::Sender<RenderOutcome>,
+    sources: Vec<String>,
+}
+
+impl Presentation {
+    fn finish(&self, next: RenderOutcome) -> bool {
+        if next == RenderOutcome::Pending {
+            return false;
+        }
+        let changed = self.sender.send_if_modified(|outcome| {
+            if *outcome != RenderOutcome::Pending {
+                return false;
+            }
+            *outcome = next;
+            true
+        });
+        if changed {
+            if let RenderOutcome::Failed(reason) = next {
+                tracing::warn!(target: "companion_hud", render_id = %self.frame.token.render_id,
+                    message_sequence = self.frame.message.sequence, reason = ?reason,
+                    "Native message presentation failed.");
+            }
+        }
+        changed
+    }
+}
+
+/// Every composite, including empty scenes, is fenced against message and owner changes.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) struct SceneToken {
+    epoch: String,
+    revision: u64,
+}
+
+pub(super) struct HudState {
+    owner: Option<String>,
+    group: Option<String>,
+    sequence: Option<u64>,
+    expires: Option<Instant>,
+    epoch: String,
+    revision: u64,
+    watermark: Option<CompanionTeachingMessage>,
+    active_lesson: Option<String>,
+    retired_lessons: VecDeque<String>,
+    current: Option<Presentation>,
+    pub bindings: VecDeque<String>,
+    pub painter: CompanionHudPainter,
+}
+
+impl Default for HudState {
+    fn default() -> Self {
+        Self {
+            owner: None,
+            group: None,
+            sequence: None,
+            expires: None,
+            epoch: uuid::Uuid::new_v4().to_string(),
+            revision: 0,
+            watermark: None,
+            active_lesson: None,
+            retired_lessons: VecDeque::new(),
+            current: None,
+            bindings: VecDeque::new(),
+            painter: CompanionHudPainter::default(),
+        }
+    }
+}
+
+pub(super) fn state() -> &'static Mutex<HudState> {
+    static STATE: OnceLock<Mutex<HudState>> = OnceLock::new();
+    STATE.get_or_init(|| Mutex::new(HudState::default()))
+}
+
+impl HudState {
+    fn has_live_lease(&self, now: Instant) -> bool {
+        self.expires.is_some_and(|expires| expires > now)
+    }
+
+    fn can_present(&self, session: &str, group: &str, now: Instant) -> bool {
+        self.group.as_deref() == Some(group)
+            && self.has_live_lease(now)
+            && (self.owner.as_deref() == Some(session)
+                || self.bindings.iter().any(|key| key == session))
+    }
+
+    fn advance_scene(&mut self) -> Result<(), &'static str> {
+        self.revision = self
+            .revision
+            .checked_add(1)
+            .filter(|revision| *revision <= MAX_REVISION)
+            .ok_or("revision_exhausted")?;
+        Ok(())
+    }
+
+    fn cancel_current(&mut self, reason: CancelReason) {
+        if let Some(current) = self.current.take() {
+            current.finish(RenderOutcome::Cancelled(reason));
+        }
+        self.painter.update_message(None);
+    }
+
+    fn retire_owner(&mut self, reason: CancelReason) {
+        self.cancel_current(reason);
+        self.epoch = uuid::Uuid::new_v4().to_string();
+        self.revision = 0;
+        self.watermark = None;
+        self.active_lesson = None;
+        self.retired_lessons.clear();
+        self.owner = None;
+        self.sequence = None;
+        self.expires = None;
+        self.painter
+            .update(CompanionHudPhase::Idle, CompanionHudLocale::English, 0.0);
+    }
+
+    fn claim_owner(&mut self, session: &str, group: &str, sequence: u64, now: Instant) -> bool {
+        if self.has_live_lease(now) && self.owner.as_deref() != Some(session) {
+            return false;
+        }
+        if self.owner.as_deref() == Some(session)
+            && self.group.as_deref() == Some(group)
+            && self.sequence.is_some_and(|previous| sequence <= previous)
+        {
+            return false;
+        }
+        if self.owner.as_deref() != Some(session)
+            || self.group.as_deref() != Some(group)
+            || !self.has_live_lease(now)
+        {
+            if self.group.as_deref() != Some(group) {
+                self.bindings.clear();
+            }
+            self.retire_owner(CancelReason::OwnerRetired);
+        }
+        self.owner = Some(session.into());
+        self.group = Some(group.into());
+        self.sequence = Some(sequence);
+        self.expires = Some(now + LEASE_DURATION);
+        true
+    }
+    /// Legacy snapshots go through common admission. A stale payload can never rewrite the receipt.
+    pub fn update(&mut self, session: &str, input: SetCompanionHudInput) -> bool {
+        let now = Instant::now();
+        if !self.claim_owner(session, &input.group, input.sequence, now) {
+            return false;
+        }
+        if let Some(message) = input.message {
+            // Legacy refreshes cannot switch an established lesson context.
+            let _ = self.accept_message(session, message, now, false);
+        }
+        // Omitted legacy message is appearance-only. Explicit clears require the native token.
+        self.painter.message.set_speaking(input.speaking_sequence);
+        self.painter
+            .update(input.phase, input.locale, input.level as f32);
+        true
+    }
+
+    pub fn apply_command(&mut self, session: &str, input: &SendCompanionHudCommandInput) -> bool {
+        let now = Instant::now();
+        if self.owner.as_deref() != Some(session)
+            || self.group.as_deref() != Some(&input.group)
+            || !self.has_live_lease(now)
+            || self
+                .sequence
+                .is_some_and(|sequence| input.sequence <= sequence)
+        {
+            return false;
+        }
+        self.sequence = Some(input.sequence);
+        self.expires = Some(now + LEASE_DURATION);
+        match &input.command {
+            CompanionHudCommand::UpdateAppearance {
+                phase,
+                locale,
+                level,
+                speaking_sequence,
+            } => {
+                self.painter.message.set_speaking(*speaking_sequence);
+                self.painter.update(*phase, *locale, *level as f32);
+            }
+            CompanionHudCommand::ClearMessage { expected_token } => {
+                self.clear_token(session, &input.group, expected_token);
+            }
+            _ => {}
+        }
+        true
+    }
+
+    fn accept_message(
+        &mut self,
+        session: &str,
+        message: CompanionTeachingMessage,
+        now: Instant,
+        allow_context_change: bool,
+    ) -> Result<MessageFrame, &'static str> {
+        if !message.validate() {
+            return Err("invalid_message");
+        }
+        if self
+            .retired_lessons
+            .iter()
+            .any(|lesson| lesson == &message.lesson_id)
+        {
+            return Err("foreign_lesson");
+        }
+        if self
+            .active_lesson
+            .as_ref()
+            .is_some_and(|lesson| lesson != &message.lesson_id)
+            && !allow_context_change
+        {
+            return Err("foreign_lesson");
+        }
+        if let Some(previous) = &self.watermark {
+            if previous.lesson_id != message.lesson_id && !allow_context_change {
+                return Err("foreign_lesson");
+            }
+            if previous.lesson_id == message.lesson_id {
+                if message.sequence < previous.sequence {
+                    return Err("stale_message");
+                }
+                if message.sequence == previous.sequence {
+                    if previous != &message {
+                        return Err("message_conflict");
+                    }
+                    let current = self.current.as_mut().ok_or("message_cleared")?;
+                    if current.frame.outcome() == RenderOutcome::Pending
+                        && !current.sources.iter().any(|source| source == session)
+                    {
+                        // At most the lease owner plus its eight registered cursor bindings.
+                        current.sources.push(session.into());
+                    }
+                    return Ok(current.frame.clone());
+                }
+            }
+        }
+        self.advance_scene()?;
+        let token = CompanionRenderToken {
+            owner_epoch: self.epoch.clone(),
+            revision: self.revision,
+            render_id: uuid::Uuid::new_v4().to_string(),
+        };
+        let (sender, outcome) = watch::channel(RenderOutcome::Pending);
+        let frame = MessageFrame {
+            token,
+            message: Arc::new(message.clone()),
+            deadline: now + RENDER_DEADLINE,
+            outcome,
+        };
+        if let Some(previous) = self.current.take() {
+            previous.finish(RenderOutcome::Superseded);
+        }
+        if self
+            .active_lesson
+            .as_ref()
+            .is_some_and(|lesson| lesson != &message.lesson_id)
+        {
+            if let Some(previous) = self.active_lesson.take() {
+                if self.retired_lessons.len() >= 8 {
+                    self.retired_lessons.pop_front();
+                }
+                self.retired_lessons.push_back(previous);
+            }
+        }
+        self.active_lesson = Some(message.lesson_id.clone());
+        self.watermark = Some(message.clone());
+        self.painter.update_message(Some(message));
+        self.current = Some(Presentation {
+            frame: frame.clone(),
+            sender,
+            sources: vec![session.into()],
+        });
+        Ok(frame)
+    }
+
+    pub fn present_message(
+        &mut self,
+        session: &str,
+        group: &str,
+        locale: CompanionHudLocale,
+        message: CompanionTeachingMessage,
+    ) -> Result<MessageFrame, &'static str> {
+        let now = Instant::now();
+        if !self.can_present(session, group, now) {
+            return Err("owner_unavailable");
+        }
+        let frame = self.accept_message(
+            session,
+            message,
+            now,
+            self.owner.as_deref() == Some(session),
+        )?;
+        self.painter.update(CompanionHudPhase::Showing, locale, 0.0);
+        Ok(frame)
+    }
+
+    pub fn scene_token(&self) -> SceneToken {
+        SceneToken {
+            epoch: self.epoch.clone(),
+            revision: self.revision,
+        }
+    }
+
+    pub fn message_frame(&self) -> Option<MessageFrame> {
+        self.current
+            .as_ref()
+            .filter(|current| {
+                self.painter.message.message.as_ref() == Some(current.frame.message.as_ref())
+            })
+            .map(|current| current.frame.clone())
+    }
+    /// Called on the main queue while holding HudState; installation is synchronous and cannot acquire RENDER.
+    /// Guidance fences are acquired after HudState everywhere; no callback holds them while acquiring HudState.
+    pub fn install_frame(
+        &mut self,
+        scene: &SceneToken,
+        message: Option<&CompanionRenderToken>,
+        now: Instant,
+        install: impl FnOnce() -> Result<bool, RenderFailure>,
+    ) -> bool {
+        if &self.scene_token() != scene {
+            return false;
+        }
+        if message.is_some() && !self.has_live_lease(now) {
+            self.retire_owner(CancelReason::LeaseExpired);
+            return false;
+        }
+        if let Some(token) = message {
+            let Some(current) = &self.current else {
+                return false;
+            };
+            if &current.frame.token != token {
+                return false;
+            }
+            match current.frame.outcome() {
+                RenderOutcome::Pending if now >= current.frame.deadline => {
+                    self.fail_token(token, RenderFailure::DeadlineExceeded);
+                    return false;
+                }
+                RenderOutcome::Pending | RenderOutcome::Presented => {}
+                _ => return false,
+            }
+        }
+        match install() {
+            Ok(true) => {
+                if message.is_some() {
+                    if let Some(current) = &self.current {
+                        current.finish(RenderOutcome::Presented);
+                    }
+                }
+                true
+            }
+            Ok(false) => false,
+            Err(reason) => {
+                if let Some(token) = message {
+                    self.fail_token(token, reason);
+                }
+                false
+            }
+        }
+    }
+
+    pub fn fail_token(&mut self, token: &CompanionRenderToken, reason: RenderFailure) -> bool {
+        let failed = self
+            .current
+            .as_ref()
+            .filter(|current| &current.frame.token == token)
+            .is_some_and(|current| current.finish(RenderOutcome::Failed(reason)));
+        if failed {
+            // Retain the terminal job for exact duplicates, but invalidate queued pixels and clear its projection.
+            let _ = self.advance_scene();
+            self.painter.update_message(None);
+        }
+        failed
+    }
+
+    pub fn clear_token(
+        &mut self,
+        session: &str,
+        group: &str,
+        token: &CompanionRenderToken,
+    ) -> bool {
+        if !self.can_present(session, group, Instant::now())
+            || !self
+                .current
+                .as_ref()
+                .is_some_and(|current| &current.frame.token == token)
+            || self.advance_scene().is_err()
+        {
+            return false;
+        }
+        self.cancel_current(CancelReason::ExplicitClear);
+        true
+    }
+
+    pub fn read_message(&self, session: &str, group: &str) -> Option<MessageFrame> {
+        if self.owner.as_deref() != Some(session)
+            || self.group.as_deref() != Some(group)
+            || !self.has_live_lease(Instant::now())
+        {
+            return None;
+        }
+        self.current
+            .as_ref()
+            .filter(|current| current.frame.outcome() == RenderOutcome::Presented)
+            .map(|current| current.frame.clone())
+    }
+
+    pub fn bind(&mut self, session: &str, group: &str) -> bool {
+        if self.group.as_deref() != Some(group) || !self.has_live_lease(Instant::now()) {
+            return false;
+        }
+        self.bindings.retain(|key| key != session);
+        if self.bindings.len() >= 8 {
+            if let Some(removed) = self.bindings.pop_front() {
+                self.cancel_source(&removed);
+            }
+        }
+        self.bindings.push_back(session.into());
+        true
+    }
+
+    pub fn bind_lesson(&mut self, session: &str, group: &str, lesson: &str) -> bool {
+        if !self.can_present(session, group, Instant::now())
+            || self.bindings.back().map(String::as_str) != Some(session)
+            || self
+                .retired_lessons
+                .iter()
+                .any(|previous| previous == lesson)
+        {
+            return false;
+        }
+        if self.active_lesson.as_deref() == Some(lesson) {
+            return true;
+        }
+        if self.advance_scene().is_err() {
+            return false;
+        }
+        if let Some(previous) = self.active_lesson.take() {
+            if self.retired_lessons.len() >= 8 {
+                self.retired_lessons.pop_front();
+            }
+            self.retired_lessons.push_back(previous);
+        }
+        if let Some(current) = self.current.take() {
+            current.finish(RenderOutcome::Superseded);
+        }
+        self.painter.update_message(None);
+        self.watermark = None;
+        self.active_lesson = Some(lesson.into());
+        true
+    }
+
+    fn cancel_source(&mut self, session: &str) {
+        if self.current.as_ref().is_some_and(|current| {
+            current.sources.iter().any(|source| source == session)
+                && current.frame.outcome() == RenderOutcome::Pending
+        }) {
+            if self.advance_scene().is_ok() {
+                self.cancel_current(CancelReason::BindingRetired);
+            }
+        }
+    }
+
+    pub fn tick(&mut self, dt: f32, reduced: bool) -> bool {
+        let now = Instant::now();
+        if self.expires.is_some() && !self.has_live_lease(now) {
+            self.retire_owner(CancelReason::LeaseExpired);
+        }
+        let expired = self
+            .current
+            .as_ref()
+            .filter(|current| {
+                now >= current.frame.deadline && current.frame.outcome() == RenderOutcome::Pending
+            })
+            .map(|current| current.frame.token.clone());
+        if let Some(token) = expired {
+            self.fail_token(&token, RenderFailure::DeadlineExceeded);
+        }
+        self.painter.tick(dt, reduced);
+        if self
+            .current
+            .as_ref()
+            .is_some_and(|current| current.frame.outcome() == RenderOutcome::Presented)
+            && self.painter.message.has_finished_completion(reduced)
+            && self.advance_scene().is_ok()
+        {
+            self.cancel_current(CancelReason::CompletionFinished);
+        }
+        self.painter.is_visible()
+    }
+
+    pub fn retire(&mut self, key: &str, prefix: bool) {
+        let matches = |candidate: &str| {
+            if prefix {
+                candidate.starts_with(key)
+            } else {
+                candidate == key
+            }
+        };
+        let removed: Vec<_> = self
+            .bindings
+            .iter()
+            .filter(|candidate| matches(candidate))
+            .cloned()
+            .collect();
+        self.bindings.retain(|candidate| !matches(candidate));
+        for session in removed {
+            self.cancel_source(&session);
+        }
+        if self.owner.as_deref().is_some_and(matches) {
+            self.retire_owner(CancelReason::OwnerRetired);
+        }
+    }
+}
