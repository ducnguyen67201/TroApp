+//! Bounded presentation-only teaching protocol. Coordinates are fractions of
+//! a fresh primary-desktop capture, never OS input coordinates.
+use crate::{Platform, SchemaMode, ToolAnnotations, ToolContract, ToolInput, ToolOutput};
+use schemars::JsonSchema;
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, JsonSchema, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct CompanionPoint {
+    pub x: f64,
+    pub y: f64,
+}
+
+/// Host-owned limits shared by validation, compilation and receipts.
+pub const SCRIBBLE_MAX_STROKES: usize = 3;
+pub const SCRIBBLE_MAX_POINTS: usize = 32;
+pub const SCRIBBLE_MIN_HOLD_MS: u64 = 1100;
+pub const SCRIBBLE_STROKE_WIDTH_POINTS: f64 = 3.0;
+
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct TeachingStroke {
+    #[schemars(length(min = 2, max = 32))]
+    pub points: Vec<CompanionPoint>,
+    pub closed: bool,
+}
+impl TeachingStroke {
+    pub fn validate(&self) -> bool {
+        if !(2..=SCRIBBLE_MAX_POINTS).contains(&self.points.len())
+            || self.points.iter().any(|point| {
+                !point.x.is_finite()
+                    || !point.y.is_finite()
+                    || !(0.0..=1.0).contains(&point.x)
+                    || !(0.0..=1.0).contains(&point.y)
+            })
+        {
+            return false;
+        }
+        let mut unique = Vec::new();
+        for point in &self.points {
+            if !unique.contains(point) {
+                unique.push(*point);
+            }
+        }
+        if !self.closed {
+            return unique.len() >= 2;
+        }
+        if unique.len() < 3 {
+            return false;
+        }
+        let first = unique[0];
+        let second = unique[1];
+        unique.iter().skip(2).any(|point| {
+            ((second.x - first.x) * (point.y - first.y)
+                - (second.y - first.y) * (point.x - first.x))
+                .abs()
+                > 1e-12
+        })
+    }
+}
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct TeachingDrawing {
+    #[schemars(length(min = 1, max = 3))]
+    pub strokes: Vec<TeachingStroke>,
+}
+impl TeachingDrawing {
+    pub fn validate(&self) -> bool {
+        (1..=SCRIBBLE_MAX_STROKES).contains(&self.strokes.len())
+            && self.strokes.iter().all(TeachingStroke::validate)
+    }
+}
+
+/// Host-derived normalized control bounds, never the full travel path.
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct TeachingTarget {
+    pub x: f64,
+    pub y: f64,
+    pub width: f64,
+    pub height: f64,
+}
+impl TeachingTarget {
+    pub fn validate(&self) -> bool {
+        [self.x, self.y, self.width, self.height]
+            .iter()
+            .all(|value| value.is_finite())
+            && self.x >= 0.0
+            && self.y >= 0.0
+            && self.width > 0.0
+            && self.height > 0.0
+            && self.x + self.width <= 1.0
+            && self.y + self.height <= 1.0
+    }
+}
+/// One host-bound drawing/message installation. No legacy or omitted-version route.
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct PresentTeachingGuidanceInput {
+    pub session: Option<String>,
+    pub capture_id: String,
+    #[schemars(length(max = 2))]
+    pub targets: Vec<TeachingTarget>,
+    pub hud_group: String,
+    pub teaching_locale: crate::CompanionHudLocale,
+    pub teaching_message: crate::CompanionTeachingMessage,
+    pub presentation_id: String,
+    pub text_only: bool,
+    pub presentation_version: u32,
+    #[serde(deserialize_with = "deserialize_drawing")]
+    #[schemars(required, schema_with = "nullable_drawing_schema")]
+    pub drawing: Option<TeachingDrawing>,
+    pub max_image_dimension: Option<u32>,
+}
+fn nullable_drawing_schema(generator: &mut schemars::SchemaGenerator) -> schemars::Schema {
+    generator.subschema_for::<Option<TeachingDrawing>>()
+}
+fn deserialize_drawing<'de, D: serde::Deserializer<'de>>(
+    deserializer: D,
+) -> Result<Option<TeachingDrawing>, D::Error> {
+    Option::<TeachingDrawing>::deserialize(deserializer)
+}
+impl ToolInput for PresentTeachingGuidanceInput {
+    const TOOL_NAME: &'static str = "present_teaching_guidance";
+    fn validate(&self) -> Result<(), String> {
+        if self.presentation_version != 3
+            || self.capture_id.is_empty()
+            || !self.teaching_message.validate()
+            || self.hud_group.is_empty()
+            || self.presentation_id.len() != 36
+            || self.targets.len() > 2
+            || self.targets.iter().any(|target| !target.validate())
+            || self.text_only != self.drawing.is_none()
+            || self
+                .drawing
+                .as_ref()
+                .is_some_and(|drawing| !drawing.validate())
+            || (self.text_only && !self.targets.is_empty())
+            || (!self.text_only && self.targets.is_empty())
+        {
+            return Err("Use version 3, bound message identity, 1..3 valid strokes with 2..32 normalized points each for spatial guidance, or an explicit null drawing and no targets for text-only guidance.".into());
+        }
+        Ok(())
+    }
+}
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, JsonSchema)]
