new file mode 100644
index 0000000..1442925
--- /dev/null
+++ b/libs/cua-driver/rust/crates/cursor-overlay/src/guidance.rs
@@ -0,0 +1,253 @@
+//! Bounded, pure guidance planning and compositor evidence. Never posts input.
+use crate::companion::{plan_mark, plan_path};
+use cua_driver_contract::CompanionStep;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+pub const MAX_FRAME_GAP: Duration = Duration::from_millis(150);
+pub const FADE_MS: u64 = 350;
+pub const RETURN_MS: u64 = 700;
+
+#[derive(Debug, Default)]
+pub struct FrameFence {
+    pub generation: u64,
+    pub rendered_revision: u64,
+}
+
+/// One indivisible pointer/cue scene. The platform stamps only after installing
+/// the CGImage in CALayer on the main queue. Cancel invalidates queued images.
+#[derive(Debug, Clone)]
+pub struct GuidanceFrame {
+    pub generation: u64,
+    pub revision: u64,
+    pub fence: Arc<Mutex<FrameFence>>,
+    pub receipt: Arc<Mutex<Option<Instant>>>,
+    pub pointer: (f64, f64),
+    pub cue: Vec<(f64, f64)>,
+    pub cue_alpha: f32,
+    pub teaching: bool,
+    pub visible: bool,
+    pub pressed: bool,
+}
+impl GuidanceFrame {
+    pub fn is_current(&self) -> bool {
+        self.fence.lock().unwrap().generation == self.generation
+    }
+}
+
+pub struct GuidanceStep {
+    pub path: Vec<(f64, f64)>,
+    pub mark: Vec<(f64, f64)>,
+    pub approach_ms: u64,
+    pub trace_ms: u64,
+    pub hold_ms: u64,
+    pub pressed: bool,
+}
+pub struct GuidancePlan {
+    pub steps: Vec<GuidanceStep>,
+    pub duration_ms: u64,
+}
+
+pub fn approach_duration(from: (f64, f64), to: (f64, f64)) -> u64 {
+    let distance = (to.0 - from.0).hypot(to.1 - from.1);
+    if distance < 0.01 {
+        0
+    } else {
+        ((distance / 900.0 * 1000.0) as u64).clamp(250, 1200)
+    }
+}
+
+pub fn compile_guidance(
+    steps: &[CompanionStep],
+    start: (f64, f64),
+    width: f64,
+    height: f64,
+) -> Result<GuidancePlan, &'static str> {
+    let mut previous = start;
+    let mut duration_ms = RETURN_MS;
+    let mut compiled = Vec::with_capacity(steps.len());
+    for step in steps {
+        let path = plan_path(step, width, height);
+        let mark = match step {
+            // A click preview is a small halo; the real pointer never clicks.
+            CompanionStep::Click { at, .. } => (0..=32)
+                .map(|index| {
+                    let angle = index as f64 / 32.0 * std::f64::consts::TAU;
+                    (
+                        at.x * width + 12.0 * angle.cos(),
+                        at.y * height + 12.0 * angle.sin(),
+                    )
+                })
+                .collect(),
+            _ => plan_mark(step, &path),
+        };
+        if path.iter().chain(&mark).any(|&(x, y)| {
+            !x.is_finite() || !y.is_finite() || x < 0.0 || y < 0.0 || x >= width || y >= height
+        }) {
+            return Err("invalid_request");
+        }
+        let first = *path.first().ok_or("invalid_request")?;
+        let last = *path.last().ok_or("invalid_request")?;
+        let approach_ms = approach_duration(previous, first);
+        let trace_ms = u64::from(step.duration_ms());
+        let hold_ms = u64::from(step.hold_ms());
+        duration_ms += approach_ms + trace_ms + hold_ms + FADE_MS;
+        compiled.push(GuidanceStep {
+            path,
+            mark,
+            approach_ms,
+            trace_ms,
+            hold_ms,
+            pressed: matches!(step, CompanionStep::Drag { .. }),
+        });
+        previous = last;
+    }
+    if compiled.is_empty() || compiled.len() > 8 || duration_ms > 15000 {
+        return Err("invalid_request");
+    }
+    Ok(GuidancePlan {
+        steps: compiled,
+        duration_ms,
+    })
+}
+
+/// Arc-length sampling keeps rectangles and unequal segments at uniform speed.
+pub fn reveal_path(path: &[(f64, f64)], progress: f64) -> Vec<(f64, f64)> {
+    if path.is_empty() {
+        return vec![];
+    }
+    if progress >= 1.0 {
+        return path.to_vec();
+    }
+    let lengths: Vec<f64> = path
+        .windows(2)
+        .map(|pair| (pair[1].0 - pair[0].0).hypot(pair[1].1 - pair[0].1))
+        .collect();
+    let mut remaining = progress.clamp(0.0, 1.0) * lengths.iter().sum::<f64>();
+    let mut revealed = vec![path[0]];
+    for (pair, distance) in path.windows(2).zip(lengths) {
+        if remaining >= distance {
+            revealed.push(pair[1]);
+            remaining -= distance;
+        } else {
+            let amount = if distance > 0.0 {
+                remaining / distance
+            } else {
+                0.0
+            };
+            revealed.push((
+                pair[0].0 + (pair[1].0 - pair[0].0) * amount,
+                pair[0].1 + (pair[1].1 - pair[0].1) * amount,
+            ));
+            break;
+        }
+    }
+    revealed
+}
+pub fn point_on_path(path: &[(f64, f64)], progress: f64) -> (f64, f64) {
+    reveal_path(path, progress)
+        .last()
+        .copied()
+        .unwrap_or((0.0, 0.0))
+}
+
+/// Per-step evidence remains independent of terminal clear/return receipts.
+#[derive(Default)]
+pub struct StepEvidence {
+    intermediate: bool,
+    complete: Option<Instant>,
+    last: Option<Instant>,
+}
+impl StepEvidence {
+    pub fn record_trace(
+        &mut self,
+        progress: f64,
+        rendered_at: Instant,
+    ) -> Result<(), &'static str> {
+        if self.last.is_some_and(|last| {
+            rendered_at < last || rendered_at.saturating_duration_since(last) > MAX_FRAME_GAP
+        }) {
+            return Err("render_timeout");
+        }
+        self.last = Some(rendered_at);
+        self.intermediate |= progress > 0.0 && progress < 1.0;
+        if progress >= 1.0 {
+            self.complete = Some(rendered_at);
+        }
+        Ok(())
+    }
+    pub fn finish_hold(
+        &self,
+        rendered_at: Instant,
+        hold_ms: u64,
+        reduced_motion: bool,
+    ) -> Result<(), &'static str> {
+        match self.complete {
+            Some(complete)
+                if (self.intermediate || reduced_motion)
+                    && rendered_at.saturating_duration_since(complete)
+                        >= Duration::from_millis(hold_ms) =>
+            {
+                Ok(())
+            }
+            _ => Err("render_timeout"),
+        }
+    }
+    pub fn hold_started(&self) -> Option<Instant> {
+        self.complete
+    }
+}
+
+#[cfg(test)]
+mod companion_tests {
+    use super::*;
+    use cua_driver_contract::CompanionPoint;
+    #[test]
+    fn companion_timeline_counts_automatic_phases() {
+        let step = CompanionStep::Circle {
+            center: CompanionPoint { x: 0.5, y: 0.5 },
+            radius: 0.1,
+            duration_ms: 5000,
+            hold_ms: Some(2000),
+        };
+        assert!(compile_guidance(&[step.clone(), step], (0.0, 0.0), 1000.0, 500.0).is_err());
+    }
+    #[test]
+    fn companion_reveal_uses_distance_and_is_bounded() {
+        let path = [(0.0, 0.0), (100.0, 0.0), (100.0, 10.0)];
+        let sampled = point_on_path(&path, 0.5);
+        assert!((sampled.0 - 55.0).abs() < 1e-9);
+        assert_eq!(sampled.1, 0.0);
+        assert_eq!(reveal_path(&path, 1.0), path);
+        assert_eq!(approach_duration((1.0, 1.0), (1.0, 1.0)), 0);
+    }
+    #[test]
+    fn companion_terminal_receipt_cannot_replace_trace_or_hold() {
+        let start = Instant::now();
+        let mut evidence = StepEvidence::default();
+        evidence.record_trace(1.0, start).unwrap();
+        assert!(evidence
+            .finish_hold(start + Duration::from_secs(2), 1100, false)
+            .is_err());
+        let mut evidence = StepEvidence::default();
+        evidence.record_trace(0.5, start).unwrap();
+        evidence
+            .record_trace(1.0, start + Duration::from_millis(50))
+            .unwrap();
+        assert!(evidence
+            .finish_hold(start + Duration::from_millis(100), 1100, false)
+            .is_err());
+        assert!(evidence
+            .finish_hold(start + Duration::from_millis(1150), 1100, false)
+            .is_ok());
+    }
+    #[test]
+    fn companion_stalled_compositor_fails_trace() {
+        let start = Instant::now();
+        let mut evidence = StepEvidence::default();
+        evidence.record_trace(0.2, start).unwrap();
+        assert!(evidence
+            .record_trace(0.8, start + Duration::from_millis(151))
+            .is_err());
+    }
+}
