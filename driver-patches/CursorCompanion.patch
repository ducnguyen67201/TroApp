@@ -0,0 +1,133 @@
+//! Host-only content-free presentation vocabulary; no desktop action semantics.
+use crate::{Platform, SchemaMode, ToolAnnotations, ToolContract, ToolInput, ToolOutput};
+use schemars::JsonSchema;
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, JsonSchema, Default)]
+#[serde(rename_all = "snake_case")]
+pub enum CompanionHudPhase {
+    #[default]
+    Idle,
+    Preparing,
+    Listening,
+    Transcribing,
+    Sending,
+    Thinking,
+    Showing,
+    Working,
+    Done,
+    Canceled,
+    Error,
+    DailyLimit,
+    NeedsInput,
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, JsonSchema, Default)]
+pub enum CompanionHudLocale {
+    #[default]
+    #[serde(rename = "en")]
+    English,
+    #[serde(rename = "vi")]
+    Vietnamese,
+}
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct SetCompanionHudInput {
+    pub session: Option<String>,
+    pub group: String,
+    pub sequence: u64,
+    pub phase: CompanionHudPhase,
+    pub locale: CompanionHudLocale,
+    pub level: f64,
+}
+impl ToolInput for SetCompanionHudInput {
+    const TOOL_NAME: &'static str = "set_companion_hud";
+    fn validate(&self) -> Result<(), String> {
+        if !valid_group(&self.group)
+            || !self.level.is_finite()
+            || !(0.0..=1.0).contains(&self.level)
+            || self.sequence > 9_007_199_254_740_991
+        {
+            return Err("Invalid bounded HUD snapshot.".into());
+        }
+        Ok(())
+    }
+}
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct BindCompanionHudCursorInput {
+    pub session: Option<String>,
+    pub group: String,
+}
+impl ToolInput for BindCompanionHudCursorInput {
+    const TOOL_NAME: &'static str = "bind_companion_hud_cursor";
+    fn validate(&self) -> Result<(), String> {
+        if !valid_group(&self.group) {
+            return Err("Invalid HUD group.".into());
+        }
+        Ok(())
+    }
+}
+fn valid_group(group: &str) -> bool {
+    group.len() == 36
+        && group.chars().enumerate().all(|(index, ch)| {
+            if [8, 13, 18, 23].contains(&index) {
+                ch == '-'
+            } else {
+                ch.is_ascii_hexdigit()
+            }
+        })
+}
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct CompanionHudOutput {
+    pub applied: bool,
+}
+impl ToolOutput for CompanionHudOutput {}
+pub fn contracts() -> Vec<ToolContract> {
+    vec![
+        contract::<SetCompanionHudInput>(),
+        contract::<BindCompanionHudCursorInput>(),
+    ]
+}
+fn contract<I: ToolInput>() -> ToolContract {
+    ToolContract {
+        name: I::TOOL_NAME.into(),
+        description: "Private host presentation. Not a model tool or desktop action.".into(),
+        platforms: vec![Platform::Macos],
+        aliases: vec![],
+        capabilities: vec!["agent_cursor.presentation".into()],
+        annotations: ToolAnnotations {
+            read_only: false,
+            destructive: false,
+            idempotent: true,
+            open_world: false,
+        },
+        schema_mode: SchemaMode::CanonicalRuntime,
+        cursor_semantics: None,
+        input_schema: I::input_schema(),
+        success_output_schema: Some(CompanionHudOutput::output_schema()),
+        error_output_schema: None,
+        output_validator: crate::validate_typed_output::<CompanionHudOutput>,
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn companion_hud_rejects_unbounded_input() {
+        let mut input = SetCompanionHudInput {
+            session: None,
+            group: "11111111-1111-4111-8111-111111111111".into(),
+            sequence: 0,
+            phase: CompanionHudPhase::Listening,
+            locale: CompanionHudLocale::English,
+            level: 0.5,
+        };
+        assert!(input.validate().is_ok());
+        input.level = f64::NAN;
+        assert!(input.validate().is_err());
+        input.level = 0.5;
+        input.group = "bad".into();
+        assert!(input.validate().is_err());
+    }
+}
