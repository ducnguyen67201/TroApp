+            "coordinate_trace":{"requested_capture_id":"old","capture_id":"fresh","screen_size_points":[100,100],"capture_size_px":[200,200],"display_scale":2,
+                "targets_normalized":[],"planned_strokes":[{"stroke_index":0,"cue_bounds_points":[0,0,10,10]}],"painted_strokes":[]}});
+        assert!(
+            crate::validate_success_output("present_teaching_guidance", output.clone()).is_ok()
+        );
+        output["receipt"]["strokes_presented"][0]["hold_ms_observed"] = serde_json::json!(1099);
+        assert!(
+            crate::validate_success_output("present_teaching_guidance", output.clone()).is_err()
+        );
+        output["receipt"]["interrupted"] = serde_json::json!(true);
+        output["receipt"]["strokes_presented"][0]["trace_progress"] = serde_json::json!(0.2);
+        assert!(
