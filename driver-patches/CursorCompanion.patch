+++ b/libs/cua-driver/rust/crates/platform-macos/src/tools/companion_tools.rs
@@ -0,0 +1,678 @@
+//! Native companion controller. This module never imports input executors.
+//! A single desktop lease prevents competing agents from painting guidance.
+use super::{cursor_tools::resolve_cursor_key, get_screen_size::main_screen_size, ToolState};
+#[path = "companion_guidance.rs"]
+mod guidance;
+use async_trait::async_trait;
+use cua_driver_contract::{
+    CancelCursorSequenceInput, CompanionMode, CompanionStep, GetCursorCompanionStateInput,
+    SetCursorCompanionModeInput, ShowCursorSequenceInput, ToolInput,
+};
+use cua_driver_core::{
+    capture_runtime::CaptureTarget,
+    protocol::ToolResult,
+    tool::{Tool, ToolDef, ToolRegistry},
+    tool_args::parse_typed_input,
+};
+use cursor_overlay::{
+    companion::{plan_mark, plan_path, sample_path},
+    OverlayCommand,
+};
+use serde_json::{json, Value};
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Arc, Mutex, OnceLock,
+};
+use std::time::{Duration, Instant};
+
+#[derive(Default)]
+struct CompanionState {
+    owner: Option<String>,
+    task_epoch: Option<String>,
+    task_owner: Option<String>,
+    terminal: Option<&'static str>,
+    task_input: Option<[u32; 7]>,
+    ended_task: Option<(String, Option<&'static str>)>,
+    fence: Arc<Mutex<cursor_overlay::guidance::FrameFence>>,
+    revision: u64,
+    pointer: Option<(f64, f64)>,
+    generation: u64,
+    follow_generation: u64,
+    following: bool,
+    active: bool,
+    lease_until: Option<Instant>,
+}
+impl CompanionState {
+    fn begin_sequence(&mut self, session: &str) -> Result<u64, String> {
+        if self.active || self.owner.as_deref().is_some_and(|owner| owner != session) {
+            return Err("Desktop companion is busy.".into());
+        }
+        self.owner = Some(session.to_owned());
+        if self.terminal.is_some() {
+            return Err("Teaching task has ended.".into());
+        }
+        self.active = true;
+        self.generation = self.generation.wrapping_add(1);
+        self.fence.lock().unwrap().generation = self.generation;
+        Ok(self.generation)
+    }
+    fn cancel_sequence(&mut self, session: &str) -> bool {
+        if self.owner.as_deref() != Some(session) {
+            return false;
+        }
+        self.generation = self.generation.wrapping_add(1);
+        self.active = false;
+        if self.task_epoch.is_some() {
+            self.terminal = Some("explicit_stop");
+        }
+        self.fence.lock().unwrap().generation = self.generation;
+        true
+    }
+}
+
+/// Count only keyboard, button and scroll events. Guidance never posts any
+/// of these events; a changed counter signals student interaction.
+pub(super) fn read_user_input_counters() -> [u32; 7] {
+    #[link(name = "ApplicationServices", kind = "framework")]
+    extern "C" {
+        fn CGEventSourceCounterForEventType(state: i32, event_type: u32) -> u32;
+    }
+    [1, 3, 10, 11, 12, 22, 25]
+        .map(|event_type| unsafe { CGEventSourceCounterForEventType(1, event_type) })
+}
+
+fn state() -> &'static Mutex<CompanionState> {
+    static STATE: OnceLock<Mutex<CompanionState>> = OnceLock::new();
+    STATE.get_or_init(|| Mutex::new(CompanionState::default()))
+}
+fn send(session: &str, command: OverlayCommand) -> Result<(), String> {
+    if crate::cursor::overlay::try_send_command(session.to_owned(), command) {
+        Ok(())
+    } else {
+        Err("Native overlay unavailable or command queue full.".into())
+    }
+}
+fn clear_marks(session: &str) {
+    let _ = send(session, OverlayCommand::ShowCompanionMark(vec![]));
+    let _ = send(session, OverlayCommand::SetPressed(false));
+}
+
+fn hide_companion(session: &str) {
+    let _ = send(session, OverlayCommand::SetEnabled(false));
+    let _ = send(session, OverlayCommand::SetCompanionAppearance(false));
+}
+
+// Host-only progression metadata; never expose key values, locations or screen
+// content. An input revision requests observation, not verification of success.
+fn read_guidance_snapshot(state: &CompanionState, session: &str, input: [u32; 7]) -> Option<Value> {
+    if state.owner.as_deref() != Some(session) {
+        return None;
+    }
+    state.task_epoch.as_ref().map(|epoch| {
+        json!({
+            "task_epoch": epoch,
+            "reason": state.terminal,
+            "input_revision": input.iter().map(|value| u64::from(*value)).sum::<u64>(),
+        })
+    })
+}
+
+fn snapshot(session: &str, status: &str) -> ToolResult {
+    let state = state().lock().unwrap();
+    let owned = state.owner.as_deref() == Some(session);
+    let guidance = read_guidance_snapshot(&state, session, read_user_input_counters());
+    let mut result = json!({
+        "status": status, "following": owned && state.following, "active": owned && state.active,
+    });
+    if let Some(guidance) = guidance {
+        result["guidance"] = guidance;
+    }
+    ToolResult::text(status).with_structured(result)
+}
+pub(super) fn retire_session(session: &str) {
+    let mut state = state().lock().unwrap();
+    retire_owned_cursor(&mut state, session);
+}
+fn retire_owned_cursor(state: &mut CompanionState, session: &str) {
+    if state.owner.as_deref() == Some(session) {
+        state.generation = state.generation.wrapping_add(1);
+        state.follow_generation = state.follow_generation.wrapping_add(1);
+        state.fence.lock().unwrap().generation = state.generation;
+        if state.task_epoch.is_some() {
+            state.terminal = Some("session_lost");
+        }
+        state.active = false;
+        state.following = false;
+        state.owner = None;
+        state.lease_until = None;
+        state.clear_guidance(session, false);
+        clear_marks(session);
+        hide_companion(session);
+    }
+}
+pub(super) fn retire_runtime(prefix: &str) {
+    let owner = state().lock().unwrap().owner.clone();
+    if let Some(owner) = owner.filter(|owner| owner.starts_with(prefix)) {
+        retire_session(&owner);
+    }
+}
+fn can_continue_playback(session: &str) -> bool {
+    !cua_driver_core::session::is_session_ending(session)
+}
+
+fn start_following(session: String, generation: u64) {
+    std::thread::spawn(move || loop {
+        if !can_continue_playback(&session) {
+            retire_session(&session);
+            break;
+        }
+        {
+            let mut state = state().lock().unwrap();
+            if state.owner.as_deref() != Some(&session)
+                || !state.following
+                || state.follow_generation != generation
+            {
+                break;
+            }
+            if state
+                .lease_until
+                .is_some_and(|deadline| Instant::now() > deadline)
+            {
+                state.terminal = Some("lease_expired");
+                retire_owned_cursor(&mut state, &session);
+                state.terminal = Some("lease_expired");
+                break;
+            }
+            if state.task_epoch.is_some()
+                && state.terminal.is_none()
+                && state
+                    .task_input
+                    .is_some_and(|initial| read_user_input_counters() != initial)
+            {
+                state.terminal = Some("user_takeover");
+                state.active = false;
+                let visible = state.following;
+                state.clear_guidance(&session, visible);
+            }
+            if !state.active {
+                if let (Some((x, y)), Some((width, height, _))) = (
+                    cua_driver_core::cursor_sampler::read_cursor_position(),
+                    main_screen_size(),
+                ) {
+                    let visible = x >= 0.0 && y >= 0.0 && x < width as f64 && y < height as f64;
+                    if send(&session, OverlayCommand::SetEnabled(visible)).is_err() {
+                        retire_owned_cursor(&mut state, &session);
+                        break;
+                    }
+                    if visible {
+                        let point = (
+                            (x + 24.0).min(width as f64 - 2.0),
+                            (y + 24.0).min(height as f64 - 2.0),
+                        );
+                        let frame = state.create_frame(point, vec![], 0.0, false, true, false);
+                        if !crate::cursor::overlay::present_guidance_frame(&session, frame) {
+                            retire_owned_cursor(&mut state, &session);
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+        std::thread::sleep(Duration::from_millis(33));
+    });
+}
+
+struct CompanionTool {
+    companion: CursorCompanion,
+    definition: ToolDef,
+}
+
+/// Native presentation engine composed by the Cua tool adapter.
+struct CursorCompanion {
+    state: Arc<ToolState>,
+}
+#[async_trait]
+impl Tool for CompanionTool {
+    fn def(&self) -> &ToolDef {
+        &self.definition
+    }
+    async fn invoke(&self, args: Value) -> ToolResult {
+        if !self.companion.state.cursor_overlay_available {
+            return super::cursor_overlay_unavailable();
+        }
+        let session = resolve_cursor_key(&args);
+        match self.definition.name.as_str() {
+            "get_cursor_companion_capabilities"
+            | "begin_cursor_guidance_task"
+            | "end_cursor_guidance_task" => {
+                self.companion
+                    .invoke_guidance_lifecycle(&self.definition.name, &session, args)
+                    .await
+            }
+            "get_cursor_companion_state" => {
+                if let Err(error) =
+                    parse_typed_input::<GetCursorCompanionStateInput>(&self.definition.name, args)
+                {
+                    return error;
+                }
+                snapshot(&session, "state")
+            }
+            "cancel_cursor_sequence" => {
+                if let Err(error) =
+                    parse_typed_input::<CancelCursorSequenceInput>(&self.definition.name, args)
+                {
+                    return error;
+                }
+                let mut state = state().lock().unwrap();
+                if state.cancel_sequence(&session) {
+                    let visible = state.following;
+                    state.clear_guidance(&session, visible);
+                    clear_marks(&session);
+                    if !state.following {
+                        state.owner = None;
+                        hide_companion(&session);
+                    }
+                }
+                drop(state);
+                snapshot(&session, "canceled")
+            }
+            "set_cursor_companion_mode" => {
+                let input = match parse_typed_input::<SetCursorCompanionModeInput>(
+                    &self.definition.name,
+                    args,
+                ) {
+                    Ok(input) => input,
+                    Err(error) => return error,
+                };
+                if let Err(error) = input.validate() {
+                    return ToolResult::error(error);
+                }
+                if matches!(input.mode, CompanionMode::Hidden) {
+                    retire_session(&session);
+                    self.companion
+                        .state
+                        .cursor_registry
+                        .set_enabled(&session, false);
+                    return snapshot(&session, "hidden");
+                }
+                let mut state = state().lock().unwrap();
+                if state.owner.as_deref().is_some_and(|owner| owner != session) {
+                    return ToolResult::error("Another session owns the desktop companion.");
+                }
+                if state.owner.is_none() && state.task_owner.as_deref() != Some(&session) {
+                    state.task_epoch = None;
+                    state.task_owner = None;
+                    state.task_input = None;
+                    state.terminal = None;
+                    state.ended_task = None;
+                }
+                if !state.active {
+                    if let Err(error) = send(&session, OverlayCommand::SetCompanionAppearance(true))
+                    {
+                        return ToolResult::error(error);
+                    }
+                }
+                if let Some(label) = input.label {
+                    if let Err(error) = send(&session, OverlayCommand::SetSessionLabel(label)) {
+                        return ToolResult::error(error);
+                    }
+                }
+                let start = !state.following;
+                if start {
+                    state.follow_generation = state.follow_generation.wrapping_add(1);
+                }
+                let follow_generation = state.follow_generation;
+                state.owner = Some(session.clone());
+                state.following = true;
+                state.lease_until = Some(Instant::now() + Duration::from_secs(60));
+                self.companion
+                    .state
+                    .cursor_registry
+                    .set_enabled(&session, true);
+                if let Err(error) = send(&session, OverlayCommand::SetEnabled(true)) {
+                    state.owner = None;
+                    state.following = false;
+                    return ToolResult::error(error);
+                }
+                drop(state);
+                if start {
+                    start_following(session.clone(), follow_generation);
+                }
+                snapshot(&session, "following")
+            }
+            "show_cursor_sequence" => {
+                let input = match parse_typed_input::<ShowCursorSequenceInput>(
+                    &self.definition.name,
+                    args.clone(),
+                ) {
+                    Ok(input) => input,
+                    Err(_error) => {
+                        return self.companion.refuse_guidance(&session, "invalid_request")
+                    }
+                };
+                if input.validate().is_err() {
+                    return self.companion.refuse_guidance(
+                        &session,
+                        if input.presentation_version.is_some_and(|v| v != 2) {
+                            "unsupported_version"
+                        } else {
+                            "invalid_request"
+                        },
+                    );
+                }
+                if input.presentation_version == Some(2)
+                    || state().lock().unwrap().task_epoch.is_some()
+                {
+                    return self.companion.show_guidance(&session, &args, input).await;
+                }
+                match self.companion.show_sequence(&session, &args, input).await {
+                    Ok(()) => snapshot(&session, "completed"),
+                    Err(error) => ToolResult::error(error),
+                }
+            }
+            _ => ToolResult::error("Unknown companion operation."),
+        }
+    }
+}
+
+impl CursorCompanion {
+    async fn show_sequence(
+        &self,
+        session: &str,
+        args: &Value,
+        input: ShowCursorSequenceInput,
+    ) -> Result<(), String> {
+        let captures = &self.state.companion_captures;
+        let binding = captures
+            .binding_from_args(args)
+            .map_err(|_| "Capture session is unavailable.")?;
+        let capture_id = captures
+            .parse_capture_id(&input.capture_id)
+            .map_err(|_| "Invalid capture_id.")?;
+        let capture = captures
+            .read_for_presentation(capture_id, &binding, Duration::from_secs(5))
+            .map_err(|_| "Capture expired or does not belong to this session.")?;
+        if capture.target() != &CaptureTarget::PrimaryDesktop {
+            return Err(
+                "Use get_desktop_state first; window captures are unsupported for teaching V1."
+                    .into(),
+            );
+        }
+        let (width, height, scale) = main_screen_size().ok_or("No primary display.")?;
+        let dimensions = capture.encoded_dimensions();
+        let original = capture.presentation_dimensions();
+        if original.width() as i64 != width || original.height() as i64 != height {
+            return Err("Display dimensions changed; capture the desktop again.".into());
+        }
+
+        if ((dimensions.width() as f64 / dimensions.height() as f64)
+            - (width as f64 / height as f64))
+            .abs()
+            > 0.01
+        {
+            return Err("Display geometry changed; capture the desktop again.".into());
+        }
+        let paths: Vec<_> = input
+            .steps
+            .iter()
+            .map(|step| plan_path(step, width as f64, height as f64))
+            .collect();
+        let marks: Vec<_> = input
+            .steps
+            .iter()
+            .zip(&paths)
+            .map(|(step, path)| plan_mark(step, path))
+            .collect();
+        if paths
+            .iter()
+            .chain(&marks)
+            .flatten()
+            .any(|(x, y)| *x < 0.0 || *y < 0.0 || *x >= width as f64 || *y >= height as f64)
+        {
+            return Err("Teaching geometry extends outside the primary display.".into());
+        }
+        let generation = {
+            let mut state = state().lock().unwrap();
+            state.begin_sequence(session)?
+        };
+        let outcome = self
+            .play_sequence(session, &input.steps, &paths, &marks, generation, || {
+                if main_screen_size() != Some((width, height, scale)) {
+                    return false;
+                }
+                captures.read_for_perception(capture_id, &binding).is_ok()
+            })
+            .await;
+        {
+            let mut state = state().lock().unwrap();
+            // Superseded work must not clear a newer sequence's visual state.
+            if state.owner.as_deref() == Some(session) && state.generation == generation {
+                clear_marks(session);
+                state.active = false;
+                if !state.following {
+                    state.owner = None;
+                    hide_companion(session);
+                }
+            }
+        }
+        outcome
+    }
+
+    async fn play_sequence(
+        &self,
+        session: &str,
+        steps: &[CompanionStep],
+        paths: &[Vec<(f64, f64)>],
+        marks: &[Vec<(f64, f64)>],
+        generation: u64,
+        is_capture_current: impl Fn() -> bool + Send + Sync,
+    ) -> Result<(), String> {
+        let playback_started = Instant::now();
+        send(session, OverlayCommand::SetCompanionAppearance(true))?;
+        send(session, OverlayCommand::SetEnabled(true))?;
+        let initial_input = read_user_input_counters();
+        let initial_pointer = cua_driver_core::cursor_sampler::read_cursor_position();
+        for ((step, path), mark) in steps.iter().zip(paths).zip(marks) {
+            {
+                let state = state().lock().unwrap();
+                if state.generation != generation
+                    || !state.active
+                    || state.owner.as_deref() != Some(session)
+                {
+                    return Err("Teaching sequence canceled.".into());
+                }
+                send(session, OverlayCommand::ShowCompanionMark(mark.clone()))?;
+                send(
+                    session,
+                    OverlayCommand::SetPressed(matches!(step, CompanionStep::Drag { .. })),
+                )?;
+                if let CompanionStep::Click { .. } = step {
+                    if let Some(&(x, y)) = path.first() {
+                        let (anchor_x, anchor_y) =
+                            cursor_overlay::anchor_for_pointer(x, y, std::f64::consts::FRAC_PI_4);
+                        send(
+                            session,
+                            OverlayCommand::SnapTo {
+                                x: anchor_x,
+                                y: anchor_y,
+                                heading_radians: None,
+                            },
+                        )?;
+                        send(session, OverlayCommand::ClickPulse { x, y })?;
+                    }
+                }
+            }
+            let started = Instant::now();
+            let duration = Duration::from_millis(u64::from(step.duration_ms()));
+            let receipt = Arc::new(AtomicBool::new(false));
+            loop {
+                if !can_continue_playback(session) {
+                    return Err("Teaching session stopped.".into());
+                }
+                // Hold admission through command enqueue; cancellation cannot be
+                // followed by one stale frame from this generation.
+                {
+                    let state = state().lock().unwrap();
+                    if state.owner.as_deref() != Some(session)
+                        || state.generation != generation
+                        || !state.active
+                    {
+                        return Err("Teaching sequence canceled.".into());
+                    }
+                    if playback_started.elapsed() > Duration::from_secs(17) {
+                        return Err("Teaching playback deadline exceeded.".into());
+                    }
+                    if read_user_input_counters() != initial_input {
+                        return Err("Teaching sequence canceled by user input.".into());
+                    }
+                    if !is_capture_current() {
+                        return Err(
+                            "Teaching capture expired or display changed; observe again.".into(),
+                        );
+                    }
+                    if let (Some(start), Some(current)) = (
+                        initial_pointer,
+                        cua_driver_core::cursor_sampler::read_cursor_position(),
+                    ) {
+                        if (current.0 - start.0).hypot(current.1 - start.1) > 12.0 {
+                            return Err(
+                                "Teaching sequence canceled by user pointer movement.".into()
+                            );
+                        }
+                    }
+                    let progress =
+                        (started.elapsed().as_secs_f64() / duration.as_secs_f64()).min(1.0);
+                    let (x, y) = sample_path(path, progress);
+                    let (anchor_x, anchor_y) =
+                        cursor_overlay::anchor_for_pointer(x, y, std::f64::consts::FRAC_PI_4);
+                    send(
+                        session,
+                        OverlayCommand::SnapTo {
+                            x: anchor_x,
+                            y: anchor_y,
+                            heading_radians: None,
+                        },
+                    )?;
+                    if progress >= 1.0 {
+                        send(session, OverlayCommand::FrameReceipt(receipt.clone()))?;
+                        break;
+                    }
+                }
+                tokio::time::sleep(Duration::from_millis(16)).await;
+            }
+            let deadline = Instant::now() + Duration::from_secs(2);
+            while !receipt.load(Ordering::Acquire) {
+                if !can_continue_playback(session) {
+                    return Err("Teaching session stopped.".into());
+                }
+                {
+                    let state = state().lock().unwrap();
+                    if state.generation != generation || !state.active {
+                        return Err("Teaching sequence canceled.".into());
+                    }
+                }
+                if Instant::now() > deadline || playback_started.elapsed() > Duration::from_secs(17)
+                {
+                    return Err("Native overlay did not acknowledge a visible frame.".into());
+                }
+                tokio::time::sleep(Duration::from_millis(16)).await;
+            }
+        }
+        let state = state().lock().unwrap();
+        if state.generation != generation || !state.active {
+            return Err("Teaching sequence canceled.".into());
+        }
+        Ok(())
+    }
+}
+
+pub(super) fn register_tools(registry: &mut ToolRegistry, state: Arc<ToolState>) {
+    for name in [
+        "get_cursor_companion_capabilities",
+        "begin_cursor_guidance_task",
+        "end_cursor_guidance_task",
+        "show_cursor_sequence",
+        "set_cursor_companion_mode",
+        "cancel_cursor_sequence",
+        "get_cursor_companion_state",
+    ] {
+        let contract =
+            cua_driver_contract::tool_contract(name).expect("companion canonical contract");
+        registry.register(Box::new(CompanionTool {
+            companion: CursorCompanion {
+                state: state.clone(),
+            },
+            definition: ToolDef {
+                name: contract.name.clone(),
+                description: contract.description.clone(),
+                input_schema: contract.input_schema.clone(),
+                read_only: contract.annotations.read_only,
+                destructive: false,
+                idempotent: contract.annotations.idempotent,
+                open_world: false,
+            },
+        }));
+    }
+}
