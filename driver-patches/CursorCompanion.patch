+//! Bounded presentation-only teaching protocol. Coordinates are fractions of
+//! a fresh primary-desktop capture, never OS input coordinates.
+use crate::{Platform, SchemaMode, ToolAnnotations, ToolContract, ToolInput, ToolOutput};
+use schemars::JsonSchema;
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, JsonSchema, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct CompanionPoint {
+    pub x: f64,
+    pub y: f64,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(tag = "kind", rename_all = "snake_case", deny_unknown_fields)]
+pub enum CompanionStep {
+    Circle {
+        center: CompanionPoint,
+        radius: f64,
+        duration_ms: u32,
+        #[serde(default)]
+        hold_ms: Option<u32>,
+    },
+    Arrow {
+        from: CompanionPoint,
+        to: CompanionPoint,
+        duration_ms: u32,
+        #[serde(default)]
+        hold_ms: Option<u32>,
+    },
+    Move {
+        from: CompanionPoint,
+        to: CompanionPoint,
+        duration_ms: u32,
+        #[serde(default)]
+        hold_ms: Option<u32>,
+    },
+    Drag {
+        from: CompanionPoint,
+        to: CompanionPoint,
+        duration_ms: u32,
+        #[serde(default)]
+        hold_ms: Option<u32>,
+    },
+    Selection {
+        from: CompanionPoint,
+        to: CompanionPoint,
+        duration_ms: u32,
+        #[serde(default)]
+        hold_ms: Option<u32>,
+    },
+    Click {
+        at: CompanionPoint,
+        duration_ms: u32,
+        #[serde(default)]
+        hold_ms: Option<u32>,
+    },
+}
+
+impl CompanionStep {
+    pub fn duration_ms(&self) -> u32 {
+        match self {
+            Self::Circle { duration_ms, .. }
+            | Self::Arrow { duration_ms, .. }
+            | Self::Move { duration_ms, .. }
+            | Self::Drag { duration_ms, .. }
+            | Self::Selection { duration_ms, .. }
+            | Self::Click { duration_ms, .. } => *duration_ms,
+        }
+    }
+
+    pub fn hold_ms(&self) -> u32 {
+        match self {
+            Self::Circle { hold_ms, .. }
+            | Self::Arrow { hold_ms, .. }
+            | Self::Move { hold_ms, .. }
+            | Self::Drag { hold_ms, .. }
+            | Self::Selection { hold_ms, .. }
+            | Self::Click { hold_ms, .. } => hold_ms.unwrap_or(1100),
+        }
+    }
+
+    fn validate(&self) -> bool {
+        let valid = |p: &CompanionPoint| {
+            p.x.is_finite()
+                && p.y.is_finite()
+                && (0.0..=1.0).contains(&p.x)
+                && (0.0..=1.0).contains(&p.y)
+        };
+        match self {
+            Self::Circle { center, radius, .. } => {
+                valid(center) && radius.is_finite() && (0.005..=0.5).contains(radius)
+            }
+            Self::Click { at, .. } => valid(at),
+            Self::Arrow { from, to, .. }
+            | Self::Move { from, to, .. }
+            | Self::Drag { from, to, .. }
+            | Self::Selection { from, to, .. } => valid(from) && valid(to),
+        }
+    }
+}
+
+/// Host-derived normalized control bounds, never the full travel path.
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct TeachingTarget {
+    pub x: f64,
+    pub y: f64,
+    pub width: f64,
+    pub height: f64,
+}
+impl TeachingTarget {
+    pub fn validate(&self) -> bool {
+        [self.x, self.y, self.width, self.height]
+            .iter()
+            .all(|value| value.is_finite())
+            && self.x >= 0.0
+            && self.y >= 0.0
+            && self.width > 0.0
+            && self.height > 0.0
+            && self.x + self.width <= 1.0
+            && self.y + self.height <= 1.0
+    }
+}
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct ShowCursorSequenceInput {
+    pub session: Option<String>,
+    pub capture_id: String,
+    #[serde(default)]
+    pub targets: Vec<TeachingTarget>,
+    #[serde(default)]
+    pub hud_group: Option<String>,
+    #[serde(default)]
+    pub teaching_locale: Option<crate::CompanionHudLocale>,
+    #[serde(default)]
+    pub teaching_message: Option<crate::CompanionTeachingMessage>,
+    #[serde(default)]
+    pub presentation_id: Option<String>,
+    #[serde(default)]
+    pub text_only: bool,
+    #[serde(default)]
+    pub presentation_version: Option<u32>,
+    #[schemars(length(max = 8))]
+    pub steps: Vec<CompanionStep>,
+}
+impl ToolInput for ShowCursorSequenceInput {
+    const TOOL_NAME: &'static str = "show_cursor_sequence";
+    fn validate(&self) -> Result<(), String> {
+        if self
+            .presentation_version
+            .is_some_and(|version| version != 2)
+            || self
+                .teaching_message
+                .as_ref()
+                .is_some_and(|m| !m.validate())
+            || self.targets.len() > 8
+            || self.targets.iter().any(|target| !target.validate())
+            || self.presentation_id.as_ref().is_some_and(|id| {
+                id.len() != 36
+                    || self.teaching_message.is_none()
+                    || self.hud_group.is_none()
+                    || self.teaching_locale.is_none()
+            })
+            || self.capture_id.is_empty()
+            || (self.steps.is_empty() && !(self.text_only && self.presentation_id.is_some()))
+            || (self.text_only && !self.steps.is_empty())
+            || self.steps.len() > 8
+            || self.steps.iter().any(|s| {
+                !s.validate()
+                    || !(200..=5000).contains(&s.duration_ms())
+                    || (self.presentation_version == Some(2)
+                        && !(500..=2000).contains(&s.hold_ms()))
+            })
+            || self
+                .steps
+                .iter()
+                .map(|s| u64::from(s.duration_ms()))
+                .sum::<u64>()
+                > 15000
+        {
+            return Err("Use 1..8 bounded steps, each 200..5000ms, total <=15000ms, and normalized finite coordinates.".into());
+        }
+        Ok(())
+    }
+}
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, JsonSchema)]
+#[serde(rename_all = "snake_case")]
+pub enum CompanionMode {
