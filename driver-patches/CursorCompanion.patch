+//! Host-bound version 3 scribble teaching. No desktop input executor dependency.
+use super::*;
+use cua_driver_contract::{
+    BeginCursorGuidanceTaskInput, EndCursorGuidanceTaskInput, GetCursorCompanionCapabilitiesInput,
+};
+use cua_driver_contract::{PresentedStroke, TeachingGuidanceTimings};
+use cua_driver_core::capture_runtime::CaptureTarget;
