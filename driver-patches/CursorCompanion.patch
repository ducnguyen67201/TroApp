@@ -0,0 +1,88 @@
+//! Pure teaching geometry. No input, platform, or transport dependencies.
+use cua_driver_contract::{CompanionPoint, CompanionStep};
+
+pub fn plan_path(step: &CompanionStep, width: f64, height: f64) -> Vec<(f64, f64)> {
+    let point = |p: &CompanionPoint| (p.x * width, p.y * height);
+    match step {
+        CompanionStep::Circle { center, radius, .. } => {
+            let (x, y) = point(center);
+            let r = radius * width.min(height);
+            (0..=64)
+                .map(|index| {
+                    let angle = index as f64 / 64.0 * std::f64::consts::TAU;
+                    (x + r * angle.cos(), y + r * angle.sin())
+                })
+                .collect()
+        }
+        CompanionStep::Click { at, .. } => vec![point(at)],
+        CompanionStep::Selection { from, to, .. } => {
+            let (x, y) = point(from);
+            let (end_x, end_y) = point(to);
+            vec![(x, y), (end_x, y), (end_x, end_y), (x, end_y), (x, y)]
+        }
+        CompanionStep::Arrow { from, to, .. }
+        | CompanionStep::Move { from, to, .. }
+        | CompanionStep::Drag { from, to, .. } => vec![point(from), point(to)],
+    }
+}
+
+pub fn sample_path(path: &[(f64, f64)], progress: f64) -> (f64, f64) {
+    let distance = progress.clamp(0.0, 1.0) * path.len().saturating_sub(1) as f64;
+    let index = distance.floor() as usize;
+    let start = path.get(index).copied().unwrap_or((0.0, 0.0));
+    let end = path.get(index + 1).copied().unwrap_or(start);
+    let amount = distance - index as f64;
+    (
+        start.0 + (end.0 - start.0) * amount,
+        start.1 + (end.1 - start.1) * amount,
+    )
+}
+
+pub fn plan_mark(step: &CompanionStep, path: &[(f64, f64)]) -> Vec<(f64, f64)> {
+    match step {
+        CompanionStep::Move { .. } | CompanionStep::Click { .. } => vec![],
+        CompanionStep::Arrow { .. } => {
+            let mut mark = path.to_vec();
+            if let [from, to] = path {
+                let angle = (to.1 - from.1).atan2(to.0 - from.0);
+                for offset in [-0.55, 0.55] {
+                    mark.push((
+                        to.0 - 16.0 * (angle + offset).cos(),
+                        to.1 - 16.0 * (angle + offset).sin(),
+                    ));
+                    mark.push(*to);
+                }
+            }
+            mark
+        }
+        _ => path.to_vec(),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn circle_closes_and_arrow_points_to_destination() {
+        let center = CompanionPoint { x: 0.5, y: 0.5 };
+        let circle = CompanionStep::Circle {
+            center,
+            radius: 0.1,
+            duration_ms: 1000,
+            hold_ms: None,
+        };
+        let path = plan_path(&circle, 1000.0, 500.0);
+        assert_eq!(path.len(), 65);
+        assert!((path[0].0 - 550.0).abs() < 0.01);
+        assert!((path[0].1 - path[64].1).abs() < 0.01);
+        let arrow = CompanionStep::Arrow {
+            from: center,
+            to: CompanionPoint { x: 0.8, y: 0.8 },
+            duration_ms: 1000,
+            hold_ms: None,
+        };
+        let path = plan_path(&arrow, 1000.0, 500.0);
+        assert_eq!(sample_path(&path, 1.0), (800.0, 400.0));
+        assert_eq!(plan_mark(&arrow, &path).last(), Some(&(800.0, 400.0)));
+    }
+}
