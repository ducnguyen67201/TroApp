+/// Wait for CALayer installation of the message before beginning a pointer cue.
+/// This bounds a stalled compositor and does not claim physical scan-out timing.
+pub async fn present_companion_message(
+    session: &str,
+    group: &str,
+    locale: cua_driver_contract::CompanionHudLocale,
+    message: cua_driver_contract::CompanionTeachingMessage,
+) -> bool {
+    let rendered = std::sync::Arc::new(AtomicBool::new(false));
+    {
+        let mut hud = super::companion_hud::state().lock().unwrap();
+        if !hud.present_message(session, group, locale, message.clone()) {
+            return false;
+        }
+        hud.message_frame = Some(super::companion_hud::MessageFrame {
+            message,
+            rendered: rendered.clone(),
+        });
+    }
+    send_command_default(OverlayCommand::WakeCompanionHud);
+    let deadline = Instant::now() + Duration::from_millis(1000);
+    while Instant::now() < deadline {
+        if rendered.load(Ordering::Acquire) {
+            return true;
+        }
+        tokio::time::sleep(Duration::from_millis(10)).await;
+    }
+    false
+}
