index 0000000..c04854c
--- /dev/null
+++ b/libs/cua-driver/rust/crates/cua-driver-contract/src/companion.rs
@@ -0,0 +1,330 @@
+//! Bounded presentation-only teaching protocol. Coordinates are fractions of
+//! a fresh primary-desktop capture, never OS input coordinates.
+use crate::{Platform, SchemaMode, ToolAnnotations, ToolContract, ToolInput, ToolOutput};
+use schemars::JsonSchema;
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, JsonSchema, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct CompanionPoint {
+    pub x: f64,
+    pub y: f64,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(tag = "kind", rename_all = "snake_case", deny_unknown_fields)]
+pub enum CompanionStep {
+    Circle {
+        center: CompanionPoint,
+        radius: f64,
+        duration_ms: u32,
+        #[serde(default)]
+        hold_ms: Option<u32>,
+    },
+    Arrow {
+        from: CompanionPoint,
+        to: CompanionPoint,
+        duration_ms: u32,
+        #[serde(default)]
+        hold_ms: Option<u32>,
+    },
+    Move {
+        from: CompanionPoint,
+        to: CompanionPoint,
+        duration_ms: u32,
+        #[serde(default)]
+        hold_ms: Option<u32>,
+    },
+    Drag {
+        from: CompanionPoint,
+        to: CompanionPoint,
+        duration_ms: u32,
+        #[serde(default)]
+        hold_ms: Option<u32>,
+    },
+    Selection {
+        from: CompanionPoint,
+        to: CompanionPoint,
+        duration_ms: u32,
+        #[serde(default)]
+        hold_ms: Option<u32>,
+    },
+    Click {
+        at: CompanionPoint,
+        duration_ms: u32,
+        #[serde(default)]
+        hold_ms: Option<u32>,
+    },
+}
+
+impl CompanionStep {
+    pub fn duration_ms(&self) -> u32 {
+        match self {
+            Self::Circle { duration_ms, .. }
+            | Self::Arrow { duration_ms, .. }
+            | Self::Move { duration_ms, .. }
+            | Self::Drag { duration_ms, .. }
+            | Self::Selection { duration_ms, .. }
+            | Self::Click { duration_ms, .. } => *duration_ms,
+        }
+    }
+
+    pub fn hold_ms(&self) -> u32 {
+        match self {
+            Self::Circle { hold_ms, .. }
+            | Self::Arrow { hold_ms, .. }
+            | Self::Move { hold_ms, .. }
+            | Self::Drag { hold_ms, .. }
+            | Self::Selection { hold_ms, .. }
+            | Self::Click { hold_ms, .. } => hold_ms.unwrap_or(1100),
+        }
+    }
+
+    fn validate(&self) -> bool {
+        let valid = |p: &CompanionPoint| {
+            p.x.is_finite()
+                && p.y.is_finite()
+                && (0.0..=1.0).contains(&p.x)
+                && (0.0..=1.0).contains(&p.y)
+        };
+        match self {
+            Self::Circle { center, radius, .. } => {
+                valid(center) && radius.is_finite() && (0.005..=0.5).contains(radius)
+            }
+            Self::Click { at, .. } => valid(at),
+            Self::Arrow { from, to, .. }
+            | Self::Move { from, to, .. }
+            | Self::Drag { from, to, .. }
+            | Self::Selection { from, to, .. } => valid(from) && valid(to),
+        }
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct ShowCursorSequenceInput {
+    pub session: Option<String>,
+    pub capture_id: String,
+    #[serde(default)]
+    pub presentation_version: Option<u32>,
+    #[schemars(length(min = 1, max = 8))]
+    pub steps: Vec<CompanionStep>,
+}
+impl ToolInput for ShowCursorSequenceInput {
+    const TOOL_NAME: &'static str = "show_cursor_sequence";
+    fn validate(&self) -> Result<(), String> {
+        if self
+            .presentation_version
+            .is_some_and(|version| version != 2)
+            || self.capture_id.is_empty()
+            || self.steps.is_empty()
+            || self.steps.len() > 8
+            || self.steps.iter().any(|s| {
+                !s.validate()
+                    || !(200..=5000).contains(&s.duration_ms())
+                    || (self.presentation_version == Some(2)
+                        && !(500..=2000).contains(&s.hold_ms()))
+            })
+            || self
+                .steps
+                .iter()
+                .map(|s| u64::from(s.duration_ms()))
+                .sum::<u64>()
+                > 15000
+        {
+            return Err("Use 1..8 bounded steps, each 200..5000ms, total <=15000ms, and normalized finite coordinates.".into());
+        }
+        Ok(())
+    }
+}
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, JsonSchema)]
+#[serde(rename_all = "snake_case")]
+pub enum CompanionMode {
+    Follow,
+    Hidden,
+}
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct SetCursorCompanionModeInput {
+    pub session: Option<String>,
+    pub mode: CompanionMode,
+    #[schemars(length(max = 24))]
+    pub label: Option<String>,
+}
+impl ToolInput for SetCursorCompanionModeInput {
+    const TOOL_NAME: &'static str = "set_cursor_companion_mode";
+    fn validate(&self) -> Result<(), String> {
+        if self
+            .label
+            .as_ref()
+            .is_some_and(|label| label.chars().count() > 24 || label.chars().any(char::is_control))
+        {
+            return Err(
+                "Companion label must be at most 24 characters without control characters.".into(),
+            );
+        }
+        Ok(())
+    }
+}
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct CancelCursorSequenceInput {
+    pub session: Option<String>,
+}
+impl ToolInput for CancelCursorSequenceInput {
+    const TOOL_NAME: &'static str = "cancel_cursor_sequence";
+}
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct GetCursorCompanionStateInput {
+    pub session: Option<String>,
+}
+impl ToolInput for GetCursorCompanionStateInput {
+    const TOOL_NAME: &'static str = "get_cursor_companion_state";
+}
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct CursorCompanionOutput {
+    pub status: String,
+    pub following: bool,
+    pub active: bool,
+}
+impl ToolOutput for CursorCompanionOutput {}
+
+pub fn contracts() -> Vec<ToolContract> {
+    vec![
+        contract_output::<ShowCursorSequenceInput, CursorSequenceOutput>("Animate an ordered teaching preview on a fresh primary desktop capture. Circle radius is a fraction of the shorter display edge; points are normalized capture coordinates. Never clicks, drags, types or changes OS focus. V2 moves to each cue, traces it, holds it, clears it and returns to follow. V2 requires a host-bound task. Clicking, typing or scrolling cancels the whole task; passive pointer motion is allowed. Omitted version is explicit legacy V1 with pointer-motion cancellation. At most eight steps and fifteen seconds.", false),
+        contract_output::<GetCursorCompanionCapabilitiesInput, CursorCompanionCapabilities>("Read supported guidance versions and bounded native capabilities.", true),
+        contract_output::<BeginCursorGuidanceTaskInput, CursorGuidanceTaskOutput>("Host-only admission of a V2 teaching task. Renewing following never resets a canceled task.", false),
+        contract_output::<EndCursorGuidanceTaskInput, CursorGuidanceTaskOutput>("Host-only release of a guidance task and clear its presentation.", false),
+        contract::<SetCursorCompanionModeInput>("Follow the real pointer with a companion, or hide it. One desktop owner, renewable 60-second lease. macOS primary display only.", false),
+        contract::<CancelCursorSequenceInput>("Cancel the current teaching sequence and clear marks; restore pointer following if enabled.", false),
+        contract::<GetCursorCompanionStateInput>("Read presentation state for the current session. This is not evidence of a desktop action.", true),
+    ]
+}
+fn contract<I: ToolInput>(description: &str, read_only: bool) -> ToolContract {
+    contract_output::<I, CursorCompanionOutput>(description, read_only)
+}
+fn contract_output<I: ToolInput, O: ToolOutput>(
+    description: &str,
+    read_only: bool,
+) -> ToolContract {
+    ToolContract {
+        name: I::TOOL_NAME.into(),
+        description: description.into(),
+        platforms: vec![Platform::Macos],
+        aliases: vec![],
+        capabilities: vec!["agent_cursor.teaching".into()],
+        annotations: ToolAnnotations {
+            read_only,
+            destructive: false,
+            idempotent: I::TOOL_NAME != "show_cursor_sequence",
+            open_world: false,
+        },
+        schema_mode: SchemaMode::CanonicalRuntime,
+        cursor_semantics: None,
+        input_schema: I::input_schema(),
+        success_output_schema: Some(O::output_schema()),
+        error_output_schema: None,
+        output_validator: crate::validate_typed_output::<O>,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn refuses_unbounded_or_nonfinite_sequences() {
+        let step = CompanionStep::Click {
+            at: CompanionPoint { x: 0.5, y: 0.5 },
+            duration_ms: 5000,
+            hold_ms: None,
+        };
+        let mut input = ShowCursorSequenceInput {
+            session: None,
+            capture_id: "capture".into(),
+            presentation_version: None,
+            steps: vec![step; 4],
+        };
+        assert!(input.validate().is_err());
+        input.steps.truncate(3);
+        assert!(input.validate().is_ok());
+        input.steps = vec![CompanionStep::Click {
+            at: CompanionPoint {
+                x: f64::NAN,
+                y: 0.5,
+            },
+            duration_ms: 1000,
+            hold_ms: None,
+        }];
+        assert!(input.validate().is_err());
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct GetCursorCompanionCapabilitiesInput {
+    pub session: Option<String>,
+}
+impl ToolInput for GetCursorCompanionCapabilitiesInput {
+    const TOOL_NAME: &'static str = "get_cursor_companion_capabilities";
+}
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct BeginCursorGuidanceTaskInput {
+    pub session: Option<String>,
+    pub task_epoch: String,
+    pub presentation_version: u32,
+}
+impl ToolInput for BeginCursorGuidanceTaskInput {
+    const TOOL_NAME: &'static str = "begin_cursor_guidance_task";
+}
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct EndCursorGuidanceTaskInput {
+    pub session: Option<String>,
+    pub task_epoch: String,
+}
+impl ToolInput for EndCursorGuidanceTaskInput {
+    const TOOL_NAME: &'static str = "end_cursor_guidance_task";
+}
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct CursorGuidanceTaskOutput {
+    pub status: String,
+    pub task_epoch: String,
+    pub following: bool,
+    pub active: bool,
+}
+impl ToolOutput for CursorGuidanceTaskOutput {}
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct CursorCompanionCapabilities {
+    pub presentation_versions: Vec<u32>,
+    pub task_lifecycle: bool,
+    pub display_scope: String,
+    pub gestures: Vec<String>,
+    pub max_steps: u32,
+    pub max_duration_ms: u32,
+}
+impl ToolOutput for CursorCompanionCapabilities {}
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct CursorGuidanceReceipt {
+    pub presentation_version: u32,
+    pub task_epoch: String,
+    pub sequence_id: String,
+    pub completed_steps: u32,
+}
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(untagged)]
+pub enum CursorSequenceOutput {
+    V2 {
+        status: String,
+        following: bool,
+        active: bool,
+        receipt: CursorGuidanceReceipt,
+    },
+    Legacy(CursorCompanionOutput),
+}
+impl ToolOutput for CursorSequenceOutput {}
