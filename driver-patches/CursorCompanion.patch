+//! Tro's teaching pointer. Coordinates and sizes are logical display points;
+//! the hotspot stays at the pointer tip at every backing scale.
+use tiny_skia::{
+    Color, FillRule, GradientStop, Paint, PathBuilder, Pixmap, Point, RadialGradient, SpreadMode,
