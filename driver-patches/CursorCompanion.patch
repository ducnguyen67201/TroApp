+#[link(name = "CoreMedia", kind = "framework")]
+extern "C" {
+    fn CMSampleBufferGetSampleAttachmentsArray(
+        sample: *mut std::ffi::c_void,
+        create_if_necessary: u8,
+    ) -> CFArrayRef;
+}
+#[link(name = "ScreenCaptureKit", kind = "framework")]
+extern "C" {
+    static SCStreamFrameInfoStatus: CFStringRef;
+}
+
+/// Decode Apple's numeric attachment, not a Swift enum object. The pinned
+/// screencapturekit 8.0.1 bridge casts NSNumber directly to SCFrameStatus and
+/// returns None for valid complete frames. Keep this adapter local to Tro;
+/// never accept unknown/absent statuses as a complete screen frame.
+fn read_frame_status_attachment(attachments: CFDictionaryRef) -> Option<SCFrameStatus> {
+    // All values are borrowed from a live sample (or an owned test dictionary).
+    // Validate CF types before retaining a numeric value; no attachment contents
+    // are persisted or logged.
+    unsafe {
+        if attachments.is_null() || CFGetTypeID(attachments.cast()) != CFDictionaryGetTypeID() {
+            return None;
+        }
+        let value = CFDictionaryGetValue(attachments, SCStreamFrameInfoStatus.cast());
+        if value.is_null() || CFGetTypeID(value) != CFNumberGetTypeID() {
+            return None;
+        }
+        let number = CFNumber::wrap_under_get_rule(value.cast());
+        let status = i32::try_from(number.to_i64()?).ok()?;
+        SCFrameStatus::from_raw(status)
+    }
+}
+fn read_screen_frame_status(
+    sample: &screencapturekit::cm::CMSampleBuffer,
+) -> Option<SCFrameStatus> {
+    // CoreMedia owns this immutable array for the retained sample's lifetime.
+    // We request no allocation and consume the borrowed first attachment only.
+    unsafe {
+        let attachments = CMSampleBufferGetSampleAttachmentsArray(sample.as_ptr(), 0);
+        if attachments.is_null() || CFArrayGetCount(attachments) == 0 {
+            return None;
+        }
+        read_frame_status_attachment(CFArrayGetValueAtIndex(attachments, 0).cast())
+    }
+}
+
+fn hash_tiles(bytes: &[u8], width: usize, height: usize, stride: usize) -> Vec<u64> {
+    if width == 0 || height == 0 || stride < width * 4 || bytes.len() < stride * height {
+        return vec![];
+    }
+    let columns = width.div_ceil(TILE);
+    let mut hashes = vec![14695981039346656037u64; columns * height.div_ceil(TILE)];
+    for y in 0..height {
+        for x in 0..width {
+            let cell = (y / TILE) * columns + x / TILE;
+            let offset = y * stride + x * 4;
+            for channel in 0..3 {
+                // Quantization suppresses minor compositor/color noise.
+                hashes[cell] = (hashes[cell] ^ u64::from(bytes[offset + channel] >> 4))
+                    .wrapping_mul(1099511628211);
+            }
+        }
+    }
+    hashes
+}
+fn record_frame(changes: &mut Changes, hashes: Vec<u64>) {
+    if hashes.is_empty() {
+        changes.failed = true;
+        return;
+    }
+    let different = if changes.hashes.len() == hashes.len() {
+        changes
+            .hashes
+            .iter()
+            .zip(&hashes)
+            .filter(|(a, b)| a != b)
+            .count()
+    } else {
+        hashes.len()
+    };
+    let rows = hashes.len().div_ceil(changes.columns.max(1));
+    let relevant_changed = !changes.regions.is_empty()
+        && changes
+            .hashes
+            .iter()
+            .zip(&hashes)
+            .enumerate()
+            .any(|(index, (before, after))| {
+                if before == after {
+                    return false;
+                }
+                let x = (index % changes.columns.max(1)) as f64 / changes.columns.max(1) as f64;
+                let y = (index / changes.columns.max(1)) as f64 / rows.max(1) as f64;
+                changes.regions.iter().any(|region| {
+                    x < region.x + region.width
+                        && x + 1.0 / changes.columns.max(1) as f64 > region.x
+                        && y < region.y + region.height
+                        && y + 1.0 / rows.max(1) as f64 > region.y
+                })
+            });
+    if relevant_changed {
+        changes.relevant_revision += 1;
+    }
+    // A blinking caret is commonly one tile. Input still forces observation of
+    // small edits; ignored deltas accumulate against this retained baseline.
+    if !changes.ready || different > 1 || relevant_changed {
+        changes.fraction = different as f64 / hashes.len() as f64;
+        changes.hashes = hashes;
+        changes.revision += 1;
+    }
+    changes.ready = true;
+}
+fn begin_stream(
+    id: String,
+    changes: Arc<Mutex<Changes>>,
+    width: usize,
+    height: usize,
+) -> Result<(), String> {
+    let content = SCShareableContent::get().map_err(|_| "capture_unavailable")?;
+    let main_id = unsafe { core_graphics::display::CGMainDisplayID() };
+    let display = content
+        .displays()
+        .into_iter()
+        .find(|d| d.display_id() == main_id)
+        .ok_or("capture_unavailable")?;
+    let applications = content.applications();
+    let excluded: Vec<_> = applications
+        .iter()
+        .filter(|a| a.process_id() == std::process::id() as i32)
+        .collect();
+    let windows = content.windows();
+    let excluded_windows: Vec<_> = windows
+        .iter()
+        .filter(|window| {
+            window
+                .owning_application()
+                .is_some_and(|app| app.process_id() == std::process::id() as i32)
+        })
+        .collect();
+    let mut filter = if excluded.is_empty() {
+        SCContentFilter::create()
+            .with_display(&display)
+            .with_excluding_windows(&excluded_windows)
+            .build()
+    } else {
+        SCContentFilter::create()
+            .with_display(&display)
+            .with_excluding_applications(&excluded, &[])
+            .build()
+    };
+    filter.set_include_menu_bar(true);
+    let output_width = width.min(MAX_WIDTH);
+    let output_height = (height * output_width / width).max(1);
+    let mut config = SCStreamConfiguration::new()
+        .with_width(output_width as u32)
+        .with_height(output_height as u32)
+        .with_shows_cursor(false)
+        .with_queue_depth(3)
+        .with_minimum_frame_interval(&CMTime::new(1, 2));
+    let mut stream = SCStream::new(&filter, &config);
+    let frames = changes.clone();
+    let handler = stream.add_output_handler(
+        move |sample: screencapturekit::cm::CMSampleBuffer, _| {
+            if read_screen_frame_status(&sample) != Some(SCFrameStatus::Complete) {
+                return;
+            }
+            let Some(buffer) = sample.image_buffer() else {
+                return;
+            };
+            let Ok(guard) = buffer.lock_read_only() else {
+                return;
+            };
+            let hashes = hash_tiles(
+                guard.as_slice(),
+                guard.width(),
+                guard.height(),
+                guard.bytes_per_row(),
+            );
+            let mut changes = frames.lock().unwrap();
+            changes.columns = guard.width().div_ceil(TILE);
+            record_frame(&mut changes, hashes);
+        },
+        SCStreamOutputType::Screen,
+    );
+    if handler.is_none() {
+        tracing::error!(target: "desktop_observation", stage = "register_output",
+            "Native observer could not register its screen output handler");
+        return Err("capture_unavailable".into());
+    }
+    stream.start_capture().map_err(|_| "capture_unavailable")?;
+    std::thread::spawn(move || {
+        let mut quiet_mode = false;
+        loop {
+            let owned = watches()
+                .lock()
+                .unwrap()
+                .as_ref()
+                .is_some_and(|watch| owns_stream(watch, &id, &changes));
+            let (expired, quiet) = {
+                let mut changes = changes.lock().unwrap();
+                update_input(&mut changes);
+                (
+                    changes.failed || Instant::now() > changes.lease_until,
+                    changes.input_at.elapsed() > Duration::from_secs(3),
+                )
+            };
+            if !owned || expired {
+                break;
+            }
+            let Some((current_width, current_height)) = read_primary_dimensions() else {
+                break;
+            };
+            let resize = {
+                let mut watches = watches().lock().unwrap();
+                if let Some(watch) = watches
+                    .as_mut()
+                    .filter(|watch| owns_stream(watch, &id, &changes))
+                {
+                    if (watch.width, watch.height) != (current_width, current_height) {
+                        watch.width = current_width;
+                        watch.height = current_height;
+                        let mut changes = changes.lock().unwrap();
+                        changes.hashes.clear();
+                        changes.ready = false;
+                        changes.revision += 1;
+                        true
+                    } else {
+                        false
+                    }
+                } else {
+                    false
+                }
+            };
+            if resize {
+                let output_width = current_width.min(MAX_WIDTH);
+                config.set_width(output_width as u32);
+                config.set_height((current_height * output_width / current_width).max(1) as u32);
+                if stream.update_configuration(&config).is_err() {
+                    break;
+                }
+            }
+            if quiet != quiet_mode {
+                config.set_minimum_frame_interval(&CMTime::new(
+                    if quiet { 2 } else { 1 },
+                    if quiet { 1 } else { 2 },
+                ));
+                if stream.update_configuration(&config).is_err() {
+                    changes.lock().unwrap().failed = true;
+                    break;
+                }
+                quiet_mode = quiet;
+            }
+            std::thread::sleep(Duration::from_millis(100));
+        }
+        let _ = stream.stop_capture();
+        let mut watches = watches().lock().unwrap();
+        if watches
+            .as_ref()
+            .is_some_and(|watch| owns_stream(watch, &id, &changes))
+        {
+            *watches = None;
+        }
+    });
+    Ok(())
+}
+
+struct ObservationTool {
+    definition: ToolDef,
+}
+#[async_trait]
+impl Tool for ObservationTool {
+    fn def(&self) -> &ToolDef {
+        &self.definition
+    }
+    async fn invoke(&self, args: Value) -> ToolResult {
+        let owner = resolve_cursor_key(&args);
+        // Resolve ownership before the standard parser removes trusted transport
+        // fields. Public unknown fields remain rejected by WatchInput.
+        let input: WatchInput = match parse_typed_input(&self.definition.name, args) {
+            Ok(input) => input,
+            Err(error) => return error,
+        };
+        let _ = &input.session;
+        if input
+            .regions
+            .as_ref()
+            .is_some_and(|regions| regions.len() > 8 || regions.iter().any(|r| !r.valid()))
+        {
+            return ToolResult::error("invalid_watch");
+        }
+        if uuid::Uuid::parse_str(&input.watch_id).is_err() {
+            return ToolResult::error("invalid_watch");
+        }
+        if self.definition.name == "end_desktop_watch" {
+            let mut watches = watches().lock().unwrap();
+            if watches
+                .as_ref()
+                .is_some_and(|w| w.id == input.watch_id && w.owner == owner)
+            {
+                *watches = None;
+            }
+            return ToolResult::text("watch_ended");
+        }
+        if self.definition.name == "begin_desktop_watch" {
+            let Some((width, height)) = read_primary_dimensions() else {
+                return ToolResult::error("capture_unavailable");
+            };
+            let changes = Arc::new(Mutex::new(Changes {
+                input_only: input.input_only,
+                hashes: vec![],
+                regions: vec![],
+                relevant_revision: 0,
+                columns: 24,
+                revision: 0,
+                fraction: 0.0,
+                ready: input.input_only,
+                failed: false,
+                lease_until: Instant::now() + LEASE,
+                last_input: input_revision(),
+                input_at: Instant::now(),
+            }));
+            {
+                let mut watches = watches().lock().unwrap();
+                if watches.is_some() {
+                    return ToolResult::error("busy");
+                }
+                *watches = Some(Watch {
+                    id: input.watch_id.clone(),
+                    owner: owner.clone(),
+                    width,
+                    height,
+                    changes: changes.clone(),
+                });
+            }
+            if !input.input_only {
+                let id = input.watch_id.clone();
+                let start =
+                    tokio::task::spawn_blocking(move || begin_stream(id, changes, width, height))
+                        .await;
+                if !matches!(start, Ok(Ok(()))) {
+                    retire_session(&owner);
+                    return ToolResult::error("capture_unavailable");
+                }
+            }
+        }
+        let watches = watches().lock().unwrap();
+        let Some(watch) = watches
+            .as_ref()
+            .filter(|w| w.id == input.watch_id && w.owner == owner)
+        else {
+            return ToolResult::error("watch_lost");
+        };
+        {
+            let mut changes = watch.changes.lock().unwrap();
+            changes.lease_until = Instant::now() + LEASE;
+            if let Some(regions) = input.regions {
+                changes.regions = regions;
+            }
+        }
+        ToolResult::text("desktop_watch").with_structured(describe(watch))
+    }
+}
+pub(super) fn register_tools(registry: &mut ToolRegistry) {
+    for name in [
+        "begin_desktop_watch",
+        "read_desktop_watch",
+        "end_desktop_watch",
+    ] {
+        registry.register(Box::new(ObservationTool { definition: ToolDef {
+            name: name.into(), description: "Host-only bounded native desktop change observation.".into(),
+            input_schema: json!({"type":"object","properties":{"watch_id":{"type":"string"},"input_only":{"type":"boolean"},"session":{"type":"string"},"regions":{"type":"array","maxItems":8,"items":{"type":"object","properties":{"x":{"type":"number"},"y":{"type":"number"},"width":{"type":"number"},"height":{"type":"number"}},"required":["x","y","width","height"],"additionalProperties":false}}},"required":["watch_id"],"additionalProperties":false}),
+            read_only: name == "read_desktop_watch", destructive: false, idempotent: name != "begin_desktop_watch", open_world: false,
+        }}));
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn companion_observation_reads_numeric_frame_status_and_rejects_invalid_attachments() {
+        use core_foundation::{dictionary::CFDictionary, string::CFString};
+        let key = unsafe { CFString::wrap_under_get_rule(SCStreamFrameInfoStatus) };
+        for raw_status in 0..=5 {
+            let number = CFNumber::from(i64::from(raw_status));
+            let dictionary =
+                CFDictionary::from_CFType_pairs(&[(key.as_CFType(), number.as_CFType())]);
+            assert_eq!(
+                read_frame_status_attachment(dictionary.as_concrete_TypeRef()),
+                SCFrameStatus::from_raw(raw_status)
+            );
+        }
+        for raw_status in [-1, 6, i64::MAX] {
+            let number = CFNumber::from(raw_status);
+            let dictionary =
+                CFDictionary::from_CFType_pairs(&[(key.as_CFType(), number.as_CFType())]);
+            assert_eq!(
+                read_frame_status_attachment(dictionary.as_concrete_TypeRef()),
+                None
+            );
+        }
+        let text = CFString::new("untrusted attachment");
+        let dictionary = CFDictionary::from_CFType_pairs(&[(key.as_CFType(), text.as_CFType())]);
+        assert_eq!(
+            read_frame_status_attachment(dictionary.as_concrete_TypeRef()),
+            None
+        );
+        let empty: CFDictionary<core_foundation::base::CFType, core_foundation::base::CFType> =
+            CFDictionary::from_CFType_pairs(&[]);
+        assert_eq!(
+            read_frame_status_attachment(empty.as_concrete_TypeRef()),
+            None
+        );
+        assert_eq!(read_frame_status_attachment(std::ptr::null()), None);
+        // A non-dictionary CF object must never be passed to CFDictionaryGetValue.
+        assert_eq!(
+            read_frame_status_attachment(text.as_CFTypeRef().cast()),
+            None
+        );
+    }
+
