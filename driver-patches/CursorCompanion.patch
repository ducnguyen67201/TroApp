+//! One bounded path compiler. Converted geometry is reused for comparison,
+//! progressive paint and compositor diagnostics; no platform I/O or input.
+use crate::guidance::{approach_duration, FADE_MS, RETURN_MS};
+use cua_driver_contract::{
+    TeachingDrawing, TeachingStroke, SCRIBBLE_MIN_HOLD_MS, SCRIBBLE_STROKE_WIDTH_POINTS,
+};
+
+pub const QUADRATIC_SAMPLES: usize = 12;
+const PEN_SPEED_POINTS_PER_SECOND: f64 = 700.0;
+const MIN_TRACE_MS: u64 = 350;
+const MAX_TRACE_MS: u64 = 1200;
+pub struct CompiledStroke {
+    pub path: Vec<(f64, f64)>,
+    pub bounds: [f64; 4],
+    pub approach_ms: u64,
+    pub trace_ms: u64,
+    pub hold_ms: u64,
+}
+pub struct ScribblePlan {
+    pub strokes: Vec<CompiledStroke>,
+    pub duration_ms: u64,
+}
+fn midpoint(a: (f64, f64), b: (f64, f64)) -> (f64, f64) {
+    ((a.0 + b.0) * 0.5, (a.1 + b.1) * 0.5)
+}
+fn append_quadratic(path: &mut Vec<(f64, f64)>, control: (f64, f64), end: (f64, f64)) {
+    let start = *path.last().unwrap();
+    for index in 1..=QUADRATIC_SAMPLES {
+        let t = index as f64 / QUADRATIC_SAMPLES as f64;
+        let inverse = 1.0 - t;
+        path.push((
+            inverse * inverse * start.0 + 2.0 * inverse * t * control.0 + t * t * end.0,
+            inverse * inverse * start.1 + 2.0 * inverse * t * control.1 + t * t * end.1,
+        ));
+    }
+}
+/// Endpoint values map to the valid last logical display edge, not outside it.
+fn compile_stroke(
+    stroke: &TeachingStroke,
+    width: f64,
+    height: f64,
+) -> Result<Vec<(f64, f64)>, &'static str> {
+    if !stroke.validate() {
+        return Err("invalid_request");
+    }
+    let mut points: Vec<_> = stroke
+        .points
+        .iter()
+        .map(|point| {
+            (
+                (point.x * width).min(width - 0.001),
+                (point.y * height).min(height - 0.001),
+            )
+        })
+        .collect();
+    points.dedup();
+    if stroke.closed && points.first() == points.last() {
+        points.pop();
+    }
+    let mut path = if stroke.closed {
+        vec![midpoint(
+            *points.last().ok_or("invalid_request")?,
+            points[0],
+        )]
+    } else {
+        vec![points[0]]
+    };
+    if stroke.closed {
+        for index in 0..points.len() {
+            append_quadratic(
+                &mut path,
+                points[index],
+                midpoint(points[index], points[(index + 1) % points.len()]),
+            );
+        }
+    } else if points.len() == 2 {
+        path.push(points[1]);
+    } else {
+        for index in 1..points.len() - 1 {
+            append_quadratic(
+                &mut path,
+                points[index],
+                midpoint(points[index], points[index + 1]),
+            );
+        }
+        append_quadratic(&mut path, points[points.len() - 2], *points.last().unwrap());
+    }
+    if path
+        .windows(2)
+        .map(|p| (p[1].0 - p[0].0).hypot(p[1].1 - p[0].1))
+        .sum::<f64>()
+        < 1.0
+    {
+        return Err("invalid_request");
+    }
+    Ok(path)
+}
+impl ScribblePlan {
+    pub fn compile(
+        drawing: &TeachingDrawing,
+        start: (f64, f64),
+        width: f64,
+        height: f64,
+    ) -> Result<Self, &'static str> {
+        if !drawing.validate()
+            || !width.is_finite()
+            || !height.is_finite()
+            || width <= 1.0
+            || height <= 1.0
+        {
+            return Err("invalid_request");
+        }
+        let mut previous = start;
+        let mut duration_ms = RETURN_MS;
+        let mut strokes = Vec::with_capacity(drawing.strokes.len());
+        for stroke in &drawing.strokes {
+            let path = compile_stroke(stroke, width, height)?;
+            let length = path
+                .windows(2)
+                .map(|p| (p[1].0 - p[0].0).hypot(p[1].1 - p[0].1))
+                .sum::<f64>();
+            let approach_ms = approach_duration(previous, path[0]);
+            let trace_ms = ((length / PEN_SPEED_POINTS_PER_SECOND * 1000.0) as u64)
+                .clamp(MIN_TRACE_MS, MAX_TRACE_MS);
+            let hold_ms = SCRIBBLE_MIN_HOLD_MS;
+            let half = SCRIBBLE_STROKE_WIDTH_POINTS * 0.5;
+            let mut bounds = path.iter().fold(
+                [
+                    f64::INFINITY,
+                    f64::INFINITY,
+                    f64::NEG_INFINITY,
+                    f64::NEG_INFINITY,
+                ],
+                |b, &(x, y)| [b[0].min(x), b[1].min(y), b[2].max(x), b[3].max(y)],
+            );
+            bounds[0] -= half;
+            bounds[1] -= half;
+            bounds[2] += half;
+            bounds[3] += half;
+            duration_ms += approach_ms + trace_ms + hold_ms + FADE_MS;
+            previous = *path.last().unwrap();
+            strokes.push(CompiledStroke {
+                path,
+                bounds,
+                approach_ms,
+                trace_ms,
+                hold_ms,
+            });
+        }
+        if duration_ms > 15000 {
+            return Err("invalid_request");
+        }
+        Ok(Self {
+            strokes,
+            duration_ms,
+        })
+    }
+}
+/// Distance to the compiled polyline, used for stroke-covered capture comparison.
+pub fn distance_to_path(point: (f64, f64), path: &[(f64, f64)]) -> f64 {
+    path.windows(2)
+        .map(|pair| {
+            let (dx, dy) = (pair[1].0 - pair[0].0, pair[1].1 - pair[0].1);
+            let square = dx * dx + dy * dy;
+            let amount = if square > 0.0 {
+                (((point.0 - pair[0].0) * dx + (point.1 - pair[0].1) * dy) / square).clamp(0.0, 1.0)
+            } else {
+                0.0
+            };
+            (point.0 - pair[0].0 - amount * dx).hypot(point.1 - pair[0].1 - amount * dy)
+        })
+        .fold(f64::INFINITY, f64::min)
+}
+#[cfg(test)]
+mod companion_scribble_tests {
+    use super::*;
+    use cua_driver_contract::CompanionPoint;
+    fn stroke(points: &[(f64, f64)], closed: bool) -> TeachingStroke {
+        TeachingStroke {
+            points: points
+                .iter()
+                .map(|&(x, y)| CompanionPoint { x, y })
+                .collect(),
+            closed,
+        }
+    }
+    #[test]
+    fn companion_scribble_curves_are_bounded_and_preserve_open_endpoints() {
+        let input = stroke(&[(0.1, 0.1), (0.2, 0.8), (0.8, 0.2), (0.9, 0.9)], false);
+        let path = compile_stroke(&input, 1000.0, 500.0).unwrap();
+        assert_eq!(path[0], (100.0, 50.0));
+        assert_eq!(*path.last().unwrap(), (900.0, 450.0));
+        assert!(path.len() <= 32 * QUADRATIC_SAMPLES + 1);
+        assert!(path
+            .iter()
+            .all(|&(x, y)| (100.0..=900.0).contains(&x) && (50.0..=450.0).contains(&y)));
+    }
+    #[test]
+    fn companion_scribble_loop_closes_continuously_and_handles_redundant_points() {
+        let path = compile_stroke(
+            &stroke(
+                &[(0.1, 0.1), (0.1, 0.1), (0.8, 0.1), (0.8, 0.8), (0.1, 0.1)],
+                true,
+            ),
+            1000.0,
+            500.0,
+        )
+        .unwrap();
+        assert_eq!(path.first(), path.last());
+        assert_eq!(path.len(), 3 * QUADRATIC_SAMPLES + 1);
+    }
+    #[test]
+    fn companion_scribble_boundary_mapping_and_visible_length_are_explicit() {
+        let path =
+            compile_stroke(&stroke(&[(0.0, 0.0), (1.0, 1.0)], false), 1000.0, 500.0).unwrap();
+        assert_eq!(path[0], (0.0, 0.0));
+        assert!(path[1].0 < 1000.0 && path[1].1 < 500.0);
+        assert!(compile_stroke(
+            &stroke(&[(0.1, 0.1), (0.10000001, 0.1)], false),
+            1000.0,
+            500.0
+        )
+        .is_err());
+    }
+    #[test]
+    fn companion_scribble_plan_holds_each_stroke_and_keeps_a_bounded_timeline() {
+        let drawing = TeachingDrawing {
+            strokes: vec![stroke(&[(0.1, 0.1), (0.9, 0.9)], false); 3],
+        };
+        let plan = ScribblePlan::compile(&drawing, (0.0, 0.0), 4000.0, 2000.0).unwrap();
+        assert!(plan.duration_ms <= 15000);
+        assert!(plan.strokes.iter().all(|stroke| stroke.hold_ms == 1100));
+        assert!(distance_to_path((100.0, 100.0), &[(0.0, 0.0), (200.0, 200.0)]) < 1e-9);
+    }
+}
diff --git a/libs/cua-driver/rust/crates/cursor-overlay/src/companion_appearance.rs b/libs/cua-driver/rust/crates/cursor-overlay/src/companion_appearance.rs
