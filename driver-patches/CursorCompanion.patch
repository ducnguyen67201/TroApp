+    let sdk = sdk.clone();
+    let writer = writer.clone();
+    let session = session.to_owned();
+    tasks.spawn(async move {
+        let response = dispatch_legacy_request(sdk.as_ref(), request, &session).await;
+        write_response(&writer, response).await?;
+        Ok((key, true))
+    });
