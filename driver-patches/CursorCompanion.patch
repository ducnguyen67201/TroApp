@@ -0,0 +1,112 @@
+use super::{cursor_tools::resolve_cursor_key, ToolState};
+use async_trait::async_trait;
+use cua_driver_contract::{
+    BindCompanionHudCursorInput, ReadCompanionHudMessageInput, SendCompanionHudCommandInput,
+    SetCompanionHudInput, ToolInput,
+};
+use cua_driver_core::{
+    protocol::ToolResult,
+    tool::{Tool, ToolDef, ToolRegistry},
+    tool_args::parse_typed_input,
+};
+use serde_json::{json, Value};
+use std::sync::Arc;
+struct HudTool {
+    definition: ToolDef,
+    state: Arc<ToolState>,
+}
+#[async_trait]
+impl Tool for HudTool {
+    fn def(&self) -> &ToolDef {
+        &self.definition
+    }
+    async fn invoke(&self, args: Value) -> ToolResult {
+        if !self.state.cursor_overlay_available {
+            return super::cursor_overlay_unavailable();
+        }
+        let session = resolve_cursor_key(&args);
+        if self.definition.name == ReadCompanionHudMessageInput::TOOL_NAME {
+            let input = match parse_typed_input::<ReadCompanionHudMessageInput>(
+                &self.definition.name,
+                args,
+            ) {
+                Ok(input) => input,
+                Err(error) => return error,
+            };
+            if let Err(error) = input.validate() {
+                return ToolResult::error(error);
+            }
+            return ToolResult::text("message").with_structured(json!(
+                crate::cursor::overlay::read_companion_hud_message(&session, &input.group)
+            ));
+        }
+        if self.definition.name == SendCompanionHudCommandInput::TOOL_NAME {
+            let input = match parse_typed_input::<SendCompanionHudCommandInput>(
+                &self.definition.name,
+                args,
+            ) {
+                Ok(input) => input,
+                Err(error) => return error,
+            };
+            if let Err(error) = input.validate() {
+                return ToolResult::error(error);
+            }
+            return match crate::cursor::overlay::send_companion_hud_command(&session, input).await {
+                Ok(output) => ToolResult::text("applied").with_structured(json!(output)),
+                Err(reason) => ToolResult::error(reason),
+            };
+        }
+        let applied = if self.definition.name == SetCompanionHudInput::TOOL_NAME {
+            let input = match parse_typed_input::<SetCompanionHudInput>(&self.definition.name, args)
+            {
+                Ok(input) => input,
+                Err(error) => return error,
+            };
+            if let Err(error) = input.validate() {
+                return ToolResult::error(error);
+            }
+            crate::cursor::overlay::update_companion_hud(&session, input)
+        } else {
+            let input =
+                match parse_typed_input::<BindCompanionHudCursorInput>(&self.definition.name, args)
+                {
+                    Ok(input) => input,
+                    Err(error) => return error,
+                };
+            if let Err(error) = input.validate() {
+                return ToolResult::error(error);
+            }
+            crate::cursor::overlay::bind_companion_hud(
+                &session,
+                &input.group,
+                input.lesson_id.as_deref(),
+            )
+        };
+        if !applied {
+            return ToolResult::error("HUD lease, cursor binding or sequence refused.");
+        }
+        ToolResult::text("applied").with_structured(json!({"applied":true}))
+    }
+}
+pub(super) fn register_tools(registry: &mut ToolRegistry, state: Arc<ToolState>) {
+    for name in [
+        SetCompanionHudInput::TOOL_NAME,
+        SendCompanionHudCommandInput::TOOL_NAME,
+        BindCompanionHudCursorInput::TOOL_NAME,
+        ReadCompanionHudMessageInput::TOOL_NAME,
+    ] {
+        let contract = cua_driver_contract::tool_contract(name).expect("HUD canonical contract");
+        registry.register(Box::new(HudTool {
+            state: state.clone(),
+            definition: ToolDef {
+                name: contract.name.clone(),
+                description: contract.description.clone(),
+                input_schema: contract.input_schema.clone(),
+                read_only: false,
+                destructive: false,
+                idempotent: true,
+                open_world: false,
+            },
+        }));
+    }
+}
diff --git a/libs/cua-driver/rust/crates/platform-macos/src/tools/companion_tools.rs b/libs/cua-driver/rust/crates/platform-macos/src/tools/companion_tools.rs
new file mode 100644
index 0000000..b01c2fe
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-macos/src/tools/companion_tools.rs
@@ -0,0 +1,449 @@
+//! Native companion controller. This module never imports input executors.
+//! A single desktop lease prevents competing agents from painting guidance.
+use super::{cursor_tools::resolve_cursor_key, get_screen_size::main_screen_size, ToolState};
+#[path = "companion_guidance.rs"]
+mod guidance;
+use async_trait::async_trait;
+use cua_driver_contract::{
+    CancelCursorSequenceInput, CompanionMode, GetCursorCompanionStateInput,
+    PresentTeachingGuidanceInput, SetCursorCompanionModeInput, ToolInput,
+};
+use cua_driver_core::{
+    protocol::ToolResult,
+    tool::{Tool, ToolDef, ToolRegistry},
+    tool_args::parse_typed_input,
+};
+use cursor_overlay::OverlayCommand;
+use serde_json::{json, Value};
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Arc, Mutex, OnceLock,
+};
+use std::time::{Duration, Instant};
+
+#[derive(Default)]
+struct CompanionSession {
+    owner: Option<String>,
+    task_epoch: Option<String>,
+    task_owner: Option<String>,
+    terminal: Option<&'static str>,
+    task_input: Option<[u32; 7]>,
+    ended_task: Option<(String, Option<&'static str>)>,
+    fence: Arc<Mutex<cursor_overlay::guidance::FrameFence>>,
+    revision: u64,
+    pointer: Option<(f64, f64)>,
+    generation: u64,
+    follow_generation: u64,
+    following: bool,
+    active: bool,
+    lease_until: Option<Instant>,
+}
+impl CompanionSession {
+    fn begin_sequence(&mut self, session: &str) -> Result<u64, String> {
+        if self.active || self.owner.as_deref().is_some_and(|owner| owner != session) {
+            return Err("Desktop companion is busy.".into());
+        }
+        self.owner = Some(session.to_owned());
+        if self.terminal.is_some() {
+            return Err("Teaching task has ended.".into());
+        }
+        self.active = true;
+        self.generation = self.generation.wrapping_add(1);
+        self.fence.lock().unwrap().generation = self.generation;
+        Ok(self.generation)
+    }
+    fn cancel_sequence(&mut self, session: &str) -> bool {
+        if self.owner.as_deref() != Some(session) {
+            return false;
+        }
+        self.generation = self.generation.wrapping_add(1);
+        self.active = false;
+        if self.task_epoch.is_some() {
+            self.terminal = Some("explicit_stop");
+        }
+        self.fence.lock().unwrap().generation = self.generation;
+        true
+    }
+}
+
+/// Count only keyboard, button and scroll events. Guidance never posts any
+/// of these events; a changed counter signals student interaction.
+pub(super) fn read_user_input_counters() -> [u32; 7] {
+    #[link(name = "ApplicationServices", kind = "framework")]
+    extern "C" {
+        fn CGEventSourceCounterForEventType(state: i32, event_type: u32) -> u32;
+    }
+    [1, 3, 10, 11, 12, 22, 25]
+        .map(|event_type| unsafe { CGEventSourceCounterForEventType(1, event_type) })
+}
+
+fn state() -> &'static Mutex<CompanionSession> {
+    static STATE: OnceLock<Mutex<CompanionSession>> = OnceLock::new();
+    STATE.get_or_init(|| Mutex::new(CompanionSession::default()))
+}
+fn send(session: &str, command: OverlayCommand) -> Result<(), String> {
+    if crate::cursor::overlay::try_send_command(session.to_owned(), command) {
+        Ok(())
+    } else {
+        Err("Native overlay unavailable or command queue full.".into())
+    }
+}
+
+fn hide_companion(session: &str) {
+    let _ = send(session, OverlayCommand::SetEnabled(false));
+    let _ = send(session, OverlayCommand::SetCompanionAppearance(false));
+}
+
+// Host-only progression metadata; never expose key values, locations or screen
+// content. An input revision requests observation, not verification of success.
+fn read_guidance_snapshot(
+    state: &CompanionSession,
+    session: &str,
+    input: [u32; 7],
+) -> Option<Value> {
+    if state.owner.as_deref() != Some(session) {
+        return None;
+    }
+    state.task_epoch.as_ref().map(|epoch| {
+        json!({
+            "task_epoch": epoch,
+            "reason": state.terminal,
+            "input_revision": input.iter().map(|value| u64::from(*value)).sum::<u64>(),
+        })
+    })
+}
+
+fn snapshot(session: &str, status: &str) -> ToolResult {
+    let state = state().lock().unwrap();
+    let owned = state.owner.as_deref() == Some(session);
+    let guidance = read_guidance_snapshot(&state, session, read_user_input_counters());
+    let mut result = json!({
+        "status": status, "following": owned && state.following, "active": owned && state.active,
+    });
+    if let Some(guidance) = guidance {
+        result["guidance"] = guidance;
+    }
+    ToolResult::text(status).with_structured(result)
+}
+pub(super) fn retire_session(session: &str) {
+    let mut state = state().lock().unwrap();
+    retire_owned_cursor(&mut state, session);
+}
+fn retire_owned_cursor(state: &mut CompanionSession, session: &str) {
+    if state.owner.as_deref() == Some(session) {
+        state.generation = state.generation.wrapping_add(1);
+        state.follow_generation = state.follow_generation.wrapping_add(1);
+        state.fence.lock().unwrap().generation = state.generation;
+        if state.task_epoch.is_some() {
+            state.terminal = Some("session_lost");
+        }
+        state.active = false;
+        state.following = false;
+        state.owner = None;
+        state.lease_until = None;
+        state.clear_guidance(session, false);
+        hide_companion(session);
+    }
+}
+pub(super) fn retire_runtime(prefix: &str) {
+    let owner = state().lock().unwrap().owner.clone();
+    if let Some(owner) = owner.filter(|owner| owner.starts_with(prefix)) {
+        retire_session(&owner);
+    }
+}
+fn can_continue_playback(session: &str) -> bool {
+    !cua_driver_core::session::is_session_ending(session)
+}
+
+fn start_following(session: String, generation: u64) {
+    std::thread::spawn(move || loop {
+        if !can_continue_playback(&session) {
+            retire_session(&session);
+            break;
+        }
+        {
+            let mut state = state().lock().unwrap();
+            if state.owner.as_deref() != Some(&session)
+                || !state.following
+                || state.follow_generation != generation
+            {
+                break;
+            }
+            if state
+                .lease_until
+                .is_some_and(|deadline| Instant::now() > deadline)
+            {
+                state.terminal = Some("lease_expired");
+                retire_owned_cursor(&mut state, &session);
+                state.terminal = Some("lease_expired");
+                break;
+            }
+            if state.task_epoch.is_some()
+                && state.terminal.is_none()
+                && state
+                    .task_input
+                    .is_some_and(|initial| read_user_input_counters() != initial)
+            {
+                state.terminal = Some("user_takeover");
+                state.active = false;
+                let visible = state.following;
+                state.clear_guidance(&session, visible);
+            }
+            if !state.active {
+                if let (Some((x, y)), Some((width, height, _))) = (
+                    cua_driver_core::cursor_sampler::read_cursor_position(),
+                    main_screen_size(),
+                ) {
+                    let visible = x >= 0.0 && y >= 0.0 && x < width as f64 && y < height as f64;
+                    if send(&session, OverlayCommand::SetEnabled(visible)).is_err() {
+                        retire_owned_cursor(&mut state, &session);
+                        break;
+                    }
+                    if visible {
+                        let point = (
+                            (x + 24.0).min(width as f64 - 2.0),
+                            (y + 24.0).min(height as f64 - 2.0),
+                        );
+                        let frame = state.create_frame(point, vec![], 0.0, false, true, false);
+                        if !crate::cursor::overlay::present_guidance_frame(&session, frame) {
+                            retire_owned_cursor(&mut state, &session);
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+        std::thread::sleep(Duration::from_millis(33));
+    });
+}
+
+struct CompanionTool {
+    companion: TeachingGuidanceAdapter,
+    definition: ToolDef,
+}
+
+/// Tool adapter composes session admission and the single scribble renderer.
+/// Pointer following remains owned by CompanionSession and start_following.
+struct TeachingGuidanceAdapter {
+    state: Arc<ToolState>,
+}
+#[async_trait]
+impl Tool for CompanionTool {
+    fn def(&self) -> &ToolDef {
+        &self.definition
+    }
+    async fn invoke(&self, args: Value) -> ToolResult {
+        if !self.companion.state.cursor_overlay_available {
+            return super::cursor_overlay_unavailable();
+        }
+        let session = resolve_cursor_key(&args);
+        match self.definition.name.as_str() {
+            "get_cursor_companion_capabilities"
+            | "begin_cursor_guidance_task"
+            | "end_cursor_guidance_task" => {
+                self.companion
+                    .invoke_guidance_lifecycle(&self.definition.name, &session, args)
+                    .await
+            }
+            "get_cursor_companion_state" => {
+                if let Err(error) =
+                    parse_typed_input::<GetCursorCompanionStateInput>(&self.definition.name, args)
+                {
+                    return error;
+                }
+                snapshot(&session, "state")
+            }
+            "cancel_cursor_sequence" => {
+                if let Err(error) =
+                    parse_typed_input::<CancelCursorSequenceInput>(&self.definition.name, args)
+                {
+                    return error;
+                }
+                let mut state = state().lock().unwrap();
+                if state.cancel_sequence(&session) {
+                    let visible = state.following;
+                    state.clear_guidance(&session, visible);
+                    if !state.following {
+                        state.owner = None;
+                        hide_companion(&session);
+                    }
+                }
+                drop(state);
+                snapshot(&session, "canceled")
+            }
+            "set_cursor_companion_mode" => {
+                let input = match parse_typed_input::<SetCursorCompanionModeInput>(
+                    &self.definition.name,
+                    args,
+                ) {
+                    Ok(input) => input,
+                    Err(error) => return error,
+                };
+                if let Err(error) = input.validate() {
+                    return ToolResult::error(error);
+                }
+                if matches!(input.mode, CompanionMode::Hidden) {
+                    retire_session(&session);
+                    self.companion
+                        .state
+                        .cursor_registry
+                        .set_enabled(&session, false);
+                    return snapshot(&session, "hidden");
+                }
+                let mut state = state().lock().unwrap();
+                if state.owner.as_deref().is_some_and(|owner| owner != session) {
+                    return ToolResult::error("Another session owns the desktop companion.");
+                }
+                if state.owner.is_none() && state.task_owner.as_deref() != Some(&session) {
+                    state.task_epoch = None;
+                    state.task_owner = None;
+                    state.task_input = None;
+                    state.terminal = None;
+                    state.ended_task = None;
+                }
+                if !state.active {
+                    if let Err(error) = send(&session, OverlayCommand::SetCompanionAppearance(true))
+                    {
+                        return ToolResult::error(error);
+                    }
+                }
+                if let Some(label) = input.label {
+                    if let Err(error) = send(&session, OverlayCommand::SetSessionLabel(label)) {
+                        return ToolResult::error(error);
+                    }
+                }
+                let start = !state.following;
+                if start {
+                    state.follow_generation = state.follow_generation.wrapping_add(1);
+                }
+                let follow_generation = state.follow_generation;
+                state.owner = Some(session.clone());
+                state.following = true;
+                state.lease_until = Some(Instant::now() + Duration::from_secs(60));
+                self.companion
+                    .state
+                    .cursor_registry
+                    .set_enabled(&session, true);
+                if let Err(error) = send(&session, OverlayCommand::SetEnabled(true)) {
+                    state.owner = None;
+                    state.following = false;
+                    return ToolResult::error(error);
+                }
+                drop(state);
+                if start {
+                    start_following(session.clone(), follow_generation);
+                }
+                snapshot(&session, "following")
+            }
+            "present_teaching_guidance" => {
+                let input = match parse_typed_input::<PresentTeachingGuidanceInput>(
+                    &self.definition.name,
+                    args.clone(),
+                ) {
+                    Ok(input) => input,
+                    Err(_) => return self.companion.refuse_guidance(&session, "invalid_request"),
+                };
+                if input.presentation_version != 3 {
+                    return self
+                        .companion
+                        .refuse_guidance(&session, "unsupported_version");
+                }
+                self.companion
+                    .present_guidance(&session, &args, input)
+                    .await
+            }
+            _ => ToolResult::error("Unknown companion operation."),
+        }
+    }
+}
+
+pub(super) fn register_tools(registry: &mut ToolRegistry, state: Arc<ToolState>) {
+    for name in [
+        "get_cursor_companion_capabilities",
+        "begin_cursor_guidance_task",
+        "end_cursor_guidance_task",
+        "present_teaching_guidance",
+        "set_cursor_companion_mode",
+        "cancel_cursor_sequence",
+        "get_cursor_companion_state",
+    ] {
+        let contract =
+            cua_driver_contract::tool_contract(name).expect("companion canonical contract");
+        registry.register(Box::new(CompanionTool {
+            companion: TeachingGuidanceAdapter {
+                state: state.clone(),
+            },
+            definition: ToolDef {
+                name: contract.name.clone(),
+                description: contract.description.clone(),
+                input_schema: contract.input_schema.clone(),
+                read_only: contract.annotations.read_only,
+                destructive: false,
+                idempotent: contract.annotations.idempotent,
+                open_world: false,
+            },
+        }));
+    }
+}
