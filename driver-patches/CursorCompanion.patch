+fn start_legacy_request<W: AsyncWrite + Unpin + Send + 'static>(
+    tasks: &mut tokio::task::JoinSet<anyhow::Result<(String, bool)>>,
+    key: String,
+    request: Request,
+    sdk: &Arc<crate::sdk_adapter::SdkAdapter>,
+    writer: &Arc<tokio::sync::Mutex<W>>,
+    session: &str,
