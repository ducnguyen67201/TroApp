+            "_session_id":"transport-owner", "_transport_session_id":"transport-owner"});
+        let owner = resolve_cursor_key(&args);
+        let input: WatchInput = parse_typed_input("begin_desktop_watch", args)
+            .expect("trusted ingress metadata must not break public parsing");
+        assert_eq!(owner, "transport-owner");
+        assert_eq!(input.watch_id, "11111111-1111-4111-8111-111111111111");
+        assert!(parse_typed_input::<WatchInput>(
+            "begin_desktop_watch",
+            json!({"watch_id":input.watch_id,"unreviewed_option":true})
+        )
+        .is_err());
+    }
+
+    #[test]
+    fn companion_observation_old_stream_cannot_own_restarted_lesson() {
+        fn changes() -> Arc<Mutex<Changes>> {
+            Arc::new(Mutex::new(Changes {
+                input_only: false,
+                hashes: vec![],
+                regions: vec![],
+                relevant_revision: 0,
+                columns: 24,
+                revision: 0,
+                fraction: 0.0,
+                ready: false,
+                failed: false,
+                lease_until: Instant::now() + LEASE,
+                last_input: 0,
+                input_at: Instant::now(),
+            }))
+        }
+        let old = changes();
+        let replacement = changes();
+        let watch = Watch {
+            id: "lesson".into(),
+            owner: "session".into(),
+            width: 100,
+            height: 100,
+            changes: replacement.clone(),
+        };
+        assert!(!owns_stream(&watch, "lesson", &old));
+        assert!(owns_stream(&watch, "lesson", &replacement));
+        assert!(!owns_stream(&watch, "other", &replacement));
+    }
+    #[test]
+    fn companion_observation_ignores_single_tile_and_accumulates_small_changes() {
+        let mut changes = Changes {
+            input_only: false,
+            hashes: vec![1, 1, 1],
+            regions: vec![],
+            relevant_revision: 0,
+            columns: 24,
+            revision: 1,
+            fraction: 0.0,
+            ready: true,
+            failed: false,
+            lease_until: Instant::now() + LEASE,
+            last_input: 0,
+            input_at: Instant::now(),
+        };
+        record_frame(&mut changes, vec![2, 1, 1]);
+        assert_eq!(changes.revision, 1);
+        record_frame(&mut changes, vec![2, 2, 1]);
+        assert_eq!(changes.revision, 2);
+        record_frame(&mut changes, vec![2, 2, 1]);
+        assert_eq!(changes.revision, 2);
+    }
+    #[test]
+    fn companion_observation_prioritizes_small_relevant_changes() {
+        let mut changes = Changes {
+            input_only: false,
+            hashes: vec![1; 4],
+            regions: vec![ObservationRegion {
+                x: 0.5,
+                y: 0.0,
+                width: 0.5,
+                height: 0.5,
+            }],
+            relevant_revision: 0,
+            columns: 2,
+            revision: 1,
+            fraction: 0.0,
+            ready: true,
+            failed: false,
+            lease_until: Instant::now() + LEASE,
+            last_input: 0,
+            input_at: Instant::now(),
+        };
+        record_frame(&mut changes, vec![1, 2, 1, 1]);
+        assert_eq!(changes.relevant_revision, 1);
+        assert_eq!(changes.revision, 2);
+        record_frame(&mut changes, vec![1, 2, 1, 1]);
+        assert_eq!(changes.relevant_revision, 1);
+        record_frame(&mut changes, vec![1, 2, 2, 2]);
+        assert_eq!(changes.relevant_revision, 1);
+        assert_eq!(changes.revision, 3); // Whole-screen fallback stays alive.
+    }
