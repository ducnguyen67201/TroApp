+// A trace starts at a single point. f64 endpoints can still coincide after the
+// renderer converts them to f32 pixels. Wait for a drawable segment instead of
+// asking tiny-skia to stroke an empty outline; pointer/receipt rendering proceeds.
+const MIN_COMPANION_SEGMENT_PIXELS: f32 = 0.01;
+
+fn build_companion_mark_path(
+    points: &[(f64, f64)],
+    origin_x: f64,
+    origin_y: f64,
+    scale: f64,
+) -> Option<tiny_skia::Path> {
+    let mut builder = tiny_skia::PathBuilder::new();
+    let mut previous: Option<tiny_skia::Point> = None;
+    let mut has_segment = false;
+    for &(x, y) in points {
+        let point = tiny_skia::Point::from_xy(
+            ((x - origin_x) * scale) as f32,
+            ((y - origin_y) * scale) as f32,
+        );
+        if !point.x.is_finite() || !point.y.is_finite() {
+            return None;
+        }
+        if let Some(start) = previous {
+            if (point.x - start.x).hypot(point.y - start.y) < MIN_COMPANION_SEGMENT_PIXELS {
+                continue;
+            }
+            builder.line_to(point.x, point.y);
+            has_segment = true;
+        } else {
+            builder.move_to(point.x, point.y);
+        }
+        previous = Some(point);
+    }
+    if has_segment {
+        builder.finish()
+    } else {
+        None
+    }
