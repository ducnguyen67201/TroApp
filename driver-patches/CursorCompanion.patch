+/// The real callback and deterministic tests use the same installation guard.
+/// Lock order: HUD, unique guidance fences in pointer order, accessibility text.
+/// Neither the install port nor this function may acquire RENDER or await work.
+fn install_current_composite(
+    hud: &mut super::companion_hud::HudState,
+    scene: &super::companion_hud::SceneToken,
+    token: Option<&cua_driver_contract::CompanionRenderToken>,
+    frames: &[cursor_overlay::guidance::GuidanceFrame],
+    now: Instant,
+    install: impl FnOnce() -> Result<(), super::companion_hud::RenderFailure>,
+) -> bool {
+    hud.install_frame(scene, token, now, || {
+        let mut unique_fences: Vec<_> = frames.iter().map(|frame| frame.fence.clone()).collect();
+        unique_fences.sort_by_key(|fence| std::sync::Arc::as_ptr(fence) as usize);
+        unique_fences.dedup_by(|first, second| std::sync::Arc::ptr_eq(first, second));
+        let mut fences: Vec<_> = unique_fences
+            .iter()
+            .map(|fence| fence.lock().unwrap())
+            .collect();
+        let fence_index = |frame: &cursor_overlay::guidance::GuidanceFrame| {
+            unique_fences
+                .binary_search_by_key(&(std::sync::Arc::as_ptr(&frame.fence) as usize), |fence| {
+                    std::sync::Arc::as_ptr(fence) as usize
+                })
+                .expect("composite fence collected above")
+        };
+        if !frames.iter().all(|frame| {
+            let fence = &fences[fence_index(frame)];
+            fence.generation == frame.generation && frame.revision >= fence.rendered_revision
+        }) {
+            return Ok(false);
+        }
+        install()?;
+        let rendered_at = Instant::now();
+        for frame in frames {
+            let fence = &mut fences[fence_index(frame)];
+            fence.rendered_revision = fence.rendered_revision.max(frame.revision);
+            let mut receipt = frame.receipt.lock().unwrap();
+            if receipt.is_none() {
+                *receipt = Some(rendered_at);
+            }
+        }
+        Ok(true)
+    })
+}
+
+/// Main queue only. Called while both HUD ownership and guidance fences are held.
+unsafe fn install_layer_image(payload: &LayerImage) {
+    let mut last_text = LAST_ACCESSIBILITY_TEXT.lock().unwrap();
+    if *last_text != payload.accessible_text {
+        if let Ok(text) = std::ffi::CString::new(payload.accessible_text.as_str()) {
+            let window = payload.window as *mut objc2::runtime::AnyObject;
+            let view: *mut objc2::runtime::AnyObject = objc2::msg_send![window, contentView];
+            let label: *mut objc2::runtime::AnyObject =
+                objc2::msg_send![objc2::class!(NSString), stringWithUTF8String: text.as_ptr()];
+            let role: *mut objc2::runtime::AnyObject = objc2::msg_send![objc2::class!(NSString), stringWithUTF8String: c"AXStaticText".as_ptr()];
+            let _: () = objc2::msg_send![view, setAccessibilityRole: role];
+            let _: () = objc2::msg_send![view, setAccessibilityLabel: label];
+            let _: () = objc2::msg_send![view, setAccessibilityElement: objc2::runtime::Bool::new(!payload.accessible_text.is_empty())];
+            *last_text = payload.accessible_text.clone();
+        }
+    }
+    let layer = payload.layer as *mut objc2::runtime::AnyObject;
+    let image = payload.image as *mut objc2::runtime::AnyObject;
+    let _: () = objc2::msg_send![layer, setContents: image];
+}
