+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn companion_progress_snapshot_is_epoch_bound_and_contains_no_input_content() {
+        let mut state = CompanionState::default();
+        state.owner = Some("teacher".to_owned());
+        assert!(read_guidance_snapshot(&state, "teacher", [0; 7]).is_none());
+        state.task_epoch = Some(uuid::Uuid::new_v4().to_string());
+        state.terminal = Some("user_takeover");
+        assert!(read_guidance_snapshot(&state, "other", [1; 7]).is_none());
+        let snapshot = read_guidance_snapshot(&state, "teacher", [1; 7]).unwrap();
+        assert_eq!(snapshot["task_epoch"], json!(state.task_epoch));
+        assert_eq!(snapshot["reason"], "user_takeover");
+        assert_eq!(snapshot["input_revision"], 7);
+        assert_eq!(snapshot.as_object().unwrap().len(), 3);
+        assert_eq!(state.terminal, Some("user_takeover"));
+    }
+    #[test]
+    fn companion_ownership_prevents_overlap_and_foreign_cancellation() {
+        let mut state = CompanionState::default();
+        let generation = state.begin_sequence("teacher").unwrap();
+        assert!(state.begin_sequence("teacher").is_err());
+        assert!(state.begin_sequence("other").is_err());
+        assert!(!state.cancel_sequence("other"));
+        assert_eq!(state.generation, generation);
+        assert!(state.cancel_sequence("teacher"));
+        assert_ne!(state.generation, generation);
+        assert!(!state.active);
+        assert!(state.begin_sequence("teacher").is_ok());
+    }
+    #[test]
+    fn companion_stops_before_deferred_session_cleanup() {
+        use cua_driver_core::session::{
+            begin_session_dispatch, end_session, is_session_ended, SessionClientKind,
+            SessionTransport,
+        };
+        let session = format!("companion-cancellation-{}", uuid::Uuid::new_v4());
+        let guard = begin_session_dispatch(
+            &session,
+            None,
+            &session,
+            true,
+            SessionTransport::McpStdio,
+            SessionClientKind::Mcp,
+        )
+        .unwrap();
+        assert!(can_continue_playback(&session));
+        end_session(&session);
+        assert!(
+            !is_session_ended(&session),
+            "cleanup waits for active dispatch"
+        );
+        assert!(
+            !can_continue_playback(&session),
+            "playback sees the stop request immediately"
+        );
+        drop(guard);
+        assert!(is_session_ended(&session));
+    }
+}
