+    point_on_path, reveal_path, GuidanceFrame, GuidancePaintGeometry, StepEvidence, FADE_MS,
+    MAX_FRAME_GAP, RETURN_MS,
+};
+use cursor_overlay::scribble_renderer::ScribblePlan;
+
+fn elapsed_ms(start: Instant) -> u64 {
+    (start.elapsed().as_millis() as u64).min(120000)
+}
+
+impl CompanionSession {
+    pub(super) fn create_frame(
+        &mut self,
+        pointer: (f64, f64),
+        cue: Vec<(f64, f64)>,
+        cue_alpha: f32,
+        teaching: bool,
+        visible: bool,
+        pressed: bool,
+    ) -> GuidanceFrame {
+        self.revision = self.revision.wrapping_add(1);
+        self.pointer = Some(pointer);
+        GuidanceFrame {
+            generation: self.generation,
+            revision: self.revision,
+            fence: self.fence.clone(),
+            receipt: Arc::new(Mutex::new(None)),
+            paint_geometry: Arc::new(Mutex::new(None)),
+            pointer,
+            cue,
+            cue_alpha,
+            teaching,
+            visible,
+            pressed,
+        }
+    }
+    pub(super) fn clear_guidance(&mut self, session: &str, visible: bool) -> GuidanceFrame {
+        self.generation = self.generation.wrapping_add(1);
+        self.fence.lock().unwrap().generation = self.generation;
+        let frame = self.create_frame(
+            self.pointer.unwrap_or((0.0, 0.0)),
+            vec![],
+            0.0,
+            false,
+            visible,
+            false,
+        );
+        let _ = crate::cursor::overlay::present_guidance_frame(session, frame.clone());
+        frame
+    }
+}
+
+fn guidance_error(
+    session: &str,
+    epoch: &str,
+    sequence_id: Option<&str>,
+    reason: &'static str,
+) -> ToolResult {
+    let state = state().lock().unwrap();
+    let canceled = matches!(
+        reason,
+        "user_takeover" | "explicit_stop" | "session_lost" | "lease_expired"
+    );
+    let mut data = json!({"status":if canceled {"canceled"} else {"failed"}, "following":state.owner.as_deref()==Some(session)&&state.following, "active":false, "task_epoch":epoch,"sequence_id":sequence_id});
+    data[if canceled { "reason" } else { "code" }] = json!(reason);
+    ToolResult::error(reason).with_structured(data)
+}
+
+/// Capture validity, takeover and the monotonic generation are checked at every
+/// phase and during receipt waits. Native lease renewal never resets this latch.
+fn check_guidance(
+    session: &str,
+    generation: u64,
+    deadline: Instant,
+    capture_current: &impl Fn() -> bool,
+) -> Result<(), &'static str> {
+    if !can_continue_playback(session) {
+        return Err("session_lost");
+    }
+    let state = state().lock().unwrap();
+    if let Some(reason) = state.terminal {
+        return Err(reason);
+    }
+    if state.owner.as_deref() != Some(session) || !state.active || state.generation != generation {
+        return Err("explicit_stop");
+    }
+    if state
+        .lease_until
+        .is_some_and(|until| Instant::now() >= until)
+    {
+        return Err("lease_expired");
+    }
+    if state
+        .task_input
+        .is_some_and(|initial| read_user_input_counters() != initial)
+    {
+        return Err("user_takeover");
+    }
+    if !capture_current() {
+        return Err("target_invalidated");
+    }
+    if Instant::now() > deadline {
+        return Err("render_timeout");
+    }
+    Ok(())
+}
+
+async fn await_receipt(
+    frame: &GuidanceFrame,
+    limit: Duration,
+    check: &(impl Fn() -> Result<(), &'static str> + Sync),
+) -> Result<Instant, &'static str> {
+    let deadline = Instant::now() + limit;
+    loop {
+        if let Some(rendered_at) = *frame.receipt.lock().unwrap() {
+            return if rendered_at <= deadline {
+                Ok(rendered_at)
+            } else {
+                Err("render_timeout")
+            };
+        }
+        check()?;
+        if Instant::now() >= deadline {
+            return Err("render_timeout");
+        }
+        tokio::time::sleep(Duration::from_millis(4)).await;
+    }
+}
+
+async fn present_frame(
+    session: &str,
+    generation: u64,
+    pointer: (f64, f64),
+    cue: Vec<(f64, f64)>,
+    alpha: f32,
+    pressed: bool,
+    check: &(impl Fn() -> Result<(), &'static str> + Sync),
+) -> Result<(Instant, Option<GuidancePaintGeometry>), &'static str> {
+    check()?;
+    let frame = {
+        let mut state = state().lock().unwrap();
+        if state.generation != generation || !state.active {
+            return Err("explicit_stop");
+        }
+        let frame = state.create_frame(pointer, cue, alpha, true, true, pressed);
+        if !crate::cursor::overlay::present_guidance_frame(session, frame.clone()) {
+            return Err("transport_failed");
+        }
+        frame
+    };
+    let rendered_at = await_receipt(&frame, MAX_FRAME_GAP, check).await?;
+    check()?;
+    let geometry = frame.paint_geometry.lock().unwrap().clone();
+    Ok((rendered_at, geometry))
+}
+
+/// Only a non-degenerate installed stroke acknowledges a drawing. An approach
+/// pointer or a zero-length prefix is a rendered frame, but not a visible cue.
+fn has_visible_stroke(points: &[(f64, f64)]) -> bool {
+    points
+        .windows(2)
+        .map(|pair| (pair[1].0 - pair[0].0).hypot(pair[1].1 - pair[0].1))
+        .sum::<f64>()
+        >= 1.0
+}
+fn can_acknowledge_presentation(
+    result: Result<(), &'static str>,
+    message: bool,
+    drawing: bool,
+    text_only: bool,
+) -> bool {
+    (result.is_ok() || (result == Err("user_takeover") && !text_only))
+        && message
+        && (text_only || drawing)
+}
+
+async fn animate_phase(
+    session: &str,
+    generation: u64,
+    duration_ms: u64,
+    check: &(impl Fn() -> Result<(), &'static str> + Sync),
+    mut scene: impl FnMut(f64) -> ((f64, f64), Vec<(f64, f64)>, f32, bool) + Send,
+    mut rendered: impl FnMut(f64, Instant, Option<GuidancePaintGeometry>) -> Result<(), &'static str>
+        + Send,
+) -> Result<(), &'static str> {
+    let started = Instant::now();
+    loop {
+        let progress = if duration_ms == 0 {
+            1.0
+        } else {
+            (started.elapsed().as_secs_f64() * 1000.0 / duration_ms as f64).min(1.0)
+        };
+        let (pointer, cue, alpha, pressed) = scene(progress);
+        let receipt =
+            present_frame(session, generation, pointer, cue, alpha, pressed, check).await?;
+        rendered(progress, receipt.0, receipt.1)?;
+        if progress >= 1.0 {
+            return Ok(());
+        }
+        tokio::time::sleep(Duration::from_millis(16)).await;
+    }
+}
+
+impl TeachingGuidanceAdapter {
+    pub(super) async fn invoke_guidance_lifecycle(
+        &self,
+        name: &str,
+        session: &str,
+        args: Value,
+    ) -> ToolResult {
+        if name == "get_cursor_companion_capabilities" {
+            if let Err(error) = parse_typed_input::<GetCursorCompanionCapabilitiesInput>(name, args)
+            {
+                return error;
+            }
+            return ToolResult::text("capabilities").with_structured(json!({"presentation_versions":[3],"task_lifecycle":true,"paired_presentation":true,"display_scope":"primary","gestures":["scribble"],"max_strokes":3,"max_points_per_stroke":32,"max_duration_ms":15000}));
+        }
+        if name == "begin_cursor_guidance_task" {
+            let input = match parse_typed_input::<BeginCursorGuidanceTaskInput>(name, args) {
+                Ok(input) => input,
+                Err(error) => return error,
+            };
+            if input.presentation_version != 3 || uuid::Uuid::parse_str(&input.task_epoch).is_err()
+            {
+                return ToolResult::error("unsupported_version");
+            }
+            let mut state = state().lock().unwrap();
+            if state.active || state.owner.as_deref() != Some(session) || !state.following {
+                return ToolResult::error("busy");
+            }
+            if state.task_epoch.as_deref() == Some(&input.task_epoch) {
+                if state.terminal.is_some() {
+                    return ToolResult::error("Task is terminal; submit a new request.");
+                }
+            } else {
+                state.clear_guidance(session, true);
+                state.task_epoch = Some(input.task_epoch.clone());
+                state.task_owner = Some(session.to_owned());
+                state.terminal = None;
+                state.task_input = Some(read_user_input_counters());
+            }
+            return ToolResult::text("task_ready").with_structured(json!({"status":"task_ready","task_epoch":input.task_epoch,"following":true,"active":false}));
+        }
+        let input = match parse_typed_input::<EndCursorGuidanceTaskInput>(name, args) {
+            Ok(input) => input,
+            Err(error) => return error,
+        };
+        {
+            let state = state().lock().unwrap();
+            if !state.active
+                && state.owner.as_deref() == Some(session)
+                && state.task_epoch.is_none()
+            {
+                if let Some((epoch, reason)) = &state.ended_task {
+                    if epoch == &input.task_epoch {
+                        let reason = *reason;
+                        drop(state);
+                        return if let Some(reason) = reason {
+                            guidance_error(session, &input.task_epoch, None, reason)
+                        } else {
+                            snapshot_task(session, &input.task_epoch, "task_ended")
+                        };
+                    }
+                }
+            }
+        }
+        let (frame, terminal) = {
+            let mut state = state().lock().unwrap();
+            if state.owner.as_deref() != Some(session)
+                || state.task_epoch.as_deref() != Some(&input.task_epoch)
+            {
+                return ToolResult::error("Unknown task epoch.");
+            }
+            // Reserve the writer until the reliable clear receipt arrives.
+            state.active = true;
+            state.task_epoch = None;
+            state.task_owner = None;
+            state.task_input = None;
+            let terminal = state.terminal.take();
+            let following = state.following;
+            (state.clear_guidance(session, following), terminal)
+        };
+        let cleared = await_receipt(&frame, Duration::from_secs(2), &|| {
+            if can_continue_playback(session) {
+                Ok(())
+            } else {
+                Err("session_lost")
+            }
+        })
+        .await;
+        {
+            let mut state = state().lock().unwrap();
+            if state.owner.as_deref() == Some(session) && state.generation == frame.generation {
+                state.active = false;
+                if cleared.is_ok() {
+                    state.ended_task = Some((input.task_epoch.clone(), terminal));
+                }
+            }
+        }
+        if cleared.is_err() {
+            return ToolResult::error("render_timeout");
+        }
+        if let Some(reason) = terminal {
+            return guidance_error(session, &input.task_epoch, None, reason);
+        }
+        snapshot_task(session, &input.task_epoch, "task_ended")
+    }
+
+    pub(super) fn refuse_guidance(&self, session: &str, reason: &'static str) -> ToolResult {
+        let epoch = {
+            let mut state = state().lock().unwrap();
+            if state.owner.as_deref() != Some(session) {
+                return ToolResult::error(reason);
+            }
+            let Some(epoch) = state.task_epoch.clone() else {
+                return ToolResult::error(reason);
+            };
+            state.terminal.get_or_insert(reason);
+            state.active = false;
+            let following = state.following;
+            state.clear_guidance(session, following);
+            epoch
+        };
+        guidance_error(session, &epoch, None, reason)
+    }
+
+    pub(super) async fn present_guidance(
+        &self,
+        session: &str,
+        args: &Value,
+        input: PresentTeachingGuidanceInput,
+    ) -> ToolResult {
+        let epoch = {
+            let state = state().lock().unwrap();
+            if state.owner.as_deref() != Some(session) {
+                return ToolResult::error("busy");
+            }
+            state.task_epoch.clone()
+        };
+        let Some(epoch) = epoch else {
+            return ToolResult::error("Version 3 requires host task admission.");
+        };
+        if input.validate().is_err() {
+            return self.refuse_guidance(session, "invalid_request");
+        }
+        let operation_started = Instant::now();
+        let mut timings = TeachingGuidanceTimings::default();
+        let sequence_id = uuid::Uuid::new_v4().to_string();
+        let message_shown = AtomicBool::new(false);
+        let drawing_shown = AtomicBool::new(false);
+        let mut render_token = None;
+        let mut coordinate_trace = None;
+        let mut comparison_diagnostics = None;
+        let mut strokes_presented = Vec::new();
+        let result = self
+            .admit_and_present_guidance(
+                session,
+                args,
+                &input,
+                &message_shown,
+                &drawing_shown,
+                &mut render_token,
+                &mut coordinate_trace,
+                &mut comparison_diagnostics,
+                &mut strokes_presented,
+                operation_started,
+                &mut timings,
+            )
+            .await;
+        let interrupted = result == Err("user_takeover");
+        let fresh_required = matches!(
+            result,
+            Err("target_changed" | "geometry_changed" | "capture_unavailable")
+        );
+        if let Err(reason) = result {
+            let mut state = state().lock().unwrap();
+            if state.task_epoch.as_deref() == Some(&epoch) {
+                if !fresh_required {
+                    state.terminal.get_or_insert(reason);
+                }
+                state.active = false;
+                let following = state.following;
+                state.clear_guidance(session, following);
+            }
+        }
+        if can_acknowledge_presentation(
+            result,
+            message_shown.load(Ordering::Acquire),
+            drawing_shown.load(Ordering::Acquire),
+            input.text_only,
+        ) {
+            let state = state().lock().unwrap();
+            // Cancellation or session teardown may win after the final painted
+            // receipt but before this response is committed. Never revive it.
+            let terminal = if !can_continue_playback(session) {
+                Some("session_lost")
+            } else if state.owner.as_deref() != Some(session)
+                || state.task_epoch.as_deref() != Some(&epoch)
+            {
+                Some("explicit_stop")
+            } else {
+                state.terminal
+            };
+            if let Some(reason) =
+                terminal.filter(|reason| *reason != "user_takeover" || input.text_only)
+            {
+                drop(state);
+                if let Some(token) = render_token.as_ref() {
+                    crate::cursor::overlay::clear_companion_message(
+                        session,
+                        &input.hud_group,
+                        token,
+                    );
+                }
+                return guidance_error(session, &epoch, Some(&sequence_id), reason);
+            }
+            let interrupted = interrupted || terminal == Some("user_takeover");
+            let mut output = json!({"status":"presented","following":state.following,"active":false,
+                "receipt":{"presentation_version":3,"task_epoch":epoch,"sequence_id":sequence_id,
+                    "presentation_id":input.presentation_id,"lesson_id":input.teaching_message.lesson_id,
+                    "step_id":input.teaching_message.step_id,"message_presented":true,
+                    "drawing_presented":drawing_shown.load(Ordering::Acquire),"text_only":input.text_only,
+                    "interrupted":interrupted,"strokes_presented":strokes_presented}});
+            if let Some(trace) = coordinate_trace {
+                output["coordinate_trace"] = trace;
+            }
+            if let Some(report) = comparison_diagnostics {
+                output["comparison_diagnostics"] = json!(report);
+            }
+            output["timings_ms"] = json!(timings);
+            return ToolResult::text("presentation_acknowledged").with_structured(output);
+        }
+        if let Some(token) = render_token.as_ref() {
+            crate::cursor::overlay::clear_companion_message(session, &input.hud_group, token);
+        }
+        if fresh_required {
+            let mut output = json!({"status":"refused","code":"fresh_observation_required","reason":result.unwrap_err(),"timings_ms":timings});
+            if let Some(report) = comparison_diagnostics {
+                output["comparison_diagnostics"] = json!(report);
+            }
+            return ToolResult::error("fresh_observation_required").with_structured(output);
+        }
+        guidance_error(
+            session,
+            &epoch,
+            Some(&sequence_id),
+            result.err().unwrap_or("render_timeout"),
+        )
+    }
+
+    async fn admit_and_present_guidance(
+        &self,
+        session: &str,
+        args: &Value,
+        input: &PresentTeachingGuidanceInput,
+        message_shown: &AtomicBool,
+        drawing_shown: &AtomicBool,
+        render_token: &mut Option<cua_driver_contract::CompanionRenderToken>,
+        coordinate_trace: &mut Option<Value>,
+        comparison_diagnostics: &mut Option<cua_driver_contract::CaptureComparison>,
+        strokes_presented: &mut Vec<PresentedStroke>,
+        operation_started: Instant,
+        timings: &mut TeachingGuidanceTimings,
+    ) -> Result<(), &'static str> {
+        let captures = &self.state.companion_captures;
+        let binding = captures
+            .binding_from_args(args)
+            .map_err(|_| "capture_unavailable")?;
+        let requested_capture_id = captures
+            .parse_capture_id(&input.capture_id)
+            .map_err(|_| "capture_unavailable")?;
+        let original = captures
+            .read_for_perception(requested_capture_id, &binding)
+            .map_err(|_| "capture_unavailable")?;
+        if original.target() != &CaptureTarget::PrimaryDesktop {
+            return Err("geometry_changed");
+        }
+        let (width, height, scale) = main_screen_size().ok_or("geometry_changed")?;
+        if !crate::cursor::overlay::has_primary_guidance_geometry(width, height, scale) {
+            return Err("geometry_changed");
+        }
+        let original_dimensions = original.presentation_dimensions();
+        let encoded = original.encoded_dimensions();
+        if original_dimensions.width() as i64 != width
+            || original_dimensions.height() as i64 != height
+            || ((encoded.width() as f64 / encoded.height() as f64) - (width as f64 / height as f64))
+                .abs()
+                > 0.01
+        {
+            return Err("geometry_changed");
+        }
+        let start = state()
+            .lock()
+            .unwrap()
+            .pointer
+            .or_else(cua_driver_core::cursor_sampler::read_cursor_position)
+            .ok_or("geometry_changed")?;
+        // Compile once against the bound original capture, before checking refresh.
+        let compile_started = Instant::now();
+        let plan = input
+            .drawing
+            .as_ref()
+            .map(|drawing| ScribblePlan::compile(drawing, start, width as f64, height as f64))
+            .transpose()?;
+        timings.compile_ms = elapsed_ms(compile_started);
+        let duration_ms = plan.as_ref().map_or(0, |plan| plan.duration_ms);
+        let generation = {
+            let mut state = state().lock().unwrap();
+            if let Some(reason) = state.terminal {
+                return Err(reason);
+            }
+            if state
+                .task_input
+                .is_some_and(|initial| read_user_input_counters() != initial)
+            {
+                return Err("user_takeover");
+            }
+            state.begin_sequence(session).map_err(|_| "busy")?
+        };
+        let deadline = Instant::now() + Duration::from_millis(duration_ms + 5000);
+        let admission_check = || {
+            check_guidance(session, generation, deadline, &|| {
+                main_screen_size() == Some((width, height, scale))
+                    && captures
+                        .read_for_perception(requested_capture_id, &binding)
+                        .is_ok()
+            })
+        };
+        admission_check()?;
+        // Internal capture adapter receives only capture options plus authenticated
+        // transport metadata. No screenshot is returned by this private tool.
+        let mut refresh_args = args.clone();
+        if let Some(object) = refresh_args.as_object_mut() {
+            for field in [
+                "capture_id",
+                "targets",
+                "hud_group",
+                "teaching_locale",
+                "teaching_message",
+                "presentation_id",
+                "text_only",
+                "presentation_version",
+                "drawing",
+            ] {
+                object.remove(field);
+            }
+        }
+        let refresh_started = Instant::now();
+        let refreshed =
+            super::super::get_desktop_state::GetDesktopStateTool::new(self.state.clone())
+                .invoke(refresh_args)
+                .await;
+        timings.refresh_ms = elapsed_ms(refresh_started);
+        if refreshed.is_error == Some(true) {
+            return Err("capture_unavailable");
+        }
+        if main_screen_size() != Some((width, height, scale)) {
+            return Err("geometry_changed");
+        }
+        admission_check()?;
+        let fresh_id = refreshed
+            .structured_content
+            .as_ref()
+            .and_then(|result| result.get("capture_id"))
+            .and_then(Value::as_str)
+            .ok_or("capture_unavailable")?
+            .to_owned();
+        let capture_id = captures
+            .parse_capture_id(&fresh_id)
+            .map_err(|_| "capture_unavailable")?;
+        let fresh = captures
+            .read_for_presentation(capture_id, &binding, Duration::from_secs(5))
+            .map_err(|_| "capture_unavailable")?;
+        let targets = input.targets.clone();
+        let comparison_started = Instant::now();
+        let (plan, report) = tokio::task::spawn_blocking(move || {
+            let report = super::super::guidance_capture::compare_captures(
+                &original,
+                &fresh,
+                &targets,
+                plan.as_ref(),
+            );
+            (plan, report)
+        })
+        .await
+        .map_err(|_| "capture_unavailable")?;
+        timings.comparison_ms = elapsed_ms(comparison_started);
+        if main_screen_size() != Some((width, height, scale)) {
+            return Err("geometry_changed");
+        }
+        let report = report?;
+        let matched = report.matched;
+        *comparison_diagnostics = Some(report.clone());
+        if !matched {
+            return Err("target_changed");
+        }
+        let check = || {
+            check_guidance(session, generation, deadline, &|| {
+                main_screen_size() == Some((width, height, scale))
+                    && captures.read_for_perception(capture_id, &binding).is_ok()
+                    && captures
+                        .read_for_perception(requested_capture_id, &binding)
+                        .is_ok()
+            })
+        };
+        check()?;
+        // Preserve the existing five-second admission bound after comparison:
+        // slow local checking must not turn an old refresh into a fresh cue.
+        captures
+            .read_for_presentation(capture_id, &binding, Duration::from_secs(5))
+            .map_err(|_| "capture_unavailable")?;
+        if let Some(plan) = plan.as_ref() {
+            *coordinate_trace = Some(json!({
+                "requested_capture_id":input.capture_id,"capture_id":fresh_id,
+                "screen_size_points":[width,height],"capture_size_px":[encoded.width(),encoded.height()],"display_scale":scale,
+                "targets_normalized":input.targets,
+                "planned_strokes":plan.strokes.iter().enumerate().map(|(index,stroke)|json!({"stroke_index":index,"cue_bounds_points":stroke.bounds})).collect::<Vec<_>>(),"painted_strokes":[]
+            }));
+        }
+        // Message and drawing belong to one immutable identity. Input/display
+        // fences are checked again after refresh and immediately before install.
+        let presentation_started = Instant::now();
+        *render_token = Some(
+            crate::cursor::overlay::present_companion_message(
+                session,
+                &input.hud_group,
+                input.teaching_locale,
+                input.teaching_message.clone(),
+            )
+            .await?,
+        );
+        message_shown.store(true, Ordering::Release);
+        check()?;
+        if let Some(plan) = plan.as_ref() {
+            self.play_scribble(
+                session,
+                generation,
+                start,
+                plan,
+                &check,
+                drawing_shown,
+                coordinate_trace,
+                strokes_presented,
+                operation_started,
+                timings,
+            )
+            .await?;
+        }
+        timings.presentation_ms = Some(elapsed_ms(presentation_started));
+        check()?;
+        {
+            let mut state = state().lock().unwrap();
+            if state.generation != generation || state.terminal.is_some() {
+                return Err(state.terminal.unwrap_or("explicit_stop"));
+            }
+            state.active = false;
+        }
+        Ok(())
+    }
+
+    async fn play_scribble(
+        &self,
+        session: &str,
+        generation: u64,
+        start: (f64, f64),
+        plan: &ScribblePlan,
+        check: &(impl Fn() -> Result<(), &'static str> + Sync),
+        drawing_shown: &AtomicBool,
+        coordinate_trace: &mut Option<Value>,
+        strokes_presented: &mut Vec<PresentedStroke>,
+        operation_started: Instant,
+        timings: &mut TeachingGuidanceTimings,
+    ) -> Result<(), &'static str> {
+        let reduced = crate::cursor::overlay::companion_reduced_motion();
+        let mut previous = start;
+        for (stroke_index, stroke) in plan.strokes.iter().enumerate() {
+            let first = stroke.path[0];
+            if stroke.approach_ms > 0 {
+                animate_phase(
+                    session,
+                    generation,
+                    if reduced { 0 } else { stroke.approach_ms },
+                    check,
+                    |p| (point_on_path(&[previous, first], p), vec![], 0.0, false),
+                    |_, _, _| Ok(()),
+                )
+                .await?;
+            }
+            let mut evidence = StepEvidence::default();
+            animate_phase(session,generation,if reduced {0}else{stroke.trace_ms},check,
+                |p|{let cue=reveal_path(&stroke.path,p);let pointer=cue.last().copied().unwrap_or(first);(pointer,cue,1.0,false)},
+                |p,at,geometry|{
+                    // Only geometry stamped by an installed nonempty drawing frame
+                    // may advance drawing evidence. Pointer frames cannot qualify.
+                    if let Some(geometry)=geometry {
+                        if has_visible_stroke(&reveal_path(&stroke.path,p)) {
+                            drawing_shown.store(true,Ordering::Release);
+                            timings.first_frame_ms.get_or_insert((at.saturating_duration_since(operation_started).as_millis() as u64).min(120000));
+                            if let Some(trace)=coordinate_trace.as_mut() {
+                                let painted=trace["painted_strokes"].as_array_mut().ok_or("invalid_request")?;
+                                let entry=json!({"stroke_index":stroke_index,"trace_progress":p,"geometry":geometry});
+                                if let Some(existing)=painted.iter_mut().find(|entry|entry["stroke_index"]==stroke_index) {*existing=entry;}else{painted.push(entry);}
+                            }
+                            if let Some(existing)=strokes_presented.iter_mut().find(|stroke|stroke.stroke_index==stroke_index) {existing.trace_progress=p;}
+                            else {strokes_presented.push(PresentedStroke {stroke_index,trace_progress:p,hold_ms_observed:0});}
+                            return evidence.record_trace(p,at);
+                        }
+                    }
+                    if p>=1.0 {Err("render_timeout")}else{Ok(())}
+                }).await?;
+            let hold_started = evidence.hold_started().ok_or("render_timeout")?;
+            let last = *stroke.path.last().ok_or("invalid_request")?;
+            while hold_started.elapsed() < Duration::from_millis(stroke.hold_ms) {
+                check()?;
+                tokio::time::sleep(Duration::from_millis(16)).await;
+            }
+            let (rendered_at, geometry) = present_frame(
+                session,
+                generation,
+                last,
+                stroke.path.clone(),
+                1.0,
+                false,
+                check,
+            )
+            .await?;
+            if geometry.is_none() {
+                return Err("render_timeout");
+            }
+            evidence.finish_hold(rendered_at, stroke.hold_ms, reduced)?;
+            let receipt = strokes_presented
+                .iter_mut()
+                .find(|entry| entry.stroke_index == stroke_index)
+                .ok_or("render_timeout")?;
+            receipt.hold_ms_observed = rendered_at
+                .saturating_duration_since(hold_started)
+                .as_millis() as u64;
+            animate_phase(
+                session,
+                generation,
+                if reduced { 0 } else { FADE_MS },
+                check,
+                |p| (last, stroke.path.clone(), (1.0 - p) as f32, false),
+                |_, _, _| Ok(()),
+            )
+            .await?;
+            present_frame(session, generation, last, vec![], 0.0, false, check).await?;
+            previous = last;
+        }
+        animate_phase(
+            session,
+            generation,
+            if reduced { 0 } else { RETURN_MS },
+            check,
+            |p| {
+                let target = cua_driver_core::cursor_sampler::read_cursor_position()
+                    .map(|(x, y)| (x + 24.0, y + 24.0))
+                    .unwrap_or(previous);
+                (point_on_path(&[previous, target], p), vec![], 0.0, false)
+            },
+            |_, _, _| Ok(()),
+        )
+        .await?;
+        let frame = {
+            let mut state = state().lock().unwrap();
+            let point = state.pointer.unwrap_or(previous);
+            state.create_frame(point, vec![], 0.0, false, true, false)
+        };
+        if !crate::cursor::overlay::present_guidance_frame(session, frame.clone()) {
+            return Err("transport_failed");
+        }
+        await_receipt(&frame, MAX_FRAME_GAP, check).await?;
+        Ok(())
+    }
+}
+
+fn snapshot_task(session: &str, epoch: &str, status: &str) -> ToolResult {
+    let state = state().lock().unwrap();
+    ToolResult::text(status).with_structured(json!({"status":status,"task_epoch":epoch,"following":state.owner.as_deref()==Some(session)&&state.following,"active":false}))
+}
+
+#[cfg(test)]
+mod companion_tests {
+    use super::*;
+    #[test]
+    fn companion_paired_ack_requires_visible_cue_and_cancellation_wins() {
+        assert!(!has_visible_stroke(&[]));
+        assert!(!has_visible_stroke(&[(1.0, 1.0)]));
+        assert!(!has_visible_stroke(&[(1.0, 1.0), (1.001, 1.0)]));
+        assert!(has_visible_stroke(&[(1.0, 1.0), (10.0, 1.0)]));
+        assert!(can_acknowledge_presentation(Ok(()), true, true, false));
+        assert!(can_acknowledge_presentation(
+            Err("user_takeover"),
+            true,
+            true,
+            false
+        ));
+        assert!(!can_acknowledge_presentation(
+            Err("user_takeover"),
+            true,
+            false,
+            false
+        ));
+        assert!(!can_acknowledge_presentation(
+            Err("explicit_stop"),
+            true,
+            true,
+            false
+        ));
+        assert!(!can_acknowledge_presentation(
+            Err("session_lost"),
+            true,
+            true,
+            false
+        ));
+        assert!(can_acknowledge_presentation(Ok(()), true, false, true));
+        assert!(!can_acknowledge_presentation(
+            Err("user_takeover"),
+            true,
+            false,
+            true
+        ));
+    }
+    #[test]
+    fn companion_cancel_fences_queued_frames_and_latches_task() {
+        let mut state = CompanionSession::default();
+        state.task_epoch = Some(uuid::Uuid::new_v4().to_string());
+        state.begin_sequence("teacher").unwrap();
+        let frame = state.create_frame((10.0, 10.0), vec![(1.0, 1.0)], 1.0, true, true, false);
+        assert!(frame.is_current());
+        assert!(state.cancel_sequence("teacher"));
+        assert!(!frame.is_current());
+        assert!(state.begin_sequence("teacher").is_err());
+        assert_eq!(state.terminal, Some("explicit_stop"));
+    }
+}
diff --git a/libs/cua-driver/rust/crates/platform-macos/src/tools/companion_hud_tools.rs b/libs/cua-driver/rust/crates/platform-macos/src/tools/companion_hud_tools.rs
