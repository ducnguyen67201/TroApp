+    #[test]
+    fn companion_hud_reads_only_installed_messages_for_its_owner() {
+        let mut state = HudState::default();
+        let mut snapshot = input(0);
+        let group = snapshot.group.clone();
+        snapshot.message = Some(cua_driver_contract::CompanionTeachingMessage {
+            lesson_id: group.clone(),
+            step_id: group.clone(),
+            sequence: 1,
+            kind: cua_driver_contract::TeachingMessageKind::Instruction,
+            text: "Open Chrome".into(),
+        });
+        assert!(state.update("host", snapshot));
+        assert!(state.read_message("host", &group).is_none());
+        state
+            .message_frame
+            .as_ref()
+            .unwrap()
+            .rendered
+            .store(true, std::sync::atomic::Ordering::Release);
+        assert!(state.read_message("host", &group).is_some());
+        assert!(state.read_message("foreign", &group).is_none());
+        state.retire("host", false);
+        assert!(state.read_message("host", &group).is_none());
+    }
+    #[test]
+    fn companion_hud_fences_ownership_sequence_and_foreign_binding() {
+        let mut state = HudState::default();
+        assert!(state.update("host", input(0)));
+        assert!(!state.update("foreign", input(1)));
+        assert!(!state.update("host", input(0)));
+        assert!(!state.bind("foreign", "another-group"));
+        assert!(state.bind("cursor", &input(0).group));
+        state.retire("cursor", false);
+        assert_eq!(state.owner.as_deref(), Some("host"));
+        state.retire("host", false);
+        assert!(state.owner.is_none());
+        assert_eq!(state.painter.phase, CompanionHudPhase::Idle);
+    }
+    #[test]
+    fn companion_hud_rolls_back_only_the_bound_failed_message() {
+        let mut state = HudState::default();
+        let group = input(0).group;
+        state.update("host", input(0));
+        state.bind("cursor", &group);
+        let message = cua_driver_contract::CompanionTeachingMessage {
+            lesson_id: group.clone(),
+            step_id: group.clone(),
+            sequence: 1,
+            kind: cua_driver_contract::TeachingMessageKind::Instruction,
+            text: "Click this control".into(),
+        };
+        assert!(state.present_message(
+            "cursor",
+            &group,
+            CompanionHudLocale::English,
+            message.clone()
+        ));
+        assert!(!state.clear_message("foreign", &group, &message));
+        let mut newer = message.clone();
+        newer.sequence = 2;
+        assert!(!state.clear_message("cursor", &group, &newer));
+        assert!(state.clear_message("cursor", &group, &message));
+        assert!(state.painter.message.message.is_none());
+    }
+    #[test]
+    fn companion_hud_bounds_binding_memory_and_reconnects_same_group() {
+        let mut state = HudState::default();
+        state.update("host", input(0));
+        for index in 0..20 {
+            state.bind(&format!("cursor-{index}"), &input(0).group);
+        }
+        assert_eq!(state.bindings.len(), 8);
+        state.retire("host", false);
+        assert!(state.update("new-host", input(0)));
+        assert_eq!(state.bindings.len(), 8);
+        state.expires = Some(Instant::now() - Duration::from_secs(1));
+        state.tick(0.3, false);
+        assert!(!state.painter.is_visible());
+    }
+}
