+//! Private regional comparison for the one version 3 presentation request.
+//! Pixels remain in the session-owned native registry; diagnostics are numeric.
+use cua_driver_contract::{
+    CaptureComparison, CueComparison, TeachingTarget, SCRIBBLE_STROKE_WIDTH_POINTS,
+};
+use cua_driver_core::capture_runtime::{CaptureTarget, PerceptionCapture};
+use cursor_overlay::scribble_renderer::{distance_to_path, ScribblePlan};
+use image::RgbImage;
+
+const STROKE_CONTEXT_POINTS: f64 = 32.0;
+fn pixel_bounds(bounds: [f64; 4], width: u32, height: u32, screen: (f64, f64)) -> [u32; 4] {
+    [
+        (bounds[0] / screen.0 * f64::from(width))
+            .floor()
+            .clamp(0.0, f64::from(width)) as u32,
+        (bounds[1] / screen.1 * f64::from(height))
+            .floor()
+            .clamp(0.0, f64::from(height)) as u32,
+        (bounds[2] / screen.0 * f64::from(width))
+            .ceil()
+            .clamp(0.0, f64::from(width)) as u32,
+        (bounds[3] / screen.1 * f64::from(height))
+            .ceil()
+            .clamp(0.0, f64::from(height)) as u32,
+    ]
+}
+fn compare_region(
+    original: &RgbImage,
+    fresh: &RgbImage,
+    region_index: usize,
+    kind: &str,
+    bounds: [u32; 4],
+    covered: impl Fn(u32, u32) -> bool,
+) -> (CueComparison, bool) {
+    let mut region = CueComparison {
+        region_index,
+        region_kind: kind.into(),
+        bounds_px: bounds,
+        compared_pixels: 0,
+        changed_pixels: 0,
+        changed_fraction: 0.0,
+        max_channel_delta: 0,
+        first_changed_pixel: None,
+    };
+    let mut significant_pixels = 0u64;
+    for y in bounds[1]..bounds[3] {
+        for x in bounds[0]..bounds[2] {
+            if !covered(x, y) {
+                continue;
+            }
+            region.compared_pixels += 1;
+            let before = original.get_pixel(x, y);
+            let after = fresh.get_pixel(x, y);
+            let delta = (0..3)
+                .map(|channel| before[channel].abs_diff(after[channel]))
+                .max()
+                .unwrap_or(0);
+            if delta > 8 {
+                significant_pixels += 1;
+            }
+            if before != after {
+                region.changed_pixels += 1;
+                region.first_changed_pixel.get_or_insert([x, y]);
+                region.max_channel_delta = region.max_channel_delta.max(delta);
+            }
+        }
+    }
+    if region.compared_pixels > 0 {
+        region.changed_fraction = region.changed_pixels as f64 / region.compared_pixels as f64;
+    }
+    // Preserve existing tolerance: small raster noise and <=0.5% significant pixels.
+    let matched = region.compared_pixels > 0
+        && significant_pixels as f64 / region.compared_pixels as f64 <= 0.005;
+    (region, matched)
+}
+/// Build a union mask around compiled segments, rather than comparing unrelated
+/// pixels inside the bounding rectangle of a long or curved stroke.
+fn stroke_mask(
+    path: &[(f64, f64)],
+    bounds: [u32; 4],
+    dimensions: (u32, u32),
+    screen: (f64, f64),
+) -> Vec<bool> {
+    let row_width = (bounds[2] - bounds[0]) as usize;
+    let mut mask = vec![false; row_width * (bounds[3] - bounds[1]) as usize];
+    let pad = STROKE_CONTEXT_POINTS + SCRIBBLE_STROKE_WIDTH_POINTS * 0.5;
+    for segment in path.windows(2) {
+        let local = pixel_bounds(
+            [
+                segment[0].0.min(segment[1].0) - pad,
+                segment[0].1.min(segment[1].1) - pad,
+                segment[0].0.max(segment[1].0) + pad,
+                segment[0].1.max(segment[1].1) + pad,
+            ],
+            dimensions.0,
+            dimensions.1,
+            screen,
+        );
+        for y in local[1].max(bounds[1])..local[3].min(bounds[3]) {
+            for x in local[0].max(bounds[0])..local[2].min(bounds[2]) {
+                let index = (y - bounds[1]) as usize * row_width + (x - bounds[0]) as usize;
+                if !mask[index] {
+                    let point = (
+                        (f64::from(x) + 0.5) * screen.0 / f64::from(dimensions.0),
+                        (f64::from(y) + 0.5) * screen.1 / f64::from(dimensions.1),
+                    );
+                    mask[index] = distance_to_path(point, segment) <= pad;
+                }
+            }
+        }
+    }
+    mask
+}
+fn compare_pixels(
+    original: &RgbImage,
+    fresh: &RgbImage,
+    targets: &[TeachingTarget],
+    plan: Option<&ScribblePlan>,
+    screen: (f64, f64),
+) -> CaptureComparison {
+    let (width, height) = original.dimensions();
+    let mut report = CaptureComparison {
+        matched: original.dimensions() == fresh.dimensions(),
+        capture_width_px: width,
+        capture_height_px: height,
+        regions: vec![],
+    };
+    if !report.matched {
+        return report;
+    }
+    for target in targets {
+        let bounds = pixel_bounds(
+            [
+                target.x * screen.0,
+                target.y * screen.1,
+                (target.x + target.width) * screen.0,
+                (target.y + target.height) * screen.1,
+            ],
+            width,
+            height,
+            screen,
+        );
+        let (region, matched) = compare_region(
+            original,
+            fresh,
+            report.regions.len(),
+            "target",
+            bounds,
+            |_, _| true,
+        );
+        report.matched &= matched;
+        report.regions.push(region);
+    }
+    if let Some(plan) = plan {
+        for stroke in &plan.strokes {
+            let mut bounds = stroke.bounds;
+            bounds[0] -= STROKE_CONTEXT_POINTS;
+            bounds[1] -= STROKE_CONTEXT_POINTS;
+            bounds[2] += STROKE_CONTEXT_POINTS;
+            bounds[3] += STROKE_CONTEXT_POINTS;
+            let bounds = pixel_bounds(bounds, width, height, screen);
+            let mask = stroke_mask(&stroke.path, bounds, (width, height), screen);
+            let row_width = (bounds[2] - bounds[0]) as usize;
+            let (region, matched) = compare_region(
+                original,
+                fresh,
+                report.regions.len(),
+                "stroke",
+                bounds,
+                |x, y| mask[(y - bounds[1]) as usize * row_width + (x - bounds[0]) as usize],
+            );
+            report.matched &= matched;
+            report.regions.push(region);
+        }
+    }
+    report
+}
+pub(super) fn compare_captures(
+    original: &PerceptionCapture,
+    fresh: &PerceptionCapture,
+    targets: &[TeachingTarget],
+    plan: Option<&ScribblePlan>,
+) -> Result<CaptureComparison, &'static str> {
+    if original.target() != &CaptureTarget::PrimaryDesktop
+        || fresh.target() != original.target()
+        || original.presentation_dimensions() != fresh.presentation_dimensions()
+        || original.encoded_dimensions() != fresh.encoded_dimensions()
+    {
+        return Err("geometry_changed");
+    }
+    let decode = |capture: &PerceptionCapture| {
+        image::load_from_memory_with_format(&capture.png_bytes(), image::ImageFormat::Png)
+            .map(|image| image.to_rgb8())
+            .map_err(|_| "capture_unavailable")
+    };
+    let dimensions = original.presentation_dimensions();
+    Ok(compare_pixels(
+        &decode(original)?,
+        &decode(fresh)?,
+        targets,
+        plan,
+        (
+            f64::from(dimensions.width()),
+            f64::from(dimensions.height()),
+        ),
+    ))
+}
