+    fn companion_observation_hashes_ignore_padding_and_alpha() {
+        let first = hash_tiles(&[0, 0, 0, 0, 255, 255, 255, 0, 99, 99, 99, 99], 2, 1, 12);
+        let second = hash_tiles(&[0, 0, 0, 255, 255, 255, 255, 255, 0, 0, 0, 0], 2, 1, 12);
+        assert_eq!(first, second);
+        assert!(hash_tiles(&[], 2, 1, 12).is_empty());
+    }
