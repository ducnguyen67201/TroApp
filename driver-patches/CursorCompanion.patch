+//! Independent presentation lease bound only to explicitly registered cursor sessions.
+use cua_driver_contract::{CompanionHudLocale, CompanionHudPhase, SetCompanionHudInput};
+use cursor_overlay::companion_hud::CompanionHudPainter;
+use std::{
+    collections::VecDeque,
+    sync::atomic::AtomicBool,
+    sync::Arc,
+    sync::{Mutex, OnceLock},
+    time::{Duration, Instant},
+};
+
+#[derive(Clone)]
+pub(super) struct MessageFrame {
+    pub message: cua_driver_contract::CompanionTeachingMessage,
+    pub rendered: Arc<AtomicBool>,
+}
+
+#[derive(Default)]
+pub(super) struct HudState {
+    owner: Option<String>,
+    group: Option<String>,
+    sequence: Option<u64>,
+    expires: Option<Instant>,
+    pub bindings: VecDeque<String>,
+    pub painter: CompanionHudPainter,
+    pub message_frame: Option<MessageFrame>,
+}
+pub(super) fn state() -> &'static Mutex<HudState> {
+    static STATE: OnceLock<Mutex<HudState>> = OnceLock::new();
+    STATE.get_or_init(|| Mutex::new(HudState::default()))
+}
+impl HudState {
+    pub fn update(&mut self, session: &str, input: SetCompanionHudInput) -> bool {
+        let live = self.expires.is_some_and(|expires| expires > Instant::now());
+        if live && self.owner.as_deref().is_some_and(|owner| owner != session) {
+            return false;
+        }
+        if self.owner.as_deref() == Some(session)
+            && self
+                .sequence
+                .is_some_and(|sequence| input.sequence <= sequence)
+        {
+            return false;
+        }
+        if self.group.as_deref() != Some(&input.group) {
+            self.bindings.clear();
+        }
+        self.owner = Some(session.into());
+        self.group = Some(input.group);
+        self.sequence = Some(input.sequence);
+        self.expires = Some(Instant::now() + Duration::from_secs(25));
+        if self.painter.message.message != input.message {
+            self.message_frame = input.message.clone().map(|message| MessageFrame {
+                message,
+                rendered: Arc::new(AtomicBool::new(false)),
+            });
+        }
+        self.painter.update_message(input.message);
+        self.painter.message.set_speaking(input.speaking_sequence);
+        self.painter
+            .update(input.phase, input.locale, input.level as f32);
+        true
+    }
+    pub fn present_message(
+        &mut self,
+        session: &str,
+        group: &str,
+        locale: CompanionHudLocale,
+        message: cua_driver_contract::CompanionTeachingMessage,
+    ) -> bool {
+        if self.group.as_deref() != Some(group)
+            || !self.bindings.iter().any(|key| key == session)
+            || !self.expires.is_some_and(|expires| expires > Instant::now())
+            || !message.validate()
+        {
+            return false;
+        }
+        self.painter.update_message(Some(message));
+        self.painter.update(CompanionHudPhase::Showing, locale, 0.0);
+        true
+    }
+    /// Roll back only this request's bubble, never a newer message from main.
+    pub fn clear_message(
+        &mut self,
+        session: &str,
+        group: &str,
+        message: &cua_driver_contract::CompanionTeachingMessage,
+    ) -> bool {
+        if self.group.as_deref() != Some(group)
+            || !self.bindings.iter().any(|key| key == session)
+            || self.painter.message.message.as_ref() != Some(message)
+        {
+            return false;
+        }
+        self.painter.update_message(None);
+        self.message_frame = None;
+        true
+    }
+    pub fn read_message(
+        &self,
+        session: &str,
+        group: &str,
+    ) -> Option<cua_driver_contract::CompanionTeachingMessage> {
+        if self.owner.as_deref() != Some(session)
+            || self.group.as_deref() != Some(group)
+            || !self.expires.is_some_and(|expires| expires > Instant::now())
+        {
+            return None;
+        }
+        self.message_frame
+            .as_ref()
+            .filter(|frame| {
+                frame.rendered.load(std::sync::atomic::Ordering::Acquire)
+                    && self.painter.message.message.as_ref() == Some(&frame.message)
+            })
+            .map(|frame| frame.message.clone())
+    }
+
+    pub fn bind(&mut self, session: &str, group: &str) -> bool {
+        if self.group.as_deref() != Some(group)
+            || !self.expires.is_some_and(|expires| expires > Instant::now())
+        {
+            return false;
+        }
+        self.bindings.retain(|key| key != session);
+        if self.bindings.len() >= 8 {
+            self.bindings.pop_front();
+        }
+        self.bindings.push_back(session.into());
+        true
+    }
+    pub fn tick(&mut self, dt: f32, reduced: bool) -> bool {
+        if self
+            .expires
+            .is_some_and(|expires| expires <= Instant::now())
+        {
+            self.owner = None;
+            self.sequence = None;
+            self.expires = None;
+            self.painter.update_message(None);
+            self.painter
+                .update(CompanionHudPhase::Idle, CompanionHudLocale::English, 0.0);
+        }
+        self.painter.tick(dt, reduced);
+        self.painter.is_visible()
+    }
+    pub fn retire(&mut self, key: &str, prefix: bool) {
+        let matches = |candidate: &str| {
+            if prefix {
+                candidate.starts_with(key)
+            } else {
+                candidate == key
+            }
+        };
+        self.bindings.retain(|candidate| !matches(candidate));
+        if self.owner.as_deref().is_some_and(matches) {
+            self.owner = None;
+            self.sequence = None;
+            self.expires = None;
+            self.painter.update_message(None);
+            self.painter
+                .update(CompanionHudPhase::Idle, CompanionHudLocale::English, 0.0);
+        }
+    }
+}
