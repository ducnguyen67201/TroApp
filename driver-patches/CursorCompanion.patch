+//! Compact host HUD in logical points. Never posts input or performs submission.
+use cua_driver_contract::{CompanionHudLocale as Locale, CompanionHudPhase as Phase};
+use fontdue::layout::{CoordinateSystem, Layout, LayoutSettings, TextStyle};
+use std::sync::OnceLock;
+use tiny_skia::{Color, FillRule, Paint, PathBuilder, Pixmap, PixmapPaint, Stroke, Transform};
+
+pub const HUD_WIDTH: f32 = 88.0;
+pub const HUD_HEIGHT: f32 = 22.0;
+#[derive(Default)]
+pub struct CompanionHudPainter {
+    pub phase: Phase,
+    pub locale: Locale,
+    pub level: f32,
+    previous: Phase,
+    transition: f32,
+    alpha: f32,
+    smoothed_level: f32,
+    time: f32,
+    above: bool,
+    pub message: super::companion_message::MessagePainter,
+}
+impl CompanionHudPainter {
+    pub fn update_message(
+        &mut self,
+        message: Option<cua_driver_contract::CompanionTeachingMessage>,
+    ) {
+        self.message.update(message);
+    }
+    pub fn update(&mut self, phase: Phase, locale: Locale, level: f32) {
+        if phase != self.phase {
+            self.previous = self.phase;
+            self.phase = phase;
+            self.transition = 0.0;
+        }
+        self.locale = locale;
+        self.level = if phase == Phase::Listening {
+            level.clamp(0.0, 1.0)
+        } else {
+            0.0
+        };
+    }
+    pub fn is_visible(&self) -> bool {
+        self.phase != Phase::Idle || self.alpha > 0.002 || self.message.message.is_some()
+    }
+    pub fn tick(&mut self, dt: f32, reduced_motion: bool) {
+        self.time += dt;
+        self.message.tick(dt, reduced_motion);
+        let duration = if reduced_motion { 0.04 } else { 0.18 };
+        self.transition = (self.transition + dt / duration).min(1.0);
+        let target = if self.phase == Phase::Idle { 0.0 } else { 1.0 };
+        self.alpha += (target - self.alpha).clamp(-dt / duration, dt / duration);
+        let smoothing = if self.level > self.smoothed_level {
+            0.055
+        } else {
+            0.18
+        };
+        self.smoothed_level += (self.level - self.smoothed_level) * (1.0 - (-dt / smoothing).exp());
+    }
+    pub fn paint(
+        &mut self,
+        image: &mut Pixmap,
+        cursor: (f32, f32),
+        scale: f32,
+        reduced_motion: bool,
+    ) {
+        if self.alpha <= 0.002 && self.message.message.is_none() {
+            return;
+        }
+        let width = if self.locale == Locale::Vietnamese {
+            98.0
+        } else {
+            HUD_WIDTH
+        };
+        let message_width = 220.0f32.min((image.width() as f32 / scale - 16.0).max(1.0));
+        let group_width = if self.message.message.is_some() {
+            message_width.max(width)
+        } else {
+            width
+        };
+        let x = (cursor.0 + 4.0 - width / 2.0).clamp(
+            8.0,
+            (image.width() as f32 / scale - group_width - 8.0).max(8.0),
+        );
+        let bottom = image.height() as f32 / scale;
+        if self.above {
+            if cursor.1 + 16.0 + HUD_HEIGHT < bottom - 16.0 {
+                self.above = false;
+            }
+        } else if cursor.1 + 16.0 + HUD_HEIGHT > bottom - 8.0 {
+            self.above = true;
+        }
+        let y = if self.above {
+            cursor.1 - HUD_HEIGHT - 6.0
+        } else {
+            cursor.1 + 16.0
+        };
+        let y = y.clamp(8.0, (bottom - HUD_HEIGHT - 8.0).max(8.0));
+        let message_height = self.message.height(message_width);
+        let message_y = if y + HUD_HEIGHT + 5.0 + message_height <= bottom - 8.0 {
+            y + HUD_HEIGHT + 5.0
+        } else {
+            (y - 5.0 - message_height).max(8.0)
+        };
+        self.message
+            .paint(image, (x, message_y), message_width, scale, reduced_motion);
+        let mut path = PathBuilder::new();
+        let r = HUD_HEIGHT / 2.0;
+        path.move_to(x + r, y);
+        path.line_to(x + width - r, y);
+        path.cubic_to(
+            x + width + r * 0.1,
+            y,
+            x + width + r * 0.1,
+            y + HUD_HEIGHT,
+            x + width - r,
+            y + HUD_HEIGHT,
+        );
+        path.line_to(x + r, y + HUD_HEIGHT);
+        path.cubic_to(x - r * 0.1, y + HUD_HEIGHT, x - r * 0.1, y, x + r, y);
+        path.close();
+        let Some(path) = path.finish() else {
+            return;
+        };
+        let transform = Transform::from_scale(scale, scale);
+        image.fill_path(
+            &path,
+            &paint([8, 13, 19], self.alpha * 0.95),
+            FillRule::Winding,
+            transform,
+            None,
+        );
+        image.stroke_path(
+            &path,
+            &paint([120, 188, 243], self.alpha * 0.7),
+            &Stroke {
+                width: 0.8,
+                ..Default::default()
+            },
+            transform,
+            None,
+        );
+        // Crossfade at the same anchor; fast lifecycle updates never delay work.
+        if self.phase != Phase::Idle && self.transition < 1.0 && self.previous != Phase::Idle {
+            self.paint_content(
+                image,
+                self.previous,
+                x,
+                y,
+                width,
+                scale,
+                self.alpha * (1.0 - self.transition),
+                reduced_motion,
+            );
+        }
+        if self.phase != Phase::Idle {
+            self.paint_content(
+                image,
+                self.phase,
+                x,
+                y,
+                width,
+                scale,
+                self.alpha * self.transition,
+                reduced_motion,
+            );
+        } else {
+            self.paint_content(
+                image,
+                self.previous,
+                x,
+                y,
+                width,
+                scale,
+                self.alpha,
+                reduced_motion,
+            );
+        }
+    }
+    fn paint_content(
+        &self,
+        image: &mut Pixmap,
+        phase: Phase,
+        x: f32,
+        y: f32,
+        width: f32,
+        scale: f32,
+        alpha: f32,
+        reduced: bool,
+    ) {
+        let transform = Transform::from_scale(scale, scale);
+        let blue = paint([138, 200, 250], alpha);
+        let icon_x = x + 7.0;
+        let mid = y + 11.0;
+        if matches!(phase, Phase::Thinking | Phase::Transcribing | Phase::Preparing | Phase::Checking | Phase::Submitting) {
+            for index in 0..3 {
+                let opacity = if reduced {
+                    1.0
+                } else {
+                    0.45 + 0.55 * ((self.time * 4.5 - index as f32 * 0.8).sin() + 1.0) / 2.0
+                };
+                if let Some(rect) =
+                    tiny_skia::Rect::from_xywh(icon_x + index as f32 * 3.0, mid - 1.0, 2.0, 2.0)
+                {
+                    image.fill_rect(
+                        rect,
+                        &paint([138, 200, 250], alpha * opacity),
+                        transform,
+                        None,
+                    );
+                }
+            }
+        } else {
+            let mut icon = PathBuilder::new();
+            if matches!(phase, Phase::Done | Phase::Checked | Phase::Submitted) {
+                icon.move_to(icon_x, mid);
+                icon.line_to(icon_x + 3.0, mid + 3.0);
+                icon.line_to(icon_x + 8.0, mid - 4.0);
+            } else {
+                icon.move_to(icon_x + 2.0, mid - 4.0);
+                icon.cubic_to(
+                    icon_x + 2.0,
+                    mid - 7.0,
+                    icon_x + 6.0,
+                    mid - 7.0,
+                    icon_x + 6.0,
+                    mid - 4.0,
+                );
+                icon.line_to(icon_x + 6.0, mid);
+                icon.cubic_to(
+                    icon_x + 6.0,
+                    mid + 3.0,
+                    icon_x + 2.0,
+                    mid + 3.0,
+                    icon_x + 2.0,
+                    mid,
+                );
+                icon.close();
+                icon.move_to(icon_x, mid);
+                icon.cubic_to(
+                    icon_x,
+                    mid + 6.0,
+                    icon_x + 8.0,
+                    mid + 6.0,
+                    icon_x + 8.0,
+                    mid,
+                );
+                icon.move_to(icon_x + 4.0, mid + 4.0);
+                icon.line_to(icon_x + 4.0, mid + 7.0);
+            }
+            if let Some(path) = icon.finish() {
+                image.stroke_path(
+                    &path,
+                    &blue,
+                    &Stroke {
+                        width: 1.0,
+                        ..Default::default()
+                    },
+                    transform,
+                    None,
+                );
+            }
+        }
+        if phase == Phase::Listening {
+            for index in 0..14 {
+                let weight = if reduced {
+                    1.0
+                } else {
+                    0.35 + 0.65 * ((self.time * 7.0 + index as f32 * 0.82).sin() + 1.0) / 2.0
+                };
+                let h = 2.0 + self.smoothed_level * 8.0 * weight;
+                if let Some(rect) =
+                    tiny_skia::Rect::from_xywh(x + 25.0 + index as f32 * 3.0, mid - h / 2.0, 1.8, h)
+                {
+                    image.fill_rect(rect, &blue, transform, None);
+                }
+            }
+        } else {
+            paint_text(
+                image,
+                label(phase, self.locale),
+                (x + 20.0, y),
+                width - 24.0,
+                scale,
+                alpha,
+            );
+        }
+    }
+}
+pub(super) fn paint(rgb: [u8; 3], alpha: f32) -> Paint<'static> {
+    let mut p = Paint::default();
+    p.set_color(Color::from_rgba8(
+        rgb[0],
+        rgb[1],
+        rgb[2],
+        (255.0 * alpha.clamp(0.0, 1.0)) as u8,
+    ));
+    p
+}
+fn label(phase: Phase, locale: Locale) -> &'static str {
+    if locale == Locale::Vietnamese {
+        return match phase {
+            Phase::Idle => "",
+            Phase::Preparing => "Chuẩn bị…",
+            Phase::Listening => "Đang nghe",
+            Phase::Transcribing => "Chuyển lời…",
+            Phase::Sending => "Đang gửi…",
+            Phase::Checking => "Đang kiểm tra…",
+            Phase::Submitting => "Đang nộp…",
+            Phase::Checked => "Có phản hồi",
+            Phase::Submitted => "Đã nộp bài",
+            Phase::Thinking => "Suy nghĩ…",
+            Phase::Showing => "Hướng dẫn…",
+            Phase::Waiting => "Chờ bạn…",
+            Phase::Working => "Đang làm…",
+            Phase::Done => "Xong",
+            Phase::Canceled => "Đã hủy",
+            Phase::Error => "Có lỗi",
+            Phase::DailyLimit => "Hết lượt hôm nay",
+            Phase::NeedsInput => "Cần chỉ dẫn",
+        };
+    }
+    match phase {
+        Phase::Idle => "",
+        Phase::Preparing => "Preparing…",
+        Phase::Listening => "Listening",
+        Phase::Transcribing => "Transcribing…",
+        Phase::Sending => "Sending…",
+        Phase::Checking => "Checking work…",
+        Phase::Submitting => "Submitting…",
+        Phase::Checked => "Feedback ready",
+        Phase::Submitted => "Hand-in saved",
+        Phase::Thinking => "Thinking…",
+        Phase::Showing => "Showing…",
+        Phase::Waiting => "Waiting…",
+        Phase::Working => "Working…",
+        Phase::Done => "Done",
+        Phase::Canceled => "Canceled",
+        Phase::Error => "Try again",
+        Phase::DailyLimit => "Daily limit",
+        Phase::NeedsInput => "Needs input",
+    }
+}
+fn paint_text(
+    image: &mut Pixmap,
+    text: &str,
+    origin: (f32, f32),
+    width: f32,
+    scale: f32,
+    alpha: f32,
+) {
+    static FONT: OnceLock<Option<fontdue::Font>> = OnceLock::new();
+    let Some(font) = FONT.get_or_init(|| {
+        fontdue::Font::from_bytes(
+            include_bytes!("../assets/Inter.ttf") as &[u8],
+            fontdue::FontSettings::default(),
+        )
+        .ok()
+    }) else {
+        return;
+    };
+    let mut layout = Layout::new(CoordinateSystem::PositiveYDown);
+    layout.reset(&LayoutSettings::default());
+    layout.append(&[font], &TextStyle::new(text, 9.5 * scale, 0));
+    let text_width = layout
+        .glyphs()
+        .iter()
+        .map(|glyph| glyph.x + glyph.width as f32)
+        .fold(0.0, f32::max);
+    let factor = (width * scale / text_width.max(1.0)).min(1.0);
+    if factor < 1.0 {
+        layout.reset(&LayoutSettings::default());
+        layout.append(&[font], &TextStyle::new(text, 9.5 * scale * factor, 0));
+    }
+    let text_width = layout
+        .glyphs()
+        .iter()
+        .map(|glyph| glyph.x + glyph.width as f32)
+        .fold(0.0, f32::max);
+    let min_y = layout
+        .glyphs()
+        .iter()
+        .map(|g| g.y)
+        .fold(f32::INFINITY, f32::min);
+    let max_y = layout
+        .glyphs()
+        .iter()
+        .map(|g| g.y + g.height as f32)
+        .fold(0.0, f32::max);
+    for glyph in layout.glyphs() {
+        let (metrics, bitmap) = font.rasterize_config(glyph.key);
+        let Some(mut pm) = Pixmap::new(metrics.width as u32, metrics.height as u32) else {
+            continue;
+        };
+        for (pixel, coverage) in pm.data_mut().chunks_exact_mut(4).zip(bitmap) {
+            let a = coverage as f32 * alpha;
+            pixel.copy_from_slice(&[
+                (138.0 / 255.0 * a) as u8,
+                (200.0 / 255.0 * a) as u8,
+                (250.0 / 255.0 * a) as u8,
+                a as u8,
+            ]);
+        }
+        image.draw_pixmap(
+            (origin.0 * scale + (width * scale - text_width) / 2.0 + glyph.x).round() as i32,
+            (origin.1 * scale + (HUD_HEIGHT * scale - (max_y - min_y)) / 2.0 - min_y + glyph.y)
+                .round() as i32,
+            pm.as_ref(),
+            &PixmapPaint::default(),
+            Transform::identity(),
+            None,
+        );
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn companion_hud_renders_clamped_retina_and_fades() {
+        for scale in [1.0, 2.0] {
+            let mut pm = Pixmap::new((200.0 * scale) as u32, (100.0 * scale) as u32).unwrap();
+            let mut painter = CompanionHudPainter::default();
+            painter.update(Phase::Thinking, Locale::English, 0.0);
+            painter.tick(0.2, false);
+            painter.paint(&mut pm, (195.0, 95.0), scale, false);
+            assert!(painter.above);
+            assert!(pm.data().chunks_exact(4).any(|pixel| pixel[3] > 0));
+            painter.update(Phase::Idle, Locale::English, 0.0);
+            painter.tick(0.3, false);
+            assert!(!painter.is_visible());
+        }
+    }
+    #[test]
+    fn companion_hud_practice_labels_do_not_claim_a_passing_result() {
+        assert_eq!(label(Phase::Checking, Locale::English), "Checking work…");
+        assert_eq!(label(Phase::Submitting, Locale::Vietnamese), "Đang nộp…");
+        assert_eq!(label(Phase::Checked, Locale::English), "Feedback ready");
+        assert_eq!(label(Phase::Submitted, Locale::Vietnamese), "Đã nộp bài");
+        for phase in [Phase::Checking, Phase::Submitting, Phase::Checked, Phase::Submitted] {
+            let mut painter = CompanionHudPainter::default();
+            let mut pm = Pixmap::new(240, 100).unwrap();
+            painter.update(phase, Locale::English, 0.0);
+            painter.tick(0.2, false);
+            painter.paint(&mut pm, (80.0, 60.0), 1.0, false);
+            assert!(pm.data().chunks_exact(4).any(|pixel| pixel[3] > 0));
+        }
+    }
+    #[test]
+    fn companion_hud_silence_stays_flat_and_levels_decay() {
+        let mut painter = CompanionHudPainter::default();
+        painter.update(Phase::Listening, Locale::English, 0.0);
+        painter.tick(0.2, false);
+        assert_eq!(painter.smoothed_level, 0.0);
+        painter.update(Phase::Listening, Locale::English, 1.0);
+        painter.tick(0.1, false);
+        assert!(painter.smoothed_level > 0.5);
+        painter.update(Phase::Transcribing, Locale::English, 0.0);
+        painter.tick(0.3, false);
+        assert!(painter.smoothed_level < 0.2);
+    }
+}
+
+/// Retain the same companion at handoff while no bound Tro cursor is visible.
+pub fn paint_fallback_pointer(image: &mut Pixmap, cursor: (f32, f32), scale: f32) {
+    crate::companion_appearance::paint_companion_pointer(
+        image,
+        (cursor.0 * scale, cursor.1 * scale),
+        scale,
+        1.0,
+        false,
+        None,
+    );
+}
