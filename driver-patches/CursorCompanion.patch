+//! Host-only cue renewal. Pixels stay in the session-owned native capture registry.
+use super::{get_desktop_state::GetDesktopStateTool, ToolState};
+use async_trait::async_trait;
+use cua_driver_contract::{
+    CaptureComparison, CompanionPoint, CompanionStep, CueComparison,
+    RefreshCursorGuidanceCaptureInput,
+};
+use cua_driver_core::{
+    capture_runtime::{CaptureTarget, PerceptionCapture},
+    protocol::ToolResult,
+    tool::{Tool, ToolDef, ToolRegistry},
+    tool_args::parse_typed_input,
+};
+use image::RgbImage;
+use serde_json::{json, Value};
+use std::sync::Arc;
+
+struct GuidanceCaptureTool {
+    state: Arc<ToolState>,
+    definition: ToolDef,
+}
+
+fn comparison_result(
+    capture_id: Option<String>,
+    reason: &str,
+    diagnostics: Option<CaptureComparison>,
+) -> ToolResult {
+    let mut result = json!({
+        "matched": capture_id.is_some(), "capture_id": capture_id, "reason": reason,
+    });
+    if let Some(diagnostics) = diagnostics {
+        result["diagnostics"] = json!(diagnostics);
+    }
+    ToolResult::text("guidance_capture_comparison").with_structured(result)
+}
+
+/// Include the complete cue/path and 32 screen points of surrounding context.
+/// A region comparison is geometric evidence only, never semantic goal verification.
+fn read_cue_bounds(step: &CompanionStep, width: f64, height: f64) -> (f64, f64, f64, f64) {
+    let pad_x = 32.0 / width;
+    let pad_y = 32.0 / height;
+    let around = |a: &CompanionPoint, b: &CompanionPoint, rx: f64, ry: f64| {
+        (
+            a.x.min(b.x) - rx - pad_x,
+            a.y.min(b.y) - ry - pad_y,
+            a.x.max(b.x) + rx + pad_x,
+            a.y.max(b.y) + ry + pad_y,
+        )
+    };
+    match step {
+        CompanionStep::Circle { center, radius, .. } => around(
+            center,
+            center,
+            radius * width.min(height) / width,
+            radius * width.min(height) / height,
+        ),
+        CompanionStep::Click { at, .. } => around(at, at, 0.0, 0.0),
+        CompanionStep::Arrow { from, to, .. }
+        | CompanionStep::Move { from, to, .. }
+        | CompanionStep::Drag { from, to, .. } => around(from, to, 0.0, 0.0),
+        CompanionStep::Selection { from, to, .. } => (
+            from.x.min(to.x),
+            from.y.min(to.y),
+            from.x.max(to.x),
+            from.y.max(to.y),
+        ),
+    }
+}
+
+/// Complete regional counts explain strict rejection without exposing pixel colors.
+/// This runs only for requested playback, never in the idle observer.
+fn compare_cue_pixels(
+    original: &RgbImage,
+    fresh: &RgbImage,
+    steps: &[CompanionStep],
+    screen: (f64, f64),
+) -> CaptureComparison {
+    let (width, height) = original.dimensions();
+    let mut report = CaptureComparison {
+        matched: original.dimensions() == fresh.dimensions() && !steps.is_empty(),
+        capture_width_px: width,
+        capture_height_px: height,
+        regions: Vec::with_capacity(steps.len()),
+    };
+    if !report.matched {
+        return report;
+    }
+    for (step_index, step) in steps.iter().enumerate() {
+        let (left, top, right, bottom) = read_cue_bounds(step, screen.0, screen.1);
+        let x0 = (left.clamp(0.0, 1.0) * f64::from(width)).floor() as u32;
+        let y0 = (top.clamp(0.0, 1.0) * f64::from(height)).floor() as u32;
+        let x1 = (right.clamp(0.0, 1.0) * f64::from(width)).ceil() as u32;
+        let y1 = (bottom.clamp(0.0, 1.0) * f64::from(height)).ceil() as u32;
+        let step_kind = match step {
+            CompanionStep::Circle { .. } => "circle",
+            CompanionStep::Click { .. } => "click",
+            CompanionStep::Arrow { .. } => "arrow",
+            CompanionStep::Move { .. } => "move",
+            CompanionStep::Drag { .. } => "drag",
+            CompanionStep::Selection { .. } => "selection",
+        };
+        let mut region = CueComparison {
+            step_index,
+            step_kind: step_kind.to_owned(),
+            bounds_px: [x0, y0, x1, y1],
+            compared_pixels: u64::from(x1.saturating_sub(x0)) * u64::from(y1.saturating_sub(y0)),
+            changed_pixels: 0,
+            changed_fraction: 0.0,
+            max_channel_delta: 0,
+            first_changed_pixel: None,
+        };
+        let mut significant_pixels = 0u64;
+        for y in y0..y1 {
+            for x in x0..x1 {
+                let before = original.get_pixel(x, y);
+                let after = fresh.get_pixel(x, y);
+                let delta = (0..3)
+                    .map(|channel| before[channel].abs_diff(after[channel]))
+                    .max()
+                    .unwrap_or(0);
+                if delta > 8 {
+                    significant_pixels += 1;
+                }
+                if before != after {
+                    region.changed_pixels += 1;
+                    region.first_changed_pixel.get_or_insert([x, y]);
+                    for channel in 0..3 {
+                        region.max_channel_delta = region
+                            .max_channel_delta
+                            .max(before[channel].abs_diff(after[channel]));
+                    }
+                }
+            }
+        }
+        if region.compared_pixels > 0 {
+            region.changed_fraction = region.changed_pixels as f64 / region.compared_pixels as f64;
+        }
+        // Fixture-calibrated conservative starting policy: ignore low-amplitude
+        // raster noise and at most 0.5% significant pixels. This is approximate
+        // target validity, never identity, input acceptance or semantic success.
+        report.matched &= region.compared_pixels > 0
+            && significant_pixels as f64 / region.compared_pixels as f64 <= 0.005;
+        report.regions.push(region);
+    }
+    report
+}
+
+#[cfg(test)]
+fn matches_cue_pixels(
+    original: &RgbImage,
+    fresh: &RgbImage,
+    steps: &[CompanionStep],
+    screen: (f64, f64),
+) -> bool {
+    compare_cue_pixels(original, fresh, steps, screen).matched
+}
+
+fn compare_captures(
+    original: &PerceptionCapture,
+    fresh: &PerceptionCapture,
+    steps: &[CompanionStep],
+) -> Result<CaptureComparison, &'static str> {
+    if original.target() != &CaptureTarget::PrimaryDesktop
+        || fresh.target() != original.target()
+        || original.presentation_dimensions() != fresh.presentation_dimensions()
+        || original.encoded_dimensions() != fresh.encoded_dimensions()
+    {
+        return Err("geometry_changed");
+    }
+    let decode = |capture: &PerceptionCapture| {
+        image::load_from_memory_with_format(&capture.png_bytes(), image::ImageFormat::Png)
+            .map(|image| image.to_rgb8())
+            .map_err(|_| "capture_decode_failed")
+    };
+    let dimensions = original.presentation_dimensions();
+    Ok(compare_cue_pixels(
+        &decode(original)?,
+        &decode(fresh)?,
+        steps,
+        (
+            f64::from(dimensions.width()),
+            f64::from(dimensions.height()),
+        ),
+    ))
+}
+
+#[async_trait]
+impl Tool for GuidanceCaptureTool {
+    fn def(&self) -> &ToolDef {
+        &self.definition
+    }
+
+    async fn invoke(&self, args: Value) -> ToolResult {
+        let input = match parse_typed_input::<RefreshCursorGuidanceCaptureInput>(
+            "refresh_cursor_guidance_capture",
+            args.clone(),
+        ) {
+            Ok(input) => input,
+            Err(error) => return error,
+        };
+        let captures = self.state.companion_captures.clone();
+        let binding = match captures.binding_from_args(&args) {
+            Ok(binding) => binding,
+            Err(_) => return ToolResult::error("capture_binding_failed"),
+        };
+        let original = match captures
+            .parse_capture_id(&input.capture_id)
+            .ok()
+            .and_then(|id| captures.read_for_perception(id, &binding).ok())
+        {
+            Some(capture) => capture,
+            None => return comparison_result(None, "capture_unavailable", None),
+        };
+        // Reuse the primary capture adapter. No file writes or model-visible image result.
+        let mut capture_args = args;
+        if let Some(object) = capture_args.as_object_mut() {
+            object.remove("capture_id");
+            object.remove("steps");
+            object.remove("targets");
+        }
+        let fresh_result = GetDesktopStateTool::new(self.state.clone())
+            .invoke(capture_args)
+            .await;
+        if fresh_result.is_error == Some(true) {
+            return ToolResult::error("capture_refresh_failed");
+        }
+        let fresh_id = fresh_result
+            .structured_content
+            .as_ref()
+            .and_then(|value| value.get("capture_id"))
+            .and_then(Value::as_str)
+            .map(str::to_owned);
+        let fresh = fresh_id
+            .as_ref()
+            .and_then(|id| captures.parse_capture_id(id).ok())
+            .and_then(|id| captures.read_for_perception(id, &binding).ok());
+        let Some(fresh) = fresh else {
+            return ToolResult::error("capture_refresh_failed");
+        };
+        // New teaching validates only host-derived live controls/endpoints.
+        // Legacy clients retain their original cue geometry contract.
+        let steps = if input.targets.is_empty() {
+            input.steps
+        } else {
+            input
+                .targets
+                .into_iter()
+                .map(|target| CompanionStep::Selection {
+                    from: CompanionPoint {
+                        x: target.x,
+                        y: target.y,
+                    },
+                    to: CompanionPoint {
+                        x: target.x + target.width,
+                        y: target.y + target.height,
+                    },
+                    duration_ms: 400,
+                    hold_ms: Some(700),
+                })
+                .collect()
+        };
+        match tokio::task::spawn_blocking(move || compare_captures(&original, &fresh, &steps)).await
+        {
+            Ok(Ok(report)) => {
+                if report.matched {
+                    comparison_result(fresh_id, "target_unchanged", Some(report))
+                } else {
+                    comparison_result(None, "target_changed", Some(report))
+                }
+            }
+            Ok(Err("geometry_changed")) => comparison_result(None, "geometry_changed", None),
+            _ => ToolResult::error("capture_decode_failed"),
+        }
+    }
+}
+
+pub(super) fn register_tool(registry: &mut ToolRegistry, state: Arc<ToolState>) {
+    let contract = cua_driver_contract::tool_contract("refresh_cursor_guidance_capture")
+        .expect("guidance refresh contract");
+    registry.register(Box::new(GuidanceCaptureTool {
+        state,
+        definition: ToolDef {
+            name: contract.name.clone(),
+            description: contract.description.clone(),
+            input_schema: contract.input_schema.clone(),
+            read_only: true,
+            destructive: false,
+            idempotent: false,
+            open_world: false,
+        },
+    }));
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn click() -> CompanionStep {
+        CompanionStep::Click {
+            at: CompanionPoint { x: 0.5, y: 0.5 },
+            duration_ms: 300,
+            hold_ms: None,
+        }
+    }
+    #[test]
+    fn companion_capture_reports_exact_failure_region_without_pixels() {
+        let original = RgbImage::new(200, 100);
+        let mut fresh = original.clone();
+        fresh.put_pixel(100, 50, image::Rgb([255, 0, 0]));
+        fresh.put_pixel(101, 50, image::Rgb([20, 0, 0]));
+        let report = compare_cue_pixels(&original, &fresh, &[click()], (1000.0, 500.0));
+        assert!(!report.matched);
+        assert_eq!(report.regions.len(), 1);
+        let region = &report.regions[0];
+        assert_eq!(region.step_index, 0);
+        assert_eq!(region.step_kind, "click");
+        assert_eq!(region.changed_pixels, 2);
+        assert_eq!(region.first_changed_pixel, Some([100, 50]));
+        assert_eq!(region.max_channel_delta, 255);
+        assert!(region.changed_fraction > 0.0 && region.changed_fraction < 1.0);
+        let output = comparison_result(None, "target_changed", Some(report))
+            .structured_content
+            .unwrap();
+        assert_eq!(output["diagnostics"]["regions"][0]["changed_pixels"], 2);
+        assert!(output.get("pixels").is_none());
+    }
+    #[test]
+    fn companion_capture_accepts_unrelated_animation_and_rejects_target_changes() {
+        let original = RgbImage::new(200, 100);
+        let mut fresh = original.clone();
+        fresh.put_pixel(0, 0, image::Rgb([255, 0, 0]));
+        assert!(matches_cue_pixels(
+            &original,
+            &fresh,
+            &[click()],
+            (1000.0, 500.0)
+        ));
+        fresh.put_pixel(100, 50, image::Rgb([255, 0, 0]));
+        assert!(!matches_cue_pixels(
+            &original,
+            &fresh,
+            &[click()],
+            (1000.0, 500.0)
+        ));
+        assert!(!matches_cue_pixels(
+            &original,
+            &RgbImage::new(201, 100),
+            &[click()],
+            (1000.0, 500.0)
+        ));
+    }
+    #[test]
+    fn companion_target_bounds_ignore_travel_animation_but_reject_endpoint_loss() {
+        let original = RgbImage::new(200, 100);
+        let mut fresh = original.clone();
+        let target = CompanionStep::Selection {
+            from: CompanionPoint { x: 0.1, y: 0.2 },
+            to: CompanionPoint { x: 0.2, y: 0.3 },
+            duration_ms: 400,
+            hold_ms: Some(700),
+        };
+        // Noise is tolerated within the actual control; animation outside it is ignored.
+        for y in 20..30 {
+            for x in 20..40 {
+                fresh.put_pixel(x, y, image::Rgb([8, 8, 8]));
+            }
+        }
+        fresh.put_pixel(100, 50, image::Rgb([255, 255, 255]));
+        assert!(matches_cue_pixels(
+            &original,
+            &fresh,
+            &[target.clone()],
+            (1000.0, 500.0)
+        ));
+        for y in 20..30 {
+            for x in 20..40 {
+                fresh.put_pixel(x, y, image::Rgb([255, 255, 255]));
+            }
+        }
+        assert!(!matches_cue_pixels(
+            &original,
+            &fresh,
+            &[target],
+            (1000.0, 500.0)
+        ));
+    }
+}
