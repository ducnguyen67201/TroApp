+const MAX_WIDTH: usize = 768;
+const TILE: usize = 32;
+const LEASE: Duration = Duration::from_secs(60);
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct WatchInput {
+    watch_id: String,
+    #[serde(default)]
+    input_only: bool,
+    session: Option<String>,
+    #[serde(default)]
+    regions: Option<Vec<ObservationRegion>>,
+}
+
+#[derive(Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ObservationRegion {
+    x: f64,
+    y: f64,
+    width: f64,
+    height: f64,
+}
+impl ObservationRegion {
+    fn valid(&self) -> bool {
+        [self.x, self.y, self.width, self.height]
+            .iter()
+            .all(|v| v.is_finite())
+            && self.x >= 0.0
+            && self.y >= 0.0
+            && self.width > 0.0
+            && self.height > 0.0
+            && self.x + self.width <= 1.0
+            && self.y + self.height <= 1.0
+    }
+}
+struct Changes {
+    input_only: bool,
+    hashes: Vec<u64>,
+    regions: Vec<ObservationRegion>,
+    relevant_revision: u64,
+    columns: usize,
+    revision: u64,
+    fraction: f64,
+    ready: bool,
+    failed: bool,
+    lease_until: Instant,
+    last_input: u64,
+    input_at: Instant,
+}
+struct Watch {
+    id: String,
+    owner: String,
+    width: usize,
+    height: usize,
+    changes: Arc<Mutex<Changes>>,
+}
+// Lesson IDs survive resource pauses. Instance identity fences an old stream
+// from a replacement watch that legitimately reuses the same lesson ID.
+fn owns_stream(watch: &Watch, id: &str, changes: &Arc<Mutex<Changes>>) -> bool {
+    watch.id == id && Arc::ptr_eq(&watch.changes, changes)
+}
+fn watches() -> &'static Mutex<Option<Watch>> {
+    static WATCH: OnceLock<Mutex<Option<Watch>>> = OnceLock::new();
+    WATCH.get_or_init(|| Mutex::new(None))
+}
+fn read_primary_dimensions() -> Option<(usize, usize)> {
+    let (width, height, _) = main_screen_size()?;
+    let width = usize::try_from(width).ok()?;
+    let height = usize::try_from(height).ok()?;
+    if width == 0 || height == 0 {
+        return None;
+    }
+    Some((width, height))
+}
+fn input_revision() -> u64 {
+    super::companion_tools::read_user_input_counters()
+        .iter()
+        .map(|n| u64::from(*n))
+        .sum()
+}
+fn buttons_down() -> bool {
+    #[link(name = "ApplicationServices", kind = "framework")]
+    extern "C" {
+        fn CGEventSourceButtonState(state: i32, button: u32) -> bool;
+    }
+    // Read physical input only; observation never posts events.
+    unsafe { CGEventSourceButtonState(1, 0) || CGEventSourceButtonState(1, 1) }
+}
+fn update_input(changes: &mut Changes) {
+    let revision = input_revision();
+    if changes.last_input != revision {
+        changes.last_input = revision;
+        changes.input_at = Instant::now();
+    }
+}
+fn describe(watch: &Watch) -> Value {
+    let mut changes = watch.changes.lock().unwrap();
+    update_input(&mut changes);
+    let (width, height) = if changes.input_only {
+        read_primary_dimensions().unwrap_or((watch.width, watch.height))
+    } else {
+        (watch.width, watch.height)
+    };
+    json!({"watch_id":watch.id,"input_only":changes.input_only,"screen_revision":changes.revision,
+        "input_revision":changes.last_input,"relevant_revision":changes.relevant_revision,"ready":changes.ready,
+        "changed_fraction":changes.fraction,"quiet_ms":changes.input_at.elapsed().as_millis() as u64,
+        "buttons_down":buttons_down(),"screen_width":width,"screen_height":height})
+}
+/// Bracket the screenshot from its starting revision. Later changes stay pending,
+/// including a frame callback racing the full-resolution capture.
+pub(super) fn read_capture_observation(session: &str) -> Option<Value> {
+    watches()
+        .lock()
+        .unwrap()
+        .as_ref()
+        .filter(|w| w.owner == session)
+        .map(describe)
+}
+pub(super) fn retire_session(session: &str) {
+    let mut watches = watches().lock().unwrap();
+    if watches.as_ref().is_some_and(|w| w.owner == session) {
+        *watches = None;
+    }
+}
+pub(super) fn retire_runtime(prefix: &str) {
+    let mut watches = watches().lock().unwrap();
+    if watches
+        .as_ref()
+        .is_some_and(|w| w.owner.starts_with(prefix))
+    {
+        *watches = None;
+    }
+}
