+//! Host-only content-free presentation vocabulary; no desktop action semantics.
+use crate::{Platform, SchemaMode, ToolAnnotations, ToolContract, ToolInput, ToolOutput};
+use schemars::JsonSchema;
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, JsonSchema, Default)]
+#[serde(rename_all = "snake_case")]
+pub enum CompanionHudPhase {
+    #[default]
+    Idle,
+    Preparing,
+    Listening,
+    Transcribing,
+    Sending,
+    Checking,
+    Submitting,
+    Checked,
+    Submitted,
+    Thinking,
+    Showing,
+    Waiting,
+    Working,
+    Done,
+    Canceled,
+    Error,
+    DailyLimit,
+    NeedsInput,
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, JsonSchema, Default)]
+pub enum CompanionHudLocale {
+    #[default]
+    #[serde(rename = "en")]
+    English,
+    #[serde(rename = "vi")]
+    Vietnamese,
+}
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
+#[serde(rename_all = "snake_case")]
+pub enum TeachingMessageKind {
+    Instruction,
+    Question,
+    Completion,
+}
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct CompanionTeachingMessage {
+    pub lesson_id: String,
+    pub step_id: String,
+    pub sequence: u64,
+    pub kind: TeachingMessageKind,
+    pub text: String,
+}
+impl CompanionTeachingMessage {
+    pub fn validate(&self) -> bool {
+        valid_group(&self.lesson_id)
+            && valid_group(&self.step_id)
+            && self.sequence <= 9_007_199_254_740_991
+            && !self.text.trim().is_empty()
+            && self.text.chars().count() <= 600
+            && !self.text.contains('\0')
+    }
+}
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct SetCompanionHudInput {
+    pub session: Option<String>,
+    pub group: String,
+    pub sequence: u64,
+    pub phase: CompanionHudPhase,
+    pub locale: CompanionHudLocale,
+    pub level: f64,
+    #[serde(default)]
+    pub message: Option<CompanionTeachingMessage>,
+    #[serde(default, rename = "speakingSequence")]
+    pub speaking_sequence: Option<u64>,
+}
+impl ToolInput for SetCompanionHudInput {
+    const TOOL_NAME: &'static str = "set_companion_hud";
+    fn validate(&self) -> Result<(), String> {
+        if !valid_group(&self.group)
+            || self.message.as_ref().is_some_and(|m| !m.validate())
+            || !self.level.is_finite()
+            || !(0.0..=1.0).contains(&self.level)
+            || self.sequence > 9_007_199_254_740_991
+        {
+            return Err("Invalid bounded HUD snapshot.".into());
+        }
+        Ok(())
+    }
+}
+/// One native presentation identity; serialized integers stay exact in TypeScript.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct CompanionRenderToken {
+    pub owner_epoch: String,
+    pub revision: u64,
+    pub render_id: String,
+}
+impl CompanionRenderToken {
+    fn validate(&self) -> bool {
+        valid_group(&self.owner_epoch)
+            && valid_group(&self.render_id)
+            && self.revision <= 9_007_199_254_740_991
+    }
+}
+
+/// Private host commands separate message delivery from lease and animation state.
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(tag = "kind", rename_all = "snake_case", deny_unknown_fields)]
+pub enum CompanionHudCommand {
+    RenewLease,
+    UpdateAppearance {
+        phase: CompanionHudPhase,
+        locale: CompanionHudLocale,
+        level: f64,
+        #[serde(rename = "speakingSequence")]
+        speaking_sequence: Option<u64>,
+    },
+    PresentMessage {
+        locale: CompanionHudLocale,
+        message: CompanionTeachingMessage,
+    },
+    ClearMessage {
+        #[serde(rename = "expectedToken")]
+        expected_token: CompanionRenderToken,
+    },
+}
+#[derive(Debug, Clone, Serialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct SendCompanionHudCommandInput {
+    pub session: Option<String>,
+    pub group: String,
+    pub sequence: u64,
+    #[serde(flatten)]
+    pub command: CompanionHudCommand,
+}
+impl<'de> Deserialize<'de> for SendCompanionHudCommandInput {
+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        // Serde's flattened unit variant can discard unknown fields. Check the complete
+        // object before decoding it, so a lease command cannot carry message state.
+        let value = serde_json::Value::deserialize(deserializer)?;
+        let fields = value
+            .as_object()
+            .ok_or_else(|| serde::de::Error::custom("HUD command must be an object."))?;
+        let payload_fields: &[&str] = match fields.get("kind").and_then(serde_json::Value::as_str) {
+            Some("renew_lease") => &[],
+            Some("update_appearance") => &["phase", "locale", "level", "speakingSequence"],
+            Some("present_message") => &["locale", "message"],
+            Some("clear_message") => &["expectedToken"],
+            _ => return Err(serde::de::Error::custom("Invalid HUD command kind.")),
+        };
+        if fields.keys().any(|key| {
+            !["session", "group", "sequence", "kind"].contains(&key.as_str())
+                && !payload_fields.contains(&key.as_str())
+        }) {
+            return Err(serde::de::Error::custom("Unexpected HUD command field."));
+        }
+        #[derive(Deserialize)]
+        struct CommandFields {
+            session: Option<String>,
+            group: String,
+            sequence: u64,
+            #[serde(flatten)]
+            command: CompanionHudCommand,
+        }
+        let parsed: CommandFields =
+            serde_json::from_value(value).map_err(serde::de::Error::custom)?;
+        Ok(Self {
+            session: parsed.session,
+            group: parsed.group,
+            sequence: parsed.sequence,
+            command: parsed.command,
+        })
+    }
+}
+impl ToolInput for SendCompanionHudCommandInput {
+    const TOOL_NAME: &'static str = "send_companion_hud_command";
+    fn validate(&self) -> Result<(), String> {
+        let bounded = match &self.command {
+            CompanionHudCommand::RenewLease => true,
+            CompanionHudCommand::UpdateAppearance {
+                level,
+                speaking_sequence,
+                ..
+            } => {
+                level.is_finite()
+                    && (0.0..=1.0).contains(level)
+                    && speaking_sequence.is_none_or(|sequence| sequence <= 9_007_199_254_740_991)
+            }
+            CompanionHudCommand::PresentMessage { message, .. } => message.validate(),
+            CompanionHudCommand::ClearMessage { expected_token } => expected_token.validate(),
+        };
+        if !valid_group(&self.group) || self.sequence > 9_007_199_254_740_991 || !bounded {
+            return Err("Invalid bounded HUD command.".into());
+        }
+        Ok(())
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct BindCompanionHudCursorInput {
+    pub session: Option<String>,
+    pub group: String,
+    #[serde(default, rename = "lessonId")]
+    pub lesson_id: Option<String>,
+}
+impl ToolInput for BindCompanionHudCursorInput {
+    const TOOL_NAME: &'static str = "bind_companion_hud_cursor";
+    fn validate(&self) -> Result<(), String> {
+        if !valid_group(&self.group)
+            || self
+                .lesson_id
+                .as_ref()
+                .is_some_and(|lesson| !valid_group(lesson))
+        {
+            return Err("Invalid HUD group.".into());
+        }
+        Ok(())
+    }
+}
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct ReadCompanionHudMessageInput {
+    pub session: Option<String>,
+    pub group: String,
+}
+impl ToolInput for ReadCompanionHudMessageInput {
+    const TOOL_NAME: &'static str = "read_companion_hud_message";
+    fn validate(&self) -> Result<(), String> {
+        if !valid_group(&self.group) {
+            return Err("Invalid HUD group.".into());
+        }
+        Ok(())
+    }
+}
+fn valid_group(group: &str) -> bool {
+    group.len() == 36
+        && group.chars().enumerate().all(|(index, ch)| {
+            if [8, 13, 18, 23].contains(&index) {
+                ch == '-'
+            } else {
+                ch.is_ascii_hexdigit()
+            }
+        })
+}
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct CompanionHudOutput {
+    pub applied: bool,
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        rename = "renderToken"
+    )]
+    pub render_token: Option<CompanionRenderToken>,
+}
+impl ToolOutput for CompanionHudOutput {}
+#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct CompanionHudMessageOutput {
+    pub message: Option<CompanionTeachingMessage>,
+    #[serde(
+        default,
+        skip_serializing_if = "Option::is_none",
+        rename = "renderToken"
+    )]
+    pub render_token: Option<CompanionRenderToken>,
+}
+impl ToolOutput for CompanionHudMessageOutput {}
+pub fn contracts() -> Vec<ToolContract> {
+    vec![
+        contract::<SetCompanionHudInput>(),
+        contract::<SendCompanionHudCommandInput>(),
+        contract::<BindCompanionHudCursorInput>(),
+        ToolContract {
+            success_output_schema: Some(CompanionHudMessageOutput::output_schema()),
+            output_validator: crate::validate_typed_output::<CompanionHudMessageOutput>,
+            ..contract::<ReadCompanionHudMessageInput>()
+        },
+    ]
+}
+fn contract<I: ToolInput>() -> ToolContract {
+    ToolContract {
+        name: I::TOOL_NAME.into(),
+        description: "Private host presentation. Not a model tool or desktop action.".into(),
+        platforms: vec![Platform::Macos],
+        aliases: vec![],
+        capabilities: vec!["agent_cursor.presentation".into()],
+        annotations: ToolAnnotations {
+            read_only: false,
+            destructive: false,
+            idempotent: true,
+            open_world: false,
+        },
+        schema_mode: SchemaMode::CanonicalRuntime,
+        cursor_semantics: None,
+        input_schema: I::input_schema(),
+        success_output_schema: Some(CompanionHudOutput::output_schema()),
+        error_output_schema: None,
+        output_validator: crate::validate_typed_output::<CompanionHudOutput>,
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn companion_commands_parse_strictly_and_renewals_have_no_message() {
+        let base = serde_json::json!({ "group":"11111111-1111-4111-8111-111111111111", "sequence":1, "kind":"renew_lease" });
+        let parsed: SendCompanionHudCommandInput = serde_json::from_value(base.clone()).unwrap();
+        assert!(parsed.validate().is_ok());
+        let mut unexpected = base.clone();
+        unexpected["message"] = serde_json::Value::Null;
+        assert!(serde_json::from_value::<SendCompanionHudCommandInput>(unexpected).is_err());
+        let mut oversized = base;
+        oversized["sequence"] = serde_json::json!(9_007_199_254_740_992_u64);
+        assert!(
+            serde_json::from_value::<SendCompanionHudCommandInput>(oversized)
+                .unwrap()
+                .validate()
+                .is_err()
+        );
+        let clear = serde_json::json!({ "group":"11111111-1111-4111-8111-111111111111", "sequence":2, "kind":"clear_message",
+            "expectedToken": { "ownerEpoch":"11111111-1111-4111-8111-111111111111", "revision":1, "renderId":"22222222-2222-4222-8222-222222222222" } });
+        assert!(
+            serde_json::from_value::<SendCompanionHudCommandInput>(clear)
+                .unwrap()
+                .validate()
+                .is_ok()
+        );
+    }
+    #[test]
+    fn companion_hud_rejects_unbounded_input() {
+        let mut input = SetCompanionHudInput {
+            session: None,
+            group: "11111111-1111-4111-8111-111111111111".into(),
+            sequence: 0,
+            phase: CompanionHudPhase::Listening,
+            locale: CompanionHudLocale::English,
+            level: 0.5,
+            message: None,
+            speaking_sequence: None,
+        };
+        assert!(input.validate().is_ok());
+        input.level = f64::NAN;
+        assert!(input.validate().is_err());
+        input.level = 0.5;
+        input.group = "bad".into();
+        assert!(input.validate().is_err());
+    }
+}
