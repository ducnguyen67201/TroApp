generator client {
  provider = "prisma-client"
  output = "../src/server/generated/prisma"
  moduleFormat = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model OutfitDraft {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, createdAt])
}

enum AccountRole {
  student
  teacher
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  role          AccountRole @default(student)
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  modelUsage    ModelUsage[]
  transcriptionUsage TranscriptionUsage[]
  transcriptionCaptures TranscriptionCapture[]
  voiceoverUsage VoiceoverUsage[]
  voiceoverUtterances VoiceoverUtterance[]
  classroomCourses ClassroomCourseRevision[]
  teachingClasses ClassroomGroup[]
  classEnrollments ClassroomEnrollment[]
  classParticipations ClassroomParticipation[]
  workSnapshots ClassroomWorkSnapshot[]
  practiceChecks ClassroomPracticeCheck[]
  workSubmissions ClassroomWorkSubmission[]

  @@map("user")
}

model ClassroomCourseRevision {
  id String @id @db.Uuid
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  title String
  content Json
  createdAt DateTime @default(now())
  classes ClassroomGroup[]
  materialPublication ClassroomMaterialPublication?
  workSnapshots ClassroomWorkSnapshot[]
  @@index([ownerId, createdAt])
}

model ClassroomGroup {
  guidedLessons GuidedLessonRecord[]
  materialDerivations ClassroomMaterialDerivation[]
  id String @id @db.Uuid
  teacherId String
  teacher User @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  name String
  courseRevisionId String @db.Uuid
  courseRevision ClassroomCourseRevision @relation(fields: [courseRevisionId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  deletedAt DateTime?
  insightState ClassroomInsightState?
  learningEvents ClassroomLearningEvent[]
  insightRecords ClassroomInsightRecord[]
  insightReceipts ClassroomInsightReceipt[]
  expiredSources ClassroomExpiredSource[]
  enrollments ClassroomEnrollment[]
  meetings ClassroomMeeting[]
  invitations ClassroomInvitation[]
  @@index([teacherId])
  materialCollection ClassroomMaterialCollection?
  materialFiles ClassroomMaterialFile[]
}

// Guided lesson drafts use validated aggregate documents. Immutable revisions,
// releases, command receipts, allowances and private learner records stay separate.
model GuidedLessonRecord {
  id String @id @db.Uuid
  classId String @db.Uuid
  schoolClass ClassroomGroup @relation(fields: [classId], references: [id], onDelete: Restrict)
  version Int
  status String
  leaseUntil DateTime?
  document Json
  updatedAt DateTime @updatedAt
  revisions GuidedLessonRevisionRecord[]
  releases GuidedLessonReleaseRecord[]
  artifacts GuidedLessonArtifactRecord[]
  @@index([classId, updatedAt])
  @@index([status, leaseUntil])
}

model GuidedLessonRevisionRecord {
  id String @id @db.Uuid
  lessonId String @db.Uuid
  lesson GuidedLessonRecord @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  document Json
  createdAt DateTime @default(now())
  @@index([lessonId, createdAt])
}

model GuidedLessonReleaseRecord {
  id String @id @db.Uuid
  lessonId String @db.Uuid
  classId String @db.Uuid
  lesson GuidedLessonRecord @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  available Boolean
  document Json
  createdAt DateTime @default(now())
  @@index([classId, available])
}

model GuidedLessonBudgetRecord {
  id String @id
  version Int
  document Json
}

model GuidedLessonCommandRecord {
  userId String
  commandId String @db.Uuid
  classId String @db.Uuid
  document Json
  createdAt DateTime @default(now())
  @@id([userId, commandId])
}

model GuidedLessonProgressRecord {
  studentId String
  releaseId String @db.Uuid
  version Int
  document Json
  @@id([studentId, releaseId])
}

model GuidedLessonNoteRecord {
  id String @id @db.Uuid
  studentId String
  classId String @db.Uuid
  releaseId String @db.Uuid
  version Int
  document Json
  updatedAt DateTime @updatedAt
  @@index([studentId, releaseId])
}

model GuidedLessonRequestRecord {
  id String @id @db.Uuid
  classId String @db.Uuid
  studentId String
  document Json
  createdAt DateTime @default(now())
  @@index([classId, createdAt])
}

model GuidedLessonArtifactRecord {
  id String @id @db.Uuid
  classId String @db.Uuid
  lessonId String @db.Uuid
  lesson GuidedLessonRecord @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  revisionId String @db.Uuid
  kind String
  mimeType String
  digest String
  sceneId String?
  phase String?
  bytes Bytes
  size Int
  createdAt DateTime @default(now())
  @@index([classId])
  @@index([lessonId, revisionId])
}

model ClassroomEnrollment {
  classId String @db.Uuid
  studentId String
  schoolClass ClassroomGroup @relation(fields: [classId], references: [id], onDelete: Restrict)
  student User @relation(fields: [studentId], references: [id], onDelete: Restrict)
  active Boolean @default(true)
  @@id([classId, studentId])
  @@index([studentId, active])
}

model ClassroomMeeting {
  id String @id @db.Uuid
  classId String @db.Uuid
  schoolClass ClassroomGroup @relation(fields: [classId], references: [id], onDelete: Restrict)
  status String
  phase String
  pacing String
  currentActivityId String @db.Uuid
  contextVersion Int @default(1)
  createdAt DateTime @default(now())
  participations ClassroomParticipation[]
  @@index([classId, createdAt])
}

model ClassroomParticipation {
  id String @id @db.Uuid
  classSessionId String @db.Uuid
  meeting ClassroomMeeting @relation(fields: [classSessionId], references: [id], onDelete: Restrict)
  studentId String
  student User @relation(fields: [studentId], references: [id], onDelete: Restrict)
  deviceId String @db.Uuid
  leaseUntil DateTime
  left Boolean @default(false)
  attempts ClassroomAttempt[]
  @@unique([classSessionId, studentId])
}

model ClassroomAttempt {
  lastSavedAt DateTime?
  id String @id @db.Uuid
  participationId String @db.Uuid
  participation ClassroomParticipation @relation(fields: [participationId], references: [id], onDelete: Restrict)
  activityId String @db.Uuid
  progressVersion Int @default(0)
  workspaceUrl String?
  evidence Json
  declaredComplete Boolean @default(false)
  helpSummary String @default("")
  events ClassroomProgressEvent[]
  preparations ClassroomSubmissionPreparation[]
  submissions ClassroomSubmission[]
  workSnapshots ClassroomWorkSnapshot[]
  practiceChecks ClassroomPracticeCheck[]
  workSubmissions ClassroomWorkSubmission[]
  @@unique([participationId, activityId])
}

model ClassroomProgressEvent {
  attemptId String @db.Uuid
  eventId String @db.Uuid
  attempt ClassroomAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  @@id([attemptId, eventId])
}

model ClassroomSubmissionPreparation {
  id String @id @db.Uuid
  attemptId String @db.Uuid
  attempt ClassroomAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  url String
  progressVersion Int
  contextVersion Int
  expiresAt DateTime
}

model ClassroomSubmission {
  id String @id @db.Uuid
  attemptId String @db.Uuid
  attempt ClassroomAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  idempotencyKey String @db.Uuid
  url String
  submittedAt DateTime
  @@unique([attemptId, idempotencyKey])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ModelUsage {
  userId       String
  day          DateTime @db.Date
  requestCount Int      @default(0)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

model TranscriptionUsage {
  userId  String
  day     DateTime @db.Date
  samples Int      @default(0)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

model TranscriptionCapture {
  id              String   @id @db.Uuid
  userId          String
  activeUserId    String?  @unique
  day             DateTime @db.Date
  reservedSamples Int
  claimed         Boolean  @default(false)
  settled         Boolean  @default(false)
  expiresAt       DateTime
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model VoiceoverUsage {
  userId String
  day DateTime @db.Date
  characters Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, day])
}

model VoiceoverDailyBudget {
  day DateTime @id @db.Date
  characters Int @default(0)
}

model VoiceoverUtterance {
  id String @id @db.Uuid
  userId String
  activeUserId String? @unique
  characters Int
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model ClassroomInvitation {
  id String @id @db.Uuid
  classId String @db.Uuid
  schoolClass ClassroomGroup @relation(fields: [classId], references: [id], onDelete: Restrict)
  codeDigest String @unique
  email String?
  expiresAt DateTime
  revoked Boolean @default(false)
  @@index([classId, revoked])
}

model ClassroomMaterialCollection {
  classId String @id @db.Uuid
  schoolClass ClassroomGroup @relation(fields: [classId], references: [id], onDelete: Restrict)
  version Int
  state String
  leaseUntil DateTime?
  document Json
}

model ClassroomMaterialFile {
  id String @id @db.Uuid
  classId String @db.Uuid
  schoolClass ClassroomGroup @relation(fields: [classId], references: [id], onDelete: Restrict)
  name String
  bytes Bytes
  size Int
  @@index([classId])
}

model ClassroomMaterialPublication {
  courseId String @id @db.Uuid
  course ClassroomCourseRevision @relation(fields: [courseId], references: [id], onDelete: Restrict)
  document Json
}

model ClassroomMaterialBudget {
 id String @id
 requests Int
}

model ClassroomMaterialDerivation {
  classId String @db.Uuid
  key String
  schoolClass ClassroomGroup @relation(fields: [classId], references: [id], onDelete: Restrict)
  jobId String @db.Uuid
  claimId String @db.Uuid
  document Json
  @@id([classId, key])
  @@index([jobId])
}

model ClassroomWorkSnapshot {
 expiredAt DateTime?
 id String @id @db.Uuid
 studentId String
 student User @relation(fields:[studentId],references:[id],onDelete:Restrict)
 attemptId String @db.Uuid
 attempt ClassroomAttempt @relation(fields:[attemptId],references:[id],onDelete:Restrict)
 courseRevisionId String @db.Uuid
 courseRevision ClassroomCourseRevision @relation(fields:[courseRevisionId],references:[id],onDelete:Restrict)
 checkpointId String @db.Uuid
 rubricRevisionId String @db.Uuid
 manifestDigest String @db.VarChar(64)
 createdAt DateTime
 evidence ClassroomPracticeEvidence[]
 checks ClassroomPracticeCheck[]
 submissions ClassroomWorkSubmission[]
 @@index([studentId,createdAt])
 @@index([attemptId,checkpointId,createdAt])
}
model ClassroomPracticeEvidence {
 id String @id @db.Uuid
 snapshotId String @db.Uuid
 snapshot ClassroomWorkSnapshot @relation(fields:[snapshotId],references:[id],onDelete:Restrict)
 kind String
 name String
 mediaType String
 capture Json?
 byteCount Int
 digest String @db.VarChar(64)
 content Bytes
 @@index([snapshotId])
}
model ClassroomPracticeCheck {
 id String @id @db.Uuid
 studentId String
 student User @relation(fields:[studentId],references:[id],onDelete:Restrict)
 attemptId String @db.Uuid
 attempt ClassroomAttempt @relation(fields:[attemptId],references:[id],onDelete:Restrict)
 checkpointId String @db.Uuid
 snapshotId String @db.Uuid
 snapshot ClassroomWorkSnapshot @relation(fields:[snapshotId],references:[id],onDelete:Restrict)
 requestId String @db.Uuid
 payloadDigest String @db.VarChar(64)
 rubric Json
 status String
 finding String?
 evaluator String
 assessment Json?
 createdAt DateTime
 completedAt DateTime?
 results ClassroomPracticeResult[]
 submissions ClassroomWorkSubmission[]
 @@unique([studentId,requestId])
 @@index([studentId,createdAt])
 @@index([attemptId,createdAt])
}
model ClassroomPracticeResult {
 checkId String @db.Uuid
 check ClassroomPracticeCheck @relation(fields:[checkId],references:[id],onDelete:Restrict)
 criterionId String @db.Uuid
 finding String
 feedback String
 evidenceIds Json
 @@id([checkId,criterionId])
}
model ClassroomWorkSubmission {
 id String @id @db.Uuid
 studentId String
 student User @relation(fields:[studentId],references:[id],onDelete:Restrict)
 attemptId String @db.Uuid
 attempt ClassroomAttempt @relation(fields:[attemptId],references:[id],onDelete:Restrict)
 checkpointId String @db.Uuid
 snapshotId String @db.Uuid
 snapshot ClassroomWorkSnapshot @relation(fields:[snapshotId],references:[id],onDelete:Restrict)
 checkId String @db.Uuid
 check ClassroomPracticeCheck @relation(fields:[checkId],references:[id],onDelete:Restrict)
 sequence Int
 requestId String @db.Uuid
 payloadDigest String @db.VarChar(64)
 submittedAt DateTime
 @@unique([studentId,requestId])
 @@unique([attemptId,checkpointId,sequence])
 @@index([attemptId,submittedAt])
}

/** Atomic per-class source cutoff; all insight writers allocate a revision in their source transaction. */
model ClassroomInsightState {
  collectionPolicy String?
  retentionDays Int?
  classId String @id @db.Uuid
  schoolClass ClassroomGroup @relation(fields: [classId], references: [id], onDelete: Restrict)
  revision BigInt @default(0)
  invalidationRevision BigInt @default(0)
  updatedAt DateTime @updatedAt
}

/** Immutable metadata ledger. Content lives in typed source records or existing private snapshots. */
model ClassroomLearningEvent {
  logicalId String
  id String @id @db.Uuid
  classId String @db.Uuid
  schoolClass ClassroomGroup @relation(fields: [classId], references: [id], onDelete: Restrict)
  revision BigInt
  identity String
  kind String
  studentId String?
  sessionId String? @db.Uuid
  attemptId String? @db.Uuid
  activityId String? @db.Uuid
  sourceId String
  actorId String
  observedAt DateTime?
  recordedAt DateTime
  payloadDigest String @db.VarChar(64)
  record Json
  @@unique([classId, identity])
  @@unique([classId, revision])
  @@index([classId, studentId, revision])
  @@index([classId, recordedAt, id])
}

/** Versioned strict-contract records: plans, eligibility, skills, observations, support, next tasks,
 * report revisions/dependencies/exports, corrections, removals and import coverage. JSON is validated
 * with the canonical discriminated schema before writing and after reading, never used as arbitrary data.
 */
model ClassroomInsightRecord {
  episodeOrder Int?
  id String @id @db.Uuid
  classId String @db.Uuid
  schoolClass ClassroomGroup @relation(fields: [classId], references: [id], onDelete: Restrict)
  kind String
  logicalId String
  version Int
  revision BigInt
  studentId String?
  sessionId String? @db.Uuid
  sourceId String?
  supersedesId String? @db.Uuid
  removedAt DateTime?
  recordedAt DateTime
  record Json
  @@unique([classId, logicalId, version])
  @@index([classId, studentId, episodeOrder])
  @@index([classId, kind, revision])
  @@index([classId, studentId, revision])
  @@index([classId, sourceId])
}

model ClassroomInsightReceipt {
  schoolClass ClassroomGroup @relation(fields: [classId], references: [id], onDelete: Restrict)
  userId String
  requestId String @db.Uuid
  classId String @db.Uuid
  digest String @db.VarChar(64)
  reply Json
  @@id([userId, requestId])
  @@index([classId])
}

model ClassroomExpiredSource {
  schoolClass ClassroomGroup @relation(fields: [classId], references: [id], onDelete: Restrict)
  classId String @db.Uuid
  sourceId String
  expiredAt DateTime
  @@id([classId, sourceId])
}
